<!doctype html>
<html lang="en">
<head>
  <title>Set up two-factor auth — {{ appName }}</title>
  {{ template "_slash_head.tmpl" . }}
</head>
<body x-data="{
  darkMode: document.documentElement.classList.contains('dark'),
  toggle() {
    this.darkMode = !this.darkMode;
    this.darkMode
      ? document.documentElement.classList.add('dark')
      : document.documentElement.classList.remove('dark');
    localStorage.setItem('theme', this.darkMode ? 'dark' : 'light');
  }
}" class="min-h-screen bg-white dark:bg-[#37353E] text-zinc-900 dark:text-white antialiased">

  {{ template "_header.tmpl" . }}

  <div class="mx-auto max-w-sm px-4 py-14 sm:px-6">

    <div class="mb-6 flex items-center gap-3">
      <a href="/settings" class="text-xs text-zinc-400 dark:text-zinc-500 hover:text-zinc-600 dark:hover:text-zinc-300 transition-colors">← Settings</a>
    </div>

    <h1 class="mb-1 text-xl font-black tracking-tight">Set up authenticator</h1>
    <p class="mb-8 text-sm text-zinc-500 dark:text-zinc-400">Scan the QR code with your authenticator app, then enter the 6-digit code to confirm.</p>

    {{ if .Error }}
    <div class="mb-5 rounded-xl border border-red-200 dark:border-red-800 bg-red-50 dark:bg-red-900/20 px-4 py-3 text-sm text-red-700 dark:text-red-400">
      {{ .Error }}
    </div>
    {{ end }}

    <div class="overflow-hidden rounded-xl border border-zinc-100 dark:border-[#4A4854] bg-white dark:bg-[#3F3D48]">
      <!-- QR code -->
      <div class="flex justify-center border-b border-zinc-100 dark:border-[#4A4854] bg-white px-6 py-6">
        <img src="data:image/png;base64,{{ .QR }}" alt="QR code" class="h-44 w-44 rounded-lg">
      </div>

      <!-- Manual key -->
      <div class="border-b border-zinc-100 dark:border-[#4A4854] px-5 py-4">
        <p class="mb-1.5 text-xs font-semibold uppercase tracking-widest text-zinc-400 dark:text-zinc-500">Manual entry key</p>
        <code class="block break-all rounded-lg bg-zinc-100 dark:bg-[#32303A] px-3 py-2 text-xs text-zinc-700 dark:text-zinc-300 select-all">{{ .Secret }}</code>
      </div>

      <!-- Confirmation form -->
      <form method="POST" action="/settings/2fa/setup" class="px-5 py-5 space-y-4">
        <div>
          <label for="code" class="block text-sm font-medium text-zinc-700 dark:text-white">Confirmation code</label>
          <input type="text" id="code" name="code" inputmode="numeric" autocomplete="one-time-code"
                 placeholder="000000" maxlength="6"
                 class="mt-1.5 block w-full rounded-lg border border-zinc-300 dark:border-[#4A4854] bg-white dark:bg-[#32303A] px-3 py-2 text-center text-lg font-mono tracking-widest text-zinc-900 dark:text-white placeholder-zinc-300 dark:placeholder-zinc-600 outline-none focus:border-orange-400 dark:focus:border-orange-500">
        </div>
        <button type="submit"
                class="w-full rounded-xl bg-orange-500 py-2.5 text-sm font-semibold text-white hover:bg-orange-400 transition-colors">
          Enable two-factor auth
        </button>
      </form>
    </div>

  </div>

  {{ template "_footer.tmpl" . }}
</body>
</html>
