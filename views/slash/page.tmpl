<!doctype html>
<html lang="en">
<head>
  {{ with .Page }}
  <title>{{ .Title }} — {{ appName }}</title>
  <meta name="description" content="{{ .Subtitle }}">
  {{ else }}
  <title>Not found — {{ appName }}</title>
  {{ end }}
  {{ template "_slash_head.tmpl" . }}
</head>
<body x-data="{
  darkMode: document.documentElement.classList.contains('dark'),
  toggle() {
    this.darkMode = !this.darkMode;
    this.darkMode
      ? document.documentElement.classList.add('dark')
      : document.documentElement.classList.remove('dark');
    localStorage.setItem('theme', this.darkMode ? 'dark' : 'light');
  }
}" class="min-h-screen bg-white dark:bg-[#37353E] text-zinc-900 dark:text-white antialiased">

  {{ template "_header.tmpl" . }}
  {{ template "_sidebar.tmpl" . }}

  {{ if .Error }}
  <div class="mx-auto max-w-2xl px-4 py-24 text-center sm:px-6">
    <p class="text-sm text-zinc-500 dark:text-zinc-400">{{ .Error }}</p>
    <a href="/" class="mt-4 inline-block text-sm font-medium text-orange-500 hover:text-orange-400">← Back home</a>
  </div>
  {{ else }}
  {{ with .Page }}

  <!-- Page header -->
  <div class="border-b border-zinc-100 dark:border-[#4A4854] bg-zinc-50 dark:bg-[#32303A] px-4 py-10 sm:px-6">
    <div class="mx-auto max-w-3xl">
      <a href="/" class="mb-5 inline-flex items-center gap-1.5 text-xs text-zinc-400 dark:text-zinc-500 hover:text-zinc-600 dark:hover:text-zinc-300 transition-colors">
        <svg class="h-3 w-3" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
        </svg>
        Home
      </a>
      <h1 class="text-3xl font-black tracking-tight text-zinc-900 dark:text-white sm:text-4xl">{{ .Title }}</h1>
      {{ if .Subtitle }}
      <p class="mt-3 text-base text-zinc-500 dark:text-zinc-400">{{ .Subtitle }}</p>
      {{ end }}
    </div>
  </div>

  <!-- Page body -->
  {{ if .Description }}
  <div class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
    <div class="prose prose-zinc dark:prose-invert max-w-none text-zinc-700 dark:text-white leading-relaxed whitespace-pre-wrap">{{ .Description }}</div>
  </div>
  {{ end }}

  {{ end }}
  {{ end }}

  {{ template "_footer.tmpl" . }}
</body>
</html>
