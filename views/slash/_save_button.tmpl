<button type="button"
        x-data="saveButton({{ .AI.ID }}, {{ if .Saved }}true{{ else }}false{{ end }}, {{ if .LoggedIn }}true{{ else }}false{{ end }})"
        @click="toggle()"
        :aria-pressed="saved"
        :class="saved ? 'text-orange-500 dark:text-amber-400' : 'text-zinc-300 dark:text-white'"
        class="relative z-10 shrink-0 rounded p-1 hover:bg-white dark:hover:bg-white/5 transition-colors"
        title="Save">
  <svg class="h-4 w-4" :class="saved ? 'fill-current' : 'fill-none'" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
    <path stroke-linecap="round" stroke-linejoin="round" d="M17.593 3.322c1.1.128 1.907 1.077 1.907 2.185V21L12 17.25 4.5 21V5.507c0-1.108.806-2.057 1.907-2.185a48.507 48.507 0 0 1 11.186 0Z"/>
  </svg>
</button>
