<!doctype html>
<html lang="en">
<head>
  <title>Settings — {{ appName }}</title>
  {{ template "_slash_head.tmpl" . }}
</head>
<body x-data="{
  darkMode: document.documentElement.classList.contains('dark'),
  toggle() {
    this.darkMode = !this.darkMode;
    this.darkMode
      ? document.documentElement.classList.add('dark')
      : document.documentElement.classList.remove('dark');
    localStorage.setItem('theme', this.darkMode ? 'dark' : 'light');
  }
}" class="min-h-screen bg-white dark:bg-[#2d2e39] text-zinc-900 dark:text-white antialiased">

  {{ template "_header.tmpl" . }}
  {{ template "_sidebar.tmpl" . }}

  <div class="md:pl-[3.75rem]">

  <div class="mx-auto max-w-2xl px-4 py-10 sm:px-6">

    <h1 class="mb-8 text-2xl font-black tracking-tight">Settings</h1>

    <!-- Flash messages -->
    {{ if eq .Flash "enabled" }}
    <div class="mb-6 rounded-md border border-green-200 dark:border-green-800 bg-white dark:bg-[#2d2e39] px-4 py-3 text-sm text-green-700 dark:text-white">
      Two-factor authentication has been enabled.
    </div>
    {{ end }}
    {{ if eq .Flash "disabled" }}
    <div class="mb-6 rounded-md border border-zinc-200 dark:border-[#43444c] bg-white dark:bg-[#2d2e39] px-4 py-3 text-sm text-zinc-600 dark:text-white">
      Two-factor authentication has been disabled.
    </div>
    {{ end }}
    {{ if eq .FlashError "invalid_code" }}
    <div class="mb-6 rounded-md border border-red-200 dark:border-red-800 bg-white dark:bg-[#2d2e39] px-4 py-3 text-sm text-red-700 dark:text-white">
      Invalid code — 2FA was not disabled.
    </div>
    {{ end }}
    {{ if eq .Connected "github" }}
    <div class="mb-6 rounded-md border border-green-200 dark:border-green-800 bg-white dark:bg-[#2d2e39] px-4 py-3 text-sm text-green-700 dark:text-white">
      GitHub account connected.
    </div>
    {{ end }}
    {{ if eq .Connected "google" }}
    <div class="mb-6 rounded-md border border-green-200 dark:border-green-800 bg-white dark:bg-[#2d2e39] px-4 py-3 text-sm text-green-700 dark:text-white">
      Google account connected.
    </div>
    {{ end }}
    {{ if eq .FlashError "github_taken" }}
    <div class="mb-6 rounded-md border border-red-200 dark:border-red-800 bg-white dark:bg-[#2d2e39] px-4 py-3 text-sm text-red-700 dark:text-white">
      That GitHub account is already connected to another user.
    </div>
    {{ end }}
    {{ if eq .FlashError "google_taken" }}
    <div class="mb-6 rounded-md border border-red-200 dark:border-red-800 bg-white dark:bg-[#2d2e39] px-4 py-3 text-sm text-red-700 dark:text-white">
      That Google account is already connected to another user.
    </div>
    {{ end }}

    {{ with .User }}

    <!-- Profile -->
    <section class="mb-6 overflow-hidden rounded-md border border-zinc-100 dark:border-[#43444c] bg-white dark:bg-[#2d2e39]">
      <div class="border-b border-zinc-100 dark:border-[#43444c] px-5 py-3">
        <h2 class="text-sm font-semibold text-zinc-900 dark:text-white">Profile</h2>
      </div>
      <div class="px-5 py-5">
        <div class="flex items-center gap-4">
          {{ if .AvatarURL }}
          <img src="{{ .AvatarURL }}" alt="{{ .Name }}"
               class="h-14 w-14 shrink-0 rounded-full border border-zinc-200 dark:border-[#43444c] bg-white dark:bg-[#2d2e39] object-cover">
          {{ else }}
          <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full border border-zinc-200 dark:border-[#43444c] bg-white dark:bg-[#2d2e39] text-xl font-black text-zinc-500 dark:text-white">
            {{ if .Name }}{{ slice .Name 0 1 }}{{ else }}?{{ end }}
          </div>
          {{ end }}
          <div>
            <p class="font-semibold text-zinc-900 dark:text-white">{{ if .Name }}{{ .Name }}{{ else }}<span class="text-zinc-400">—</span>{{ end }}</p>
            <p class="text-sm text-zinc-500 dark:text-white">{{ .Email }}</p>
            <p class="text-xs text-zinc-400 dark:text-white">@{{ .Username }}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Security -->
    <section class="mb-6 overflow-hidden rounded-md border border-zinc-100 dark:border-[#43444c] bg-white dark:bg-[#2d2e39]">
      <div class="border-b border-zinc-100 dark:border-[#43444c] px-5 py-3">
        <h2 class="text-sm font-semibold text-zinc-900 dark:text-white">Security</h2>
      </div>

      <!-- 2FA row -->
      <div class="px-5 py-5">
        <div class="flex items-start justify-between gap-4">
          <div>
            <div class="flex items-center gap-2">
              <p class="text-sm font-medium text-zinc-900 dark:text-white">Two-factor authentication</p>
              {{ if .TOTPEnabled }}
              <span class="rounded-full border border-green-200 dark:border-green-800/50 bg-white dark:bg-[#2d2e39] px-2 py-0.5 text-[11px] font-semibold text-green-700 dark:text-white">Enabled</span>
              {{ else }}
              <span class="rounded-full border border-zinc-200 dark:border-[#43444c] bg-white dark:bg-[#2d2e39] px-2 py-0.5 text-[11px] font-semibold text-zinc-500 dark:text-white">Not set up</span>
              {{ end }}
            </div>
            <p class="mt-0.5 text-xs text-zinc-400 dark:text-white">
              {{ if .TOTPEnabled }}
              Authenticator app is active.
              {{ if $.RecoveryCount }}<span class="text-zinc-400 dark:text-white">{{ $.RecoveryCount }} recovery codes remaining.</span>{{ end }}
              {{ else }}
              Add an extra layer of security to your account.
              {{ end }}
            </p>
          </div>

          {{ if .TOTPEnabled }}
          <!-- Disable form -->
          <div x-data="{ open: false }" class="shrink-0 text-right">
            <button @click="open = !open"
                    class="rounded border border-zinc-200 dark:border-[#43444c] px-3 py-1.5 text-xs font-medium text-zinc-600 dark:text-white hover:bg-white dark:hover:bg-white/5 transition-colors">
              Disable
            </button>
            <div x-show="open" x-cloak x-transition
                 class="mt-3 rounded-md border border-red-200 dark:border-red-800/50 bg-white dark:bg-[#2d2e39] p-4 text-left">
              <p class="mb-3 text-xs text-red-700 dark:text-white">Enter your current authenticator code or a recovery code to confirm.</p>
              <form method="POST" action="/settings/2fa/disable" class="flex items-center gap-2">
                <input type="text" name="code" inputmode="numeric" autocomplete="one-time-code"
                       placeholder="000000"
                       class="w-28 rounded border border-zinc-300 dark:border-[#43444c] bg-white dark:bg-[#2d2e39] px-3 py-1.5 text-sm text-zinc-900 dark:text-white placeholder-zinc-400 dark:placeholder-zinc-500 outline-none focus:border-red-400 dark:focus:border-red-500">
                <button type="submit"
                        class="rounded bg-red-500 px-3 py-1.5 text-xs font-semibold text-white hover:bg-red-600 transition-colors">
                  Confirm disable
                </button>
              </form>
            </div>
          </div>
          {{ else }}
          <a href="/settings/2fa/setup"
             class="shrink-0 rounded bg-orange-500 dark:bg-amber-500 px-3 py-1.5 text-xs font-semibold text-white hover:bg-orange-400 dark:hover:bg-amber-400 transition-colors">
            Set up
          </a>
          {{ end }}
        </div>
      </div>
    </section>

    <!-- Connected accounts -->
    <section class="overflow-hidden rounded-md border border-zinc-100 dark:border-[#43444c] bg-white dark:bg-[#2d2e39]">
      <div class="border-b border-zinc-100 dark:border-[#43444c] px-5 py-3">
        <h2 class="text-sm font-semibold text-zinc-900 dark:text-white">Connected accounts</h2>
      </div>
      <ul class="divide-y divide-zinc-100 dark:divide-[#43444c]">

        {{ if $.GitHubEnabled }}
        <li class="flex items-center justify-between gap-4 px-5 py-3.5">
          <div class="flex items-center gap-3">
            <svg class="h-4 w-4 shrink-0 text-zinc-500 dark:text-white" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577v-2.165c-3.338.726-4.042-1.61-4.042-1.61-.546-1.387-1.333-1.756-1.333-1.756-1.09-.745.083-.729.083-.729 1.205.084 1.84 1.237 1.84 1.237 1.07 1.835 2.807 1.305 3.492.998.108-.775.418-1.305.762-1.605-2.665-.3-5.467-1.332-5.467-5.93 0-1.31.468-2.38 1.235-3.22-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.3 1.23a11.5 11.5 0 0 1 3.003-.404c1.02.005 2.047.138 3.003.404 2.29-1.552 3.297-1.23 3.297-1.23.653 1.652.242 2.873.118 3.176.77.84 1.233 1.91 1.233 3.22 0 4.61-2.807 5.625-5.48 5.92.43.372.823 1.102.823 2.222v3.293c0 .322.218.694.825.576C20.565 21.796 24 17.298 24 12 24 5.37 18.627 0 12 0z"/>
            </svg>
            <div>
              <p class="text-sm font-medium text-zinc-700 dark:text-white">GitHub</p>
              {{ if .GitHubLogin }}
              <p class="text-xs text-zinc-400 dark:text-white">@{{ .GitHubLogin }}</p>
              {{ end }}
            </div>
          </div>
          {{ if .GitHubLogin }}
          <span class="flex items-center gap-1.5 text-xs font-medium text-green-600 dark:text-white">
            <svg class="h-3.5 w-3.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"/></svg>
            Connected
          </span>
          {{ else }}
          <a href="/settings/connect/github"
             class="shrink-0 rounded border border-zinc-200 dark:border-[#43444c] px-3 py-1.5 text-xs font-medium text-zinc-600 dark:text-white hover:bg-white dark:hover:bg-white/5 transition-colors">
            Connect
          </a>
          {{ end }}
        </li>
        {{ end }}

        {{ if $.GoogleEnabled }}
        <li class="flex items-center justify-between gap-4 px-5 py-3.5">
          <div class="flex items-center gap-3">
            <svg class="h-4 w-4 shrink-0 text-zinc-500 dark:text-white" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
              <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
            </svg>
            <div>
              <p class="text-sm font-medium text-zinc-700 dark:text-white">Google</p>
              {{ if .GoogleID }}
              <p class="text-xs text-zinc-400 dark:text-white">{{ .Email }}</p>
              {{ end }}
            </div>
          </div>
          {{ if .GoogleID }}
          <span class="flex items-center gap-1.5 text-xs font-medium text-green-600 dark:text-white">
            <svg class="h-3.5 w-3.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"/></svg>
            Connected
          </span>
          {{ else }}
          <a href="/settings/connect/google"
             class="shrink-0 rounded border border-zinc-200 dark:border-[#43444c] px-3 py-1.5 text-xs font-medium text-zinc-600 dark:text-white hover:bg-white dark:hover:bg-white/5 transition-colors">
            Connect
          </a>
          {{ end }}
        </li>
        {{ end }}

      </ul>
    </section>

    {{ end }}
  </div>

  </div>

  {{ template "_footer.tmpl" . }}
</body>
</html>
