<!doctype html>
<html lang="en">
<head>
  {{ with .List }}
  <title>{{ .Name }} — {{ appName }}</title>
  <meta name="description" content="{{ .Subtitle }}">
  {{ else }}
  <title>Not found — {{ appName }}</title>
  {{ end }}
  {{ template "_slash_head.tmpl" . }}
</head>
<body x-data="{
  darkMode: document.documentElement.classList.contains('dark'),
  toggle() {
    this.darkMode = !this.darkMode;
    this.darkMode
      ? document.documentElement.classList.add('dark')
      : document.documentElement.classList.remove('dark');
    localStorage.setItem('theme', this.darkMode ? 'dark' : 'light');
  }
}" class="min-h-screen bg-white dark:bg-[#2b2c31] text-zinc-900 dark:text-white antialiased">

  {{ template "_header.tmpl" . }}
  {{ template "_sidebar.tmpl" . }}

  <div class="md:pl-[3.75rem]">

  {{ if .Error }}
  <div class="mx-auto max-w-2xl px-4 py-24 text-center sm:px-6">
    <p class="text-sm text-zinc-500 dark:text-white">{{ .Error }}</p>
    <a href="/lists" class="mt-4 inline-block text-sm font-medium text-orange-500 dark:text-white hover:text-orange-400 dark:hover:text-white">← All lists</a>
  </div>
  {{ else }}
  {{ with .List }}

  <!-- List header -->
  <div class="border-b border-zinc-100 dark:border-[#43444c] bg-zinc-50 dark:bg-[#2f3036] px-4 py-8 sm:px-6">
    <div class="mx-auto max-w-5xl">
      <a href="/lists" class="mb-4 inline-flex items-center gap-1.5 text-xs text-zinc-400 dark:text-white hover:text-zinc-600 dark:hover:text-white transition-colors">
        <svg class="h-3 w-3" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
        All lists
      </a>
      <div class="flex items-start gap-4">
        <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-lg bg-orange-100 dark:bg-amber-500/10 text-orange-500 dark:text-white">
          <svg class="h-7 w-7" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 6.75h12M8.25 12h12m-12 5.25h12M3.75 6.75h.007v.008H3.75V6.75Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0ZM3.75 12h.007v.008H3.75V12Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm-.375 5.25h.007v.008H3.75v-.008Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z"/>
          </svg>
        </div>
        <div class="min-w-0">
          <h1 class="text-2xl font-black tracking-tight text-zinc-900 dark:text-white sm:text-3xl">{{ .Name }}</h1>
          {{ if .Subtitle }}
          <p class="mt-1 text-sm text-zinc-500 dark:text-white">{{ .Subtitle }}</p>
          {{ end }}
          <p class="mt-2 text-xs text-zinc-400 dark:text-white">{{ len .Items }} AIs</p>
        </div>
      </div>
    </div>
  </div>

  <!-- AIs -->
  <div class="mx-auto max-w-5xl px-4 py-8 sm:px-6"
       x-data="{ view: localStorage.getItem('list-view') || 'list', setView(v) { this.view = v; localStorage.setItem('list-view', v); } }">

    {{ if .Items }}

    <!-- View toggle -->
    <div class="mb-4 flex items-center justify-end">
      <div class="flex items-center gap-0.5 rounded border border-zinc-200 dark:border-[#43444c] bg-zinc-50 dark:bg-[#2f3036] p-0.5">
        <!-- List view -->
        <button type="button" @click="setView('list')"
                :class="view === 'list' ? 'bg-white dark:bg-[#43444c] shadow-sm text-zinc-700 dark:text-white' : 'text-zinc-400 dark:text-white hover:text-zinc-600'"
                class="rounded-sm p-1.5 transition-all">
          <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 6.75h12M8.25 12h12m-12 5.25h12M3.75 6.75h.007v.008H3.75V6.75Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0ZM3.75 12h.007v.008H3.75V12Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm-.375 5.25h.007v.008H3.75v-.008Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z"/>
          </svg>
        </button>
        <!-- Grid view -->
        <button type="button" @click="setView('grid')"
                :class="view === 'grid' ? 'bg-white dark:bg-[#43444c] shadow-sm text-zinc-700 dark:text-white' : 'text-zinc-400 dark:text-white hover:text-zinc-600'"
                class="rounded-sm p-1.5 transition-all">
          <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 0 1 6 3.75h2.25A2.25 2.25 0 0 1 10.5 6v2.25a2.25 2.25 0 0 1-2.25 2.25H6a2.25 2.25 0 0 1-2.25-2.25V6ZM3.75 15.75A2.25 2.25 0 0 1 6 13.5h2.25a2.25 2.25 0 0 1 2.25 2.25V18a2.25 2.25 0 0 1-2.25 2.25H6A2.25 2.25 0 0 1 3.75 18v-2.25ZM13.5 6a2.25 2.25 0 0 1 2.25-2.25H18A2.25 2.25 0 0 1 20.25 6v2.25A2.25 2.25 0 0 1 18 10.5h-2.25a2.25 2.25 0 0 1-2.25-2.25V6ZM13.5 15.75a2.25 2.25 0 0 1 2.25-2.25H18a2.25 2.25 0 0 1 2.25 2.25V18A2.25 2.25 0 0 1 18 20.25h-2.25A2.25 2.25 0 0 1 13.5 18v-2.25Z"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- List view (default) -->
    <div x-show="view === 'list'" class="space-y-2">
      {{ range .Items }}
      {{ if .AI }}
      <div class="group relative flex items-center gap-4 rounded-md border border-zinc-200 dark:border-[#43444c] bg-white dark:bg-[#35363d] px-4 py-3 hover:border-zinc-300 dark:hover:border-[#4c4d56] hover:shadow-sm dark:hover:shadow-black/20 transition-all">
        <a href="/ai/{{ .AI.Slug }}" class="absolute inset-0" aria-label="{{ .AI.Name }}"></a>
        {{ if .AI.LogoURL }}
        <img src="{{ .AI.LogoURL }}" alt="{{ .AI.Name }}"
             class="h-10 w-10 shrink-0 rounded bg-zinc-100 dark:bg-[#43444c] object-cover">
        {{ else if .AI.Website }}
        <img src="{{ faviconURL .AI.Website }}" alt="{{ .AI.Name }}"
             class="h-10 w-10 shrink-0 rounded bg-zinc-100 dark:bg-[#43444c] object-cover p-2">
        {{ else }}
        <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded bg-zinc-100 dark:bg-[#43444c] text-sm font-semibold text-zinc-500 dark:text-white">
          {{ if .AI.Name }}{{ slice .AI.Name 0 1 }}{{ end }}
        </div>
        {{ end }}
        <div class="min-w-0 flex-1">
          <span class="text-sm font-semibold text-zinc-900 dark:text-white">{{ .AI.Name }}</span>
          {{ if .AI.Subtitle }}
          <span class="ml-2 text-xs text-zinc-500 dark:text-white">{{ .AI.Subtitle }}</span>
          {{ end }}
        </div>
        {{ if .AI.Categories }}
        <div class="hidden sm:flex flex-wrap gap-1">
          {{ range .AI.Categories }}
          <span class="rounded-full bg-zinc-100 dark:bg-[#43444c] px-2 py-0.5 text-[11px] font-medium text-zinc-500 dark:text-white">{{ .Name }}</span>
          {{ end }}
        </div>
        {{ end }}
        {{ template "_save_button.tmpl" (dict "AI" .AI "Saved" (index $.SavedIDs .AI.ID) "LoggedIn" $.CurrentUser) }}
        <svg class="h-3.5 w-3.5 shrink-0 text-zinc-300 dark:text-white group-hover:text-zinc-500 transition-colors" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
        </svg>
      </div>
      {{ end }}
      {{ end }}
    </div>

    <!-- Grid view -->
    <div x-show="view === 'grid'" class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {{ range .Items }}
      {{ if .AI }}
      <div class="group relative flex items-start gap-4 rounded-md border border-zinc-200 dark:border-[#43444c] bg-white dark:bg-[#35363d] p-4 hover:border-zinc-300 dark:hover:border-[#4c4d56] hover:shadow-sm dark:hover:shadow-black/20 transition-all">
        <a href="/ai/{{ .AI.Slug }}" class="absolute inset-0" aria-label="{{ .AI.Name }}"></a>
        {{ if .AI.LogoURL }}
        <img src="{{ .AI.LogoURL }}" alt="{{ .AI.Name }}"
             class="h-11 w-11 shrink-0 rounded bg-zinc-100 dark:bg-[#43444c] object-cover">
        {{ else if .AI.Website }}
        <img src="{{ faviconURL .AI.Website }}" alt="{{ .AI.Name }}"
             class="h-11 w-11 shrink-0 rounded bg-zinc-100 dark:bg-[#43444c] object-cover p-2">
        {{ else }}
        <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded bg-zinc-100 dark:bg-[#43444c] text-base font-semibold text-zinc-500 dark:text-white">
          {{ if .AI.Name }}{{ slice .AI.Name 0 1 }}{{ end }}
        </div>
        {{ end }}
        <div class="min-w-0 flex-1">
          <div class="flex items-center justify-between gap-2">
            <span class="truncate text-sm font-semibold text-zinc-900 dark:text-white">{{ .AI.Name }}</span>
            <div class="flex shrink-0 items-center gap-1">
              {{ template "_save_button.tmpl" (dict "AI" .AI "Saved" (index $.SavedIDs .AI.ID) "LoggedIn" $.CurrentUser) }}
              <svg class="h-3.5 w-3.5 shrink-0 text-zinc-300 dark:text-white group-hover:text-zinc-500 transition-colors" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
              </svg>
            </div>
          </div>
          {{ if .AI.Subtitle }}
          <p class="mt-0.5 truncate text-xs text-zinc-500 dark:text-white">{{ .AI.Subtitle }}</p>
          {{ end }}
          {{ if .AI.Categories }}
          <div class="mt-2 flex flex-wrap gap-1">
            {{ range .AI.Categories }}
            <span class="rounded-full bg-zinc-100 dark:bg-[#43444c] px-2 py-0.5 text-[11px] font-medium text-zinc-500 dark:text-white">{{ .Name }}</span>
            {{ end }}
          </div>
          {{ end }}
        </div>
      </div>
      {{ end }}
      {{ end }}
    </div>

    {{ else }}
    <div class="rounded-md border border-dashed border-zinc-200 dark:border-[#43444c] py-20 text-center text-sm text-zinc-400 dark:text-white">
      No AIs in this list yet.
    </div>
    {{ end }}
  </div>

  {{ end }}
  {{ end }}

  </div>

  {{ template "_footer.tmpl" . }}

</body>
</html>
