<aside x-data="{ open: false }"
       @mouseenter="open = true"
       @mouseleave="open = false"
       :class="$store.header.scrolled ? 'top-11 h-[calc(100vh-2.75rem)]' : 'top-14 h-[calc(100vh-3.5rem)]'"
       class="fixed left-0 z-40 hidden md:flex transition-[top,height] duration-300 ease-in-out">
  <div :class="open ? 'w-52 shadow-xl dark:shadow-black/40' : 'w-[3.75rem]'"
       class="flex h-full flex-col gap-0.5 overflow-hidden border-r border-zinc-100 dark:border-[#4A4854] bg-white dark:bg-[#32303A] px-1 py-2 transition-[width,box-shadow] duration-200 ease-in-out">

    <a href="/#ais"
       :class="open ? 'justify-start' : 'justify-center'"
       class="group flex items-center gap-3 rounded-xl px-1 py-1 text-zinc-500 dark:text-white hover:bg-zinc-100 dark:hover:bg-[#3F3D48] hover:text-zinc-900 transition-colors">
      <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-zinc-100 dark:bg-[#3F3D48] group-hover:bg-zinc-200 dark:group-hover:bg-[#4A4854] transition-colors">
        <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75a4.5 4.5 0 0 1-4.884 4.484c-1.076-.091-2.264.071-2.95.904l-7.152 8.684a2.548 2.548 0 1 1-3.586-3.586l8.684-7.152c.833-.686.995-1.874.904-2.95a4.5 4.5 0 0 1 6.336-4.486l-3.276 3.276a3.004 3.004 0 0 0 2.25 2.25l3.276-3.276c.256.565.398 1.192.398 1.852Z"/>
          <path stroke-linecap="round" stroke-linejoin="round" d="M4.867 19.125h.008v.008h-.008v-.008Z"/>
        </svg>
      </span>
      <span x-show="open" x-transition:enter="transition-opacity duration-150 delay-75"
            x-transition:enter-start="opacity-0" x-transition:enter-end="opacity-100"
            x-transition:leave="transition-opacity duration-75"
            x-transition:leave-start="opacity-100" x-transition:leave-end="opacity-0"
            class="whitespace-nowrap text-sm font-medium">AIs</span>
    </a>

    <a href="/categories"
       :class="open ? 'justify-start' : 'justify-center'"
       class="group flex items-center gap-3 rounded-xl px-1 py-1 text-zinc-500 dark:text-white hover:bg-zinc-100 dark:hover:bg-[#3F3D48] hover:text-zinc-900 transition-colors">
      <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-zinc-100 dark:bg-[#3F3D48] group-hover:bg-zinc-200 dark:group-hover:bg-[#4A4854] transition-colors">
        <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 0 1 6 3.75h2.25A2.25 2.25 0 0 1 10.5 6v2.25a2.25 2.25 0 0 1-2.25 2.25H6a2.25 2.25 0 0 1-2.25-2.25V6ZM3.75 15.75A2.25 2.25 0 0 1 6 13.5h2.25a2.25 2.25 0 0 1 2.25 2.25V18a2.25 2.25 0 0 1-2.25 2.25H6A2.25 2.25 0 0 1 3.75 18v-2.25ZM13.5 6a2.25 2.25 0 0 1 2.25-2.25H18A2.25 2.25 0 0 1 20.25 6v2.25A2.25 2.25 0 0 1 18 10.5h-2.25a2.25 2.25 0 0 1-2.25-2.25V6ZM13.5 15.75a2.25 2.25 0 0 1 2.25-2.25H18a2.25 2.25 0 0 1 2.25 2.25V18A2.25 2.25 0 0 1 18 20.25h-2.25A2.25 2.25 0 0 1 13.5 18v-2.25Z"/>
        </svg>
      </span>
      <span x-show="open" x-transition:enter="transition-opacity duration-150 delay-75"
            x-transition:enter-start="opacity-0" x-transition:enter-end="opacity-100"
            x-transition:leave="transition-opacity duration-75"
            x-transition:leave-start="opacity-100" x-transition:leave-end="opacity-0"
            class="whitespace-nowrap text-sm font-medium">Categories</span>
    </a>

    <a href="/lists"
       :class="open ? 'justify-start' : 'justify-center'"
       class="group flex items-center gap-3 rounded-xl px-1 py-1 text-zinc-500 dark:text-white hover:bg-zinc-100 dark:hover:bg-[#3F3D48] hover:text-zinc-900 transition-colors">
      <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-zinc-100 dark:bg-[#3F3D48] group-hover:bg-zinc-200 dark:group-hover:bg-[#4A4854] transition-colors">
        <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 6.75h12M8.25 12h12m-12 5.25h12M3.75 6.75h.007v.008H3.75V6.75Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0ZM3.75 12h.007v.008H3.75V12Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm-.375 5.25h.007v.008H3.75v-.008Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z"/>
        </svg>
      </span>
      <span x-show="open" x-transition:enter="transition-opacity duration-150 delay-75"
            x-transition:enter-start="opacity-0" x-transition:enter-end="opacity-100"
            x-transition:leave="transition-opacity duration-75"
            x-transition:leave-start="opacity-100" x-transition:leave-end="opacity-0"
            class="whitespace-nowrap text-sm font-medium">Lists</span>
    </a>

    <a href="/leaderboard"
       :class="open ? 'justify-start' : 'justify-center'"
       class="group flex items-center gap-3 rounded-xl px-1 py-1 text-zinc-500 dark:text-white hover:bg-zinc-100 dark:hover:bg-[#3F3D48] hover:text-zinc-900 transition-colors">
      <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-zinc-100 dark:bg-[#3F3D48] group-hover:bg-zinc-200 dark:group-hover:bg-[#4A4854] transition-colors">
        <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 18.75h-9m9 0a3 3 0 0 1 3 3h-15a3 3 0 0 1 3-3m9 0v-3.375c0-.621-.503-1.125-1.125-1.125h-.871M7.5 18.75v-3.375c0-.621.504-1.125 1.125-1.125h.872m5.007 0H9.497m5.007 0a7.454 7.454 0 0 1-.982-3.172M9.497 14.25a7.454 7.454 0 0 0 .981-3.172M5.25 4.236c-.982.143-1.954.317-2.916.52A6.003 6.003 0 0 0 7.73 9.728M5.25 4.236V4.5c0 2.108.966 3.99 2.48 5.228M5.25 4.236V2.721C7.456 2.25 9.72 2 12 2c2.28 0 4.544.25 6.75.721v1.515M18.75 4.236c.982.143 1.954.317 2.916.52a6.003 6.003 0 0 1-5.395 4.972M18.75 4.236V4.5c0 2.108-.966 3.99-2.48 5.228"/>
        </svg>
      </span>
      <span x-show="open" x-transition:enter="transition-opacity duration-150 delay-75"
            x-transition:enter-start="opacity-0" x-transition:enter-end="opacity-100"
            x-transition:leave="transition-opacity duration-75"
            x-transition:leave-start="opacity-100" x-transition:leave-end="opacity-0"
            class="whitespace-nowrap text-sm font-medium">Leaderboard</span>
    </a>

    <a href="https://newsletter.altern.ai/" target="_blank" rel="noopener noreferrer"
       :class="open ? 'justify-start' : 'justify-center'"
       class="group flex items-center gap-3 rounded-xl px-1 py-1 text-zinc-500 dark:text-white hover:bg-zinc-100 dark:hover:bg-[#3F3D48] hover:text-zinc-900 transition-colors">
      <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-zinc-100 dark:bg-[#3F3D48] group-hover:bg-zinc-200 dark:group-hover:bg-[#4A4854] transition-colors">
        <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75"/>
        </svg>
      </span>
      <span x-show="open" x-transition:enter="transition-opacity duration-150 delay-75"
            x-transition:enter-start="opacity-0" x-transition:enter-end="opacity-100"
            x-transition:leave="transition-opacity duration-75"
            x-transition:leave-start="opacity-100" x-transition:leave-end="opacity-0"
            class="whitespace-nowrap text-sm font-medium">Newsletter</span>
    </a>

  </div>
</aside>
