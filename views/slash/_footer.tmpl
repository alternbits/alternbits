<footer class="border-t border-zinc-100 dark:border-[#43444c] bg-white dark:bg-[#2d2e39]">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:py-16">

    <div class="grid grid-cols-2 gap-8 sm:grid-cols-4 lg:grid-cols-5">

      <!-- Brand -->
      <div class="col-span-2 sm:col-span-4 lg:col-span-2">
        <a href="/" class="inline-flex items-center gap-2 text-sm font-semibold tracking-tight text-zinc-900 dark:text-white">
          <img src="/assets/logo.png" alt="{{ appName }}" class="h-7 w-7 rounded-sm object-contain">
          {{ appName }}
        </a>
        <p class="mt-3 max-w-xs text-sm leading-relaxed text-zinc-500 dark:text-white">
          Find almost anything related to AI — tools, models, APIs, libraries, and more.
        </p>
        <p class="mt-4 text-xs text-zinc-400 dark:text-white">{{ appDomain }}</p>
      </div>

      <!-- Explore -->
      <div>
        <h3 class="text-xs font-semibold uppercase tracking-wider text-zinc-500 dark:text-white">Explore</h3>
        <ul class="mt-4 space-y-3">
          <li><a href="/#ais" class="text-sm text-zinc-600 dark:text-white hover:text-orange-500 dark:hover:text-white transition-colors">All AIs</a></li>
          <li><a href="/categories" class="text-sm text-zinc-600 dark:text-white hover:text-orange-500 dark:hover:text-white transition-colors">Categories</a></li>
          <li><a href="/lists" class="text-sm text-zinc-600 dark:text-white hover:text-orange-500 dark:hover:text-white transition-colors">Curated lists</a></li>
        </ul>
      </div>

      <!-- Makers -->
      <div>
        <h3 class="text-xs font-semibold uppercase tracking-wider text-zinc-500 dark:text-white">Makers</h3>
        <ul class="mt-4 space-y-3">
          <li><a href="/maker" class="text-sm text-zinc-600 dark:text-white hover:text-orange-500 dark:hover:text-white transition-colors">Maker area</a></li>
          <li><a href="/maker/submit" class="text-sm text-zinc-600 dark:text-white hover:text-orange-500 dark:hover:text-white transition-colors">Submit an AI</a></li>
        </ul>
      </div>

      <!-- Account -->
      <div>
        <h3 class="text-xs font-semibold uppercase tracking-wider text-zinc-500 dark:text-white">Account</h3>
        <ul class="mt-4 space-y-3">
          {{ if .CurrentUser }}
          <li><a href="/settings" class="text-sm text-zinc-600 dark:text-white hover:text-orange-500 dark:hover:text-white transition-colors">Settings</a></li>
          {{ else }}
          <li><a href="/signin" class="text-sm text-zinc-600 dark:text-white hover:text-orange-500 dark:hover:text-white transition-colors">Sign in</a></li>
          {{ end }}
        </ul>
      </div>

    </div>

    <div class="mt-12 border-t border-zinc-100 dark:border-[#43444c] pt-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-xs text-zinc-400 dark:text-white">&copy; {{ appName }}. All rights reserved.</p>

      <!-- Dark mode toggle -->
      <button @click="toggle()" title="Toggle dark mode"
              class="flex items-center gap-2 self-start rounded border border-zinc-200 dark:border-[#43444c] px-3 py-1.5 text-xs font-medium text-zinc-500 dark:text-white hover:bg-white dark:hover:bg-white/5 hover:text-zinc-700 dark:hover:text-white transition-colors sm:self-auto">
        <svg x-show="!darkMode" xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
        <svg x-show="darkMode" x-cloak xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="5"/>
          <line x1="12" y1="1" x2="12" y2="3"/>
          <line x1="12" y1="21" x2="12" y2="23"/>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
          <line x1="1" y1="12" x2="3" y2="12"/>
          <line x1="21" y1="12" x2="23" y2="12"/>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
        </svg>
        <span x-text="darkMode ? 'Dark mode' : 'Light mode'"></span>
      </button>
    </div>

  </div>
</footer>
