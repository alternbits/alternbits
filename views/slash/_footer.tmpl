<footer class="border-t border-zinc-100 dark:border-[#4D4D4D] bg-white dark:bg-[#393939]">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:py-16">

    <div class="grid grid-cols-2 gap-8 sm:grid-cols-4 lg:grid-cols-5">

      <!-- Brand -->
      <div class="col-span-2 sm:col-span-4 lg:col-span-2">
        <a href="/" class="inline-flex items-center gap-2 text-sm font-semibold tracking-tight text-zinc-900 dark:text-white">
          <img src="/assets/logo.png" alt="{{ appName }}" class="h-7 w-7 rounded-md object-contain">
          {{ appName }}
        </a>
        <p class="mt-3 max-w-xs text-sm leading-relaxed text-zinc-500 dark:text-zinc-400">
          Find almost anything related to AI — tools, models, APIs, libraries, and more.
        </p>
        <p class="mt-4 text-xs text-zinc-400 dark:text-zinc-500">{{ appDomain }}</p>
      </div>

      <!-- Explore -->
      <div>
        <h3 class="text-xs font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400">Explore</h3>
        <ul class="mt-4 space-y-3">
          <li><a href="/#ais" class="text-sm text-zinc-600 dark:text-white hover:text-orange-500 dark:hover:text-orange-400 transition-colors">All AIs</a></li>
          <li><a href="/categories" class="text-sm text-zinc-600 dark:text-white hover:text-orange-500 dark:hover:text-orange-400 transition-colors">Categories</a></li>
          <li><a href="/lists" class="text-sm text-zinc-600 dark:text-white hover:text-orange-500 dark:hover:text-orange-400 transition-colors">Curated lists</a></li>
        </ul>
      </div>

      <!-- Makers -->
      <div>
        <h3 class="text-xs font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400">Makers</h3>
        <ul class="mt-4 space-y-3">
          <li><a href="/maker" class="text-sm text-zinc-600 dark:text-white hover:text-orange-500 dark:hover:text-orange-400 transition-colors">Maker area</a></li>
          <li><a href="/maker/submit" class="text-sm text-zinc-600 dark:text-white hover:text-orange-500 dark:hover:text-orange-400 transition-colors">Submit an AI</a></li>
        </ul>
      </div>

      <!-- Account -->
      <div>
        <h3 class="text-xs font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400">Account</h3>
        <ul class="mt-4 space-y-3">
          {{ if .CurrentUser }}
          <li><a href="/settings" class="text-sm text-zinc-600 dark:text-white hover:text-orange-500 dark:hover:text-orange-400 transition-colors">Settings</a></li>
          {{ else }}
          <li><a href="/signin" class="text-sm text-zinc-600 dark:text-white hover:text-orange-500 dark:hover:text-orange-400 transition-colors">Sign in</a></li>
          {{ end }}
        </ul>
      </div>

    </div>

    <div class="mt-12 border-t border-zinc-100 dark:border-[#4D4D4D] pt-6 flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-xs text-zinc-400 dark:text-zinc-500">&copy; {{ appName }}. All rights reserved.</p>
    </div>

  </div>
</footer>
