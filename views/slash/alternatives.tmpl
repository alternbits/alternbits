<!doctype html>
<html lang="en">
<head>
  {{ with .AI }}
  <title>Alternatives to {{ .Name }} — {{ appName }}</title>
  <meta name="description" content="Discover alternatives to {{ .Name }}.">
  {{ else }}
  <title>Not found — {{ appName }}</title>
  {{ end }}
  {{ template "_slash_head.tmpl" . }}
</head>
<body x-data="{
  darkMode: document.documentElement.classList.contains('dark'),
  toggle() {
    this.darkMode = !this.darkMode;
    this.darkMode
      ? document.documentElement.classList.add('dark')
      : document.documentElement.classList.remove('dark');
    localStorage.setItem('theme', this.darkMode ? 'dark' : 'light');
  }
}" class="min-h-screen bg-white dark:bg-[#1c1d22] text-zinc-900 dark:text-white antialiased">

  {{ template "_header.tmpl" . }}
  {{ template "_sidebar.tmpl" . }}

  <div class="md:pl-[3.75rem]">

  {{ if .Error }}
  <div class="mx-auto max-w-2xl px-4 py-24 text-center sm:px-6">
    <p class="text-sm text-zinc-500 dark:text-zinc-400">{{ .Error }}</p>
    <a href="/" class="mt-4 inline-block text-sm font-medium text-orange-500 dark:text-[#ffc107] hover:text-orange-400 dark:hover:text-[#ffc107]">← Home</a>
  </div>
  {{ else }}
  {{ with .AI }}

  <!-- Header -->
  <div class="border-b border-zinc-100 dark:border-[#34353d] bg-zinc-50 dark:bg-[#202127] px-4 py-8 sm:px-6">
    <div class="mx-auto max-w-5xl">
      <a href="/ai/{{ .Slug }}" class="mb-4 inline-flex items-center gap-1.5 text-xs text-zinc-400 dark:text-zinc-500 hover:text-zinc-600 dark:hover:text-zinc-300 transition-colors">
        <svg class="h-3 w-3" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
        Back to {{ .Name }}
      </a>

      <div class="flex items-start gap-4">
        {{ if .LogoURL }}
        <img src="{{ .LogoURL }}" alt="{{ .Name }}"
             class="h-14 w-14 shrink-0 rounded-2xl bg-zinc-100 dark:bg-[#34353d] object-cover">
        {{ else if .Website }}
        <img src="{{ faviconURL .Website }}" alt="{{ .Name }}"
             class="h-14 w-14 shrink-0 rounded-2xl bg-zinc-100 dark:bg-[#34353d] object-cover p-3">
        {{ else }}
        <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-orange-100 dark:bg-amber-500/10 text-2xl font-black text-orange-500 dark:text-amber-400">
          {{ if .Name }}{{ slice .Name 0 1 }}{{ end }}
        </div>
        {{ end }}
        <div class="min-w-0">
          <p class="text-xs font-medium uppercase tracking-wider text-orange-500 dark:text-amber-400">Alternatives to</p>
          <h1 class="mt-0.5 text-2xl font-black tracking-tight text-zinc-900 dark:text-white sm:text-3xl">{{ .Name }}</h1>
          {{ if .Subtitle }}
          <p class="mt-1 text-sm text-zinc-500 dark:text-zinc-400">{{ .Subtitle }}</p>
          {{ end }}
          <p class="mt-2 text-xs text-zinc-400 dark:text-zinc-500">{{ len $.Alternatives }} approved alternative{{ if ne (len $.Alternatives) 1 }}s{{ end }}</p>
        </div>
      </div>
    </div>
  </div>

  {{ end }}

  <!-- Alternatives -->
  <div class="mx-auto max-w-5xl px-4 py-8 sm:px-6">
    {{ if .Alternatives }}
    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {{ range .Alternatives }}
      <a href="/ai/{{ .Slug }}"
         class="group flex items-start gap-4 rounded-xl border border-zinc-200 dark:border-[#34353d] bg-white dark:bg-[#26272e] p-4 hover:border-zinc-300 dark:hover:border-[#3d3e47] hover:shadow-sm dark:hover:shadow-black/20 transition-all">
        {{ if .LogoURL }}
        <img src="{{ .LogoURL }}" alt="{{ .Name }}"
             class="h-11 w-11 shrink-0 rounded-lg bg-zinc-100 dark:bg-[#34353d] object-cover">
        {{ else if .Website }}
        <img src="{{ faviconURL .Website }}" alt="{{ .Name }}"
             class="h-11 w-11 shrink-0 rounded-lg bg-zinc-100 dark:bg-[#34353d] object-cover p-2">
        {{ else }}
        <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-zinc-100 dark:bg-[#34353d] text-base font-semibold text-zinc-500 dark:text-zinc-400">
          {{ if .Name }}{{ slice .Name 0 1 }}{{ end }}
        </div>
        {{ end }}
        <div class="min-w-0 flex-1">
          <div class="flex items-center justify-between gap-2">
            <span class="truncate text-sm font-semibold text-zinc-900 dark:text-white">{{ .Name }}</span>
            <svg class="h-3.5 w-3.5 shrink-0 text-zinc-300 dark:text-[#34353d] group-hover:text-zinc-500 transition-colors" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
            </svg>
          </div>
          {{ if .Subtitle }}
          <p class="mt-0.5 truncate text-xs text-zinc-500 dark:text-zinc-400">{{ .Subtitle }}</p>
          {{ end }}
          {{ if .Categories }}
          <div class="mt-2 flex flex-wrap gap-1">
            {{ range .Categories }}
            <span class="rounded-full bg-zinc-100 dark:bg-[#34353d] px-2 py-0.5 text-[11px] font-medium text-zinc-500 dark:text-zinc-400">{{ .Name }}</span>
            {{ end }}
          </div>
          {{ end }}
        </div>
      </a>
      {{ end }}
    </div>
    {{ else }}
    <div class="rounded-xl border border-dashed border-zinc-200 dark:border-[#34353d] py-20 text-center text-sm text-zinc-400 dark:text-zinc-500">
      No alternatives yet for {{ with .AI }}{{ .Name }}{{ end }}.
    </div>
    {{ end }}
  </div>

  {{ end }}

  </div>

  {{ template "_footer.tmpl" . }}

</body>
</html>
