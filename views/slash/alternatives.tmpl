<!doctype html>
<html lang="en">
<head>
  {{ with .AI }}
  {{ $count := len $.Alternatives }}
  {{ $pageTitle := printf "Alternatives to %s" .Name }}
  {{ if $count }}{{ $pageTitle = printf "%d Best Alternatives to %s" $count .Name }}{{ end }}
  {{ if $count }}
  <title>{{ $pageTitle }} — {{ appName }}</title>
  <meta name="description" content="Compare the {{ $count }} best alternatives to {{ .Name }}, including {{ range $i, $a := $.Alternatives }}{{ if gt $i 0 }}{{ if lt $i 3 }}, {{ end }}{{ end }}{{ if lt $i 3 }}{{ $a.Name }}{{ end }}{{ if and (eq $i 3) (gt $count 3) }}, and more{{ end }}{{ end }} — find similar AI tools and pick the right fit.">
  {{ else }}
  <title>{{ $pageTitle }} — {{ appName }}</title>
  <meta name="description" content="No approved alternatives to {{ .Name }} yet. Browse similar AI tools on {{ appName }}.">
  <meta name="robots" content="noindex,follow">
  {{ end }}
  <link rel="canonical" href="{{ $.CanonicalURL }}">
  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ $pageTitle }} — {{ appName }}">
  <meta property="og:description" content="Discover AI tools like {{ .Name }} and compare features to find the right fit.">
  <meta property="og:url" content="{{ $.CanonicalURL }}">
  {{ if .LogoURL }}<meta property="og:image" content="{{ .LogoURL }}">{{ end }}
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="{{ $pageTitle }} — {{ appName }}">
  <meta name="twitter:description" content="Discover AI tools like {{ .Name }} and compare features to find the right fit.">
  {{ if $.Alternatives }}
  <script type="application/ld+json">{{ $.BreadcrumbJSON }}</script>
  <script type="application/ld+json">{{ $.ItemListJSON }}</script>
  {{ end }}
  {{ else }}
  <title>Not found — {{ appName }}</title>
  <meta name="robots" content="noindex">
  {{ end }}
  {{ template "_slash_head.tmpl" . }}
</head>
<body x-data="{
  darkMode: document.documentElement.classList.contains('dark'),
  toggle() {
    this.darkMode = !this.darkMode;
    this.darkMode
      ? document.documentElement.classList.add('dark')
      : document.documentElement.classList.remove('dark');
    localStorage.setItem('theme', this.darkMode ? 'dark' : 'light');
  }
}" class="min-h-screen bg-white dark:bg-[#2b2c31] text-zinc-900 dark:text-white antialiased">

  {{ template "_header.tmpl" . }}
  {{ template "_sidebar.tmpl" . }}

  <div class="md:pl-[3.75rem]">

  {{ if .Error }}
  <div class="mx-auto max-w-2xl px-4 py-24 text-center sm:px-6">
    <p class="text-sm text-zinc-500 dark:text-white">{{ .Error }}</p>
    <a href="/" class="mt-4 inline-block text-sm font-medium text-orange-500 dark:text-white hover:text-orange-400 dark:hover:text-white">← Home</a>
  </div>
  {{ else }}
  {{ with .AI }}

  <!-- Header -->
  <div class="border-b border-zinc-100 dark:border-[#43444c] bg-zinc-50 dark:bg-[#2f3036] px-4 py-8 sm:px-6">
    <div class="mx-auto max-w-5xl">
      <nav aria-label="Breadcrumb" class="mb-4 flex items-center gap-1.5 text-xs text-zinc-400 dark:text-white">
        <a href="/" class="hover:text-zinc-600 dark:hover:text-white transition-colors">Home</a>
        <span aria-hidden="true">/</span>
        <a href="/ai/{{ .Slug }}" class="hover:text-zinc-600 dark:hover:text-white transition-colors">{{ .Name }}</a>
        <span aria-hidden="true">/</span>
        <span class="text-zinc-600 dark:text-white">Alternatives</span>
      </nav>

      <div class="flex items-start gap-4">
        {{ if .LogoURL }}
        <img src="{{ .LogoURL }}" alt="{{ .Name }} logo"
             class="h-14 w-14 shrink-0 rounded-lg bg-zinc-100 dark:bg-[#43444c] object-cover">
        {{ else if .Website }}
        <img src="{{ faviconURL .Website }}" alt="{{ .Name }} logo"
             class="h-14 w-14 shrink-0 rounded-lg bg-zinc-100 dark:bg-[#43444c] object-cover p-3">
        {{ else }}
        <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-lg bg-orange-100 dark:bg-amber-500/10 text-2xl font-black text-orange-500 dark:text-white">
          {{ if .Name }}{{ slice .Name 0 1 }}{{ end }}
        </div>
        {{ end }}
        <div class="min-w-0">
          <h1 class="text-2xl font-black tracking-tight text-zinc-900 dark:text-white sm:text-3xl">
            <span class="block text-xs font-medium uppercase tracking-wider text-orange-500 dark:text-white">Alternatives to</span>
            {{ .Name }}
          </h1>
          {{ if .Subtitle }}
          <p class="mt-1 text-sm text-zinc-500 dark:text-white">{{ .Subtitle }}</p>
          {{ end }}
          <p class="mt-2 text-xs text-zinc-400 dark:text-white">{{ len $.Alternatives }} approved alternative{{ if ne (len $.Alternatives) 1 }}s{{ end }}</p>
        </div>
      </div>
    </div>
  </div>

  {{ end }}

  <!-- Alternatives -->
  <div class="mx-auto max-w-5xl px-4 py-8 sm:px-6">
    {{ if .Alternatives }}
    {{ with .AI }}
    <p class="mb-6 text-sm leading-relaxed text-zinc-500 dark:text-white">
      Looking for a tool like {{ .Name }}{{ if .Subtitle }} ({{ .Subtitle }}){{ end }}? Below {{ if eq (len $.Alternatives) 1 }}is{{ else }}are{{ end }} {{ len $.Alternatives }} AI tool{{ if ne (len $.Alternatives) 1 }}s{{ end }} people use as an alternative to {{ .Name }}. Each one is approved by our editors and worth comparing before you decide.
    </p>
    {{ end }}
    <div class="overflow-hidden rounded-md border border-zinc-200 dark:border-[#43444c] bg-white dark:bg-[#35363d]">
      {{ range $i, $alt := .Alternatives }}
      <div class="group relative flex items-center gap-4 px-4 py-3 hover:bg-zinc-50 dark:hover:bg-[#3a3b42] transition-colors {{ if $i }}border-t border-zinc-100 dark:border-[#43444c]{{ end }}">
        <a href="/ai/{{ .Slug }}" class="absolute inset-0" aria-label="{{ .Name }}"></a>
        {{ if .LogoURL }}
        <img src="{{ .LogoURL }}" alt="{{ .Name }}"
             class="h-9 w-9 shrink-0 rounded bg-zinc-100 dark:bg-[#43444c] object-cover">
        {{ else if .Website }}
        <img src="{{ faviconURL .Website }}" alt="{{ .Name }}"
             class="h-9 w-9 shrink-0 rounded bg-zinc-100 dark:bg-[#43444c] object-cover p-2">
        {{ else }}
        <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded bg-zinc-100 dark:bg-[#43444c] text-sm font-semibold text-zinc-500 dark:text-white">
          {{ if .Name }}{{ slice .Name 0 1 }}{{ end }}
        </div>
        {{ end }}
        <div class="min-w-0 flex-1">
          <span class="text-sm font-semibold text-zinc-900 dark:text-white">{{ .Name }}</span>
          {{ if .Subtitle }}
          <span class="ml-2 hidden truncate text-xs text-zinc-500 dark:text-white sm:inline">{{ .Subtitle }}</span>
          {{ end }}
        </div>
        {{ if .Categories }}
        <div class="hidden shrink-0 gap-1 md:flex">
          {{ range .Categories }}
          <span class="rounded-full bg-zinc-100 dark:bg-[#43444c] px-2 py-0.5 text-[11px] font-medium text-zinc-500 dark:text-white">{{ .Name }}</span>
          {{ end }}
        </div>
        {{ end }}
        <span class="hidden w-16 shrink-0 text-right text-xs text-zinc-400 dark:text-white sm:block">{{ .CreatedAt.Format "Jan 2" }}</span>
        {{ template "_save_button.tmpl" (dict "AI" . "Saved" (index $.SavedIDs .ID) "LoggedIn" $.CurrentUser) }}
        <svg class="h-3.5 w-3.5 shrink-0 text-zinc-300 dark:text-white group-hover:text-zinc-500 transition-colors" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
        </svg>
      </div>
      {{ end }}
    </div>
    {{ else }}
    <div class="rounded-md border border-dashed border-zinc-200 dark:border-[#43444c] py-20 text-center text-sm text-zinc-400 dark:text-white">
      {{ with .AI }}
      No approved alternatives to {{ .Name }} yet.
      <a href="/ai/{{ .Slug }}" class="block mt-2 font-medium text-orange-500 dark:text-white hover:text-orange-400 dark:hover:text-white">View {{ .Name }} →</a>
      {{ end }}
    </div>
    {{ end }}
  </div>

  {{ end }}

  </div>

  {{ template "_footer.tmpl" . }}

</body>
</html>
