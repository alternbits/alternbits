  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <link rel="icon" type="image/png" href="/assets/favicon/favicon-96x96.png" sizes="96x96" />
  <link rel="icon" type="image/svg+xml" href="/assets/favicon/favicon.svg" />
  <link rel="shortcut icon" href="/assets/favicon/favicon.ico" />
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/favicon/apple-touch-icon.png" />
  <meta name="apple-mobile-web-app-title" content="{{ appName }}" />
  <link rel="manifest" href="/assets/favicon/site.webmanifest" />
  <script>
    (function() {
      if (localStorage.getItem('theme') !== 'light') {
        document.documentElement.classList.add('dark');
      }
    })();
  </script>
  <style>
    html { font-size: 18px; }
    [x-cloak] { display: none !important; }
  </style>
  <script src="/static/js/tailwind.3.4.17.js"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['system-ui', '-apple-system', 'BlinkMacSystemFont', 'Segoe UI', 'Roboto', 'Helvetica Neue', 'Arial', 'sans-serif'],
          },
        },
      },
    }
  </script>
  <script>
    document.addEventListener('alpine:init', () => {
      Alpine.store('header', { scrolled: window.scrollY > 20 });
    });

    function saveButton(aiId, initSaved, loggedIn) {
      return {
        saved: initSaved,
        loading: false,
        async toggle() {
          if (!loggedIn) {
            window.location.href = '/signin?next=' + encodeURIComponent(window.location.pathname + window.location.search);
            return;
          }
          if (this.loading) return;
          this.loading = true;
          const prev = this.saved;
          this.saved = !prev;
          try {
            const res = await fetch('/saved/toggle', {
              method: 'POST',
              headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
              body: 'ai_id=' + encodeURIComponent(aiId),
            });
            if (!res.ok) throw new Error('save toggle failed');
            const data = await res.json();
            this.saved = !!data.saved;
          } catch (e) {
            this.saved = prev;
          } finally {
            this.loading = false;
          }
        },
      };
    }
  </script>
  <script defer src="/static/js/cdn.min.js"></script>
