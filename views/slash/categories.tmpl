<!doctype html>
<html lang="en">
<head>
  <title>Categories — {{ appName }}</title>
  <meta name="description" content="Browse AI tools by category.">
  {{ template "_slash_head.tmpl" . }}
</head>
<body x-data="{
  darkMode: document.documentElement.classList.contains('dark'),
  toggle() {
    this.darkMode = !this.darkMode;
    this.darkMode
      ? document.documentElement.classList.add('dark')
      : document.documentElement.classList.remove('dark');
    localStorage.setItem('theme', this.darkMode ? 'dark' : 'light');
  }
}" class="min-h-screen bg-white dark:bg-[#37353E] text-zinc-900 dark:text-white antialiased">

  {{ template "_header.tmpl" . }}
  {{ template "_sidebar.tmpl" . }}

  <!-- Page header -->
  <div class="border-b border-zinc-100 dark:border-[#4A4854] bg-zinc-50 dark:bg-[#32303A] px-4 py-8 sm:px-6">
    <div class="mx-auto max-w-5xl">
      <a href="/" class="mb-4 inline-flex items-center gap-1.5 text-xs text-zinc-400 dark:text-zinc-500 hover:text-zinc-600 dark:hover:text-zinc-300 transition-colors">
        <svg class="h-3 w-3" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
        Home
      </a>
      <h1 class="text-2xl font-black tracking-tight text-zinc-900 dark:text-white sm:text-3xl">Categories</h1>
      <p class="mt-1 text-sm text-zinc-500 dark:text-zinc-400">Browse AI tools by what they do.</p>
    </div>
  </div>

  <!-- Categories -->
  <div class="mx-auto max-w-5xl px-4 py-10 sm:px-6">
    {{ if .TopLevel }}
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      {{ range .TopLevel }}
      <a href="/categories/{{ .Slug }}"
         class="group rounded-xl border border-zinc-200 dark:border-[#4A4854] bg-white dark:bg-[#3F3D48] p-5 hover:border-zinc-300 dark:hover:border-[#5C5968] hover:shadow-sm dark:hover:shadow-black/20 transition-all">
        <div class="flex items-start justify-between gap-2">
          <h2 class="text-sm font-semibold text-zinc-900 dark:text-white">{{ .Name }}</h2>
          <svg class="mt-0.5 h-3.5 w-3.5 shrink-0 text-zinc-300 dark:text-[#4A4854] group-hover:text-zinc-500 transition-colors" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
          </svg>
        </div>
        {{ if .Subtitle }}
        <p class="mt-1 text-xs text-zinc-500 dark:text-zinc-400">{{ .Subtitle }}</p>
        {{ end }}
        {{ if .Children }}
        <div class="mt-3 flex flex-wrap gap-1.5">
          {{ range .Children }}
          <span class="rounded-full border border-zinc-200 dark:border-[#4A4854] bg-zinc-50 dark:bg-[#32303A] px-2.5 py-0.5 text-[11px] font-medium text-zinc-500 dark:text-zinc-400">{{ .Name }}</span>
          {{ end }}
        </div>
        {{ end }}
      </a>
      {{ end }}
    </div>
    {{ else }}
    <div class="rounded-xl border border-dashed border-zinc-200 dark:border-[#4A4854] py-20 text-center text-sm text-zinc-400 dark:text-zinc-500">
      No categories yet — check back soon.
    </div>
    {{ end }}
  </div>

  {{ template "_footer.tmpl" . }}

</body>
</html>
