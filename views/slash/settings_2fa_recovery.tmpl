<!doctype html>
<html lang="en">
<head>
  <title>Save recovery codes — {{ appName }}</title>
  {{ template "_slash_head.tmpl" . }}
</head>
<body x-data="{
  darkMode: document.documentElement.classList.contains('dark'),
  toggle() {
    this.darkMode = !this.darkMode;
    this.darkMode
      ? document.documentElement.classList.add('dark')
      : document.documentElement.classList.remove('dark');
    localStorage.setItem('theme', this.darkMode ? 'dark' : 'light');
  }
}" class="min-h-screen bg-white dark:bg-[#1c1d22] text-zinc-900 dark:text-white antialiased">

  {{ template "_header.tmpl" . }}

  <div class="mx-auto max-w-sm px-4 py-14 sm:px-6">

    <div class="mb-8 flex items-center justify-center">
      <span class="flex h-12 w-12 items-center justify-center rounded-full bg-green-100 dark:bg-green-900/30">
        <svg class="h-6 w-6 text-green-600 dark:text-green-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/>
        </svg>
      </span>
    </div>

    <h1 class="mb-1 text-center text-xl font-black tracking-tight">Two-factor auth enabled</h1>
    <p class="mb-8 text-center text-sm text-zinc-500 dark:text-zinc-400">Save these recovery codes somewhere safe. Each one can only be used once if you lose access to your authenticator app.</p>

    <div class="mb-6 overflow-hidden rounded-md border border-zinc-100 dark:border-[#34353d] bg-white dark:bg-[#26272e]">
      <div class="border-b border-zinc-100 dark:border-[#34353d] px-5 py-3">
        <p class="text-xs font-semibold uppercase tracking-widest text-zinc-400 dark:text-zinc-500">Recovery codes</p>
      </div>
      <ul class="grid grid-cols-2 divide-x divide-y divide-zinc-100 dark:divide-[#34353d]">
        {{ range .Codes }}
        <li class="px-4 py-2.5">
          <code class="text-sm font-mono text-zinc-700 dark:text-zinc-300 select-all">{{ . }}</code>
        </li>
        {{ end }}
      </ul>
    </div>

    <form method="POST" action="/settings/2fa/done">
      <button type="submit"
              class="w-full rounded-md bg-zinc-900 dark:bg-amber-500 py-2.5 text-sm font-semibold text-white hover:bg-zinc-800 dark:hover:bg-amber-400 transition-colors">
        I've saved my recovery codes
      </button>
    </form>

  </div>

  {{ template "_footer.tmpl" . }}
</body>
</html>
