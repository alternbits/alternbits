<div class="max-h-[60vh] overflow-y-auto px-2 py-2">

  <!-- Quick links (shown while query is empty) -->
  <template x-if="!query.trim()">
    <div class="py-1">
      <p class="px-3 pb-1.5 pt-2 text-[10px] font-semibold uppercase tracking-wider text-zinc-400 dark:text-white">Quick links</p>
      <a href="/#ais" @click="closeSearch()"
         class="flex items-center gap-3 rounded px-3 py-2.5 text-sm text-zinc-700 dark:text-white hover:bg-white dark:hover:bg-white/5 transition-colors">
        <span class="flex h-7 w-7 items-center justify-center rounded bg-white dark:bg-[#2d2e39] text-zinc-500 dark:text-white">
          <svg class="h-3.5 w-3.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09Z"/></svg>
        </span>
        All AIs
        <span class="ml-auto text-xs text-zinc-400 dark:text-white">Browse →</span>
      </a>
      <a href="/categories" @click="closeSearch()"
         class="flex items-center gap-3 rounded px-3 py-2.5 text-sm text-zinc-700 dark:text-white hover:bg-white dark:hover:bg-white/5 transition-colors">
        <span class="flex h-7 w-7 items-center justify-center rounded bg-white dark:bg-[#2d2e39] text-zinc-500 dark:text-white">
          <svg class="h-3.5 w-3.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 0 1 6 3.75h2.25A2.25 2.25 0 0 1 10.5 6v2.25a2.25 2.25 0 0 1-2.25 2.25H6a2.25 2.25 0 0 1-2.25-2.25V6ZM3.75 15.75A2.25 2.25 0 0 1 6 13.5h2.25a2.25 2.25 0 0 1 2.25 2.25V18a2.25 2.25 0 0 1-2.25 2.25H6A2.25 2.25 0 0 1 3.75 18v-2.25ZM13.5 6a2.25 2.25 0 0 1 2.25-2.25H18A2.25 2.25 0 0 1 20.25 6v2.25A2.25 2.25 0 0 1 18 10.5h-2.25a2.25 2.25 0 0 1-2.25-2.25V6ZM13.5 15.75a2.25 2.25 0 0 1 2.25-2.25H18a2.25 2.25 0 0 1 2.25 2.25V18A2.25 2.25 0 0 1 18 20.25h-2.25A2.25 2.25 0 0 1 13.5 18v-2.25Z"/></svg>
        </span>
        Categories
        <span class="ml-auto text-xs text-zinc-400 dark:text-white">Browse →</span>
      </a>
      <a href="/lists" @click="closeSearch()"
         class="flex items-center gap-3 rounded px-3 py-2.5 text-sm text-zinc-700 dark:text-white hover:bg-white dark:hover:bg-white/5 transition-colors">
        <span class="flex h-7 w-7 items-center justify-center rounded bg-white dark:bg-[#2d2e39] text-zinc-500 dark:text-white">
          <svg class="h-3.5 w-3.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 6.75h12M8.25 12h12m-12 5.25h12M3.75 6.75h.007v.008H3.75V6.75Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0ZM3.75 12h.007v.008H3.75V12Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm-.375 5.25h.007v.008H3.75v-.008Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z"/></svg>
        </span>
        Curated lists
        <span class="ml-auto text-xs text-zinc-400 dark:text-white">Browse →</span>
      </a>
    </div>
  </template>

  <!-- Loading -->
  <template x-if="query.trim() && loading">
    <div class="flex items-center justify-center gap-2 py-10 text-sm text-zinc-400 dark:text-white">
      <svg class="h-4 w-4 animate-spin" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 0 1 8-8V0C5.373 0 0 5.373 0 12h4z"></path>
      </svg>
      Searching…
    </div>
  </template>

  <!-- No results -->
  <template x-if="query.trim() && !loading && !hasResults">
    <p class="py-10 text-center text-sm text-zinc-400 dark:text-white">No results for "<span x-text="query"></span>"</p>
  </template>

  <!-- Live results -->
  <template x-if="query.trim() && !loading && hasResults">
    <div class="space-y-1 py-1">

      <template x-if="results.ais.length">
        <div>
          <p class="px-3 pb-1.5 pt-2 text-[10px] font-semibold uppercase tracking-wider text-zinc-400 dark:text-white">AIs</p>
          <template x-for="item in results.ais" :key="'ai-' + item.slug">
            <a :href="item.url" @click="closeSearch()"
               :class="flatResults[activeIndex] === item ? 'ring-1 ring-inset ring-zinc-300 dark:ring-0 dark:bg-[#2d2e39]' : ''"
               class="flex items-center gap-3 rounded px-3 py-2.5 text-sm text-zinc-700 dark:text-white hover:bg-white dark:hover:bg-white/5 transition-colors">
              <span class="flex h-7 w-7 shrink-0 items-center justify-center overflow-hidden rounded-[22%] bg-gradient-to-br from-white via-[#f7f3ea] to-[#ece2cc] p-1 text-zinc-500">
                <img x-show="item.logo_url" :src="item.logo_url" class="h-full w-full object-contain" alt="">
                <svg x-show="!item.logo_url" class="h-3.5 w-3.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09Z"/></svg>
              </span>
              <span class="min-w-0 flex-1 truncate">
                <span x-text="item.name" class="block truncate font-medium"></span>
                <span x-show="item.subtitle" x-text="item.subtitle" class="block truncate text-xs text-zinc-400 dark:text-white"></span>
              </span>
            </a>
          </template>
        </div>
      </template>

      <template x-if="results.categories.length">
        <div>
          <p class="px-3 pb-1.5 pt-2 text-[10px] font-semibold uppercase tracking-wider text-zinc-400 dark:text-white">Categories</p>
          <template x-for="item in results.categories" :key="'cat-' + item.slug">
            <a :href="item.url" @click="closeSearch()"
               :class="flatResults[activeIndex] === item ? 'ring-1 ring-inset ring-zinc-300 dark:ring-0 dark:bg-[#2d2e39]' : ''"
               class="flex items-center gap-3 rounded px-3 py-2.5 text-sm text-zinc-700 dark:text-white hover:bg-white dark:hover:bg-white/5 transition-colors">
              <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded bg-white dark:bg-[#2d2e39] text-zinc-500 dark:text-white">
                <svg class="h-3.5 w-3.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 0 1 6 3.75h2.25A2.25 2.25 0 0 1 10.5 6v2.25a2.25 2.25 0 0 1-2.25 2.25H6a2.25 2.25 0 0 1-2.25-2.25V6ZM3.75 15.75A2.25 2.25 0 0 1 6 13.5h2.25a2.25 2.25 0 0 1 2.25 2.25V18a2.25 2.25 0 0 1-2.25 2.25H6A2.25 2.25 0 0 1 3.75 18v-2.25ZM13.5 6a2.25 2.25 0 0 1 2.25-2.25H18A2.25 2.25 0 0 1 20.25 6v2.25A2.25 2.25 0 0 1 18 10.5h-2.25a2.25 2.25 0 0 1-2.25-2.25V6ZM13.5 15.75a2.25 2.25 0 0 1 2.25-2.25H18a2.25 2.25 0 0 1 2.25 2.25V18A2.25 2.25 0 0 1 18 20.25h-2.25A2.25 2.25 0 0 1 13.5 18v-2.25Z"/></svg>
              </span>
              <span x-text="item.name" class="truncate"></span>
            </a>
          </template>
        </div>
      </template>

      <template x-if="results.lists.length">
        <div>
          <p class="px-3 pb-1.5 pt-2 text-[10px] font-semibold uppercase tracking-wider text-zinc-400 dark:text-white">Lists</p>
          <template x-for="item in results.lists" :key="'list-' + item.slug">
            <a :href="item.url" @click="closeSearch()"
               :class="flatResults[activeIndex] === item ? 'ring-1 ring-inset ring-zinc-300 dark:ring-0 dark:bg-[#2d2e39]' : ''"
               class="flex items-center gap-3 rounded px-3 py-2.5 text-sm text-zinc-700 dark:text-white hover:bg-white dark:hover:bg-white/5 transition-colors">
              <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded bg-white dark:bg-[#2d2e39] text-zinc-500 dark:text-white">
                <svg class="h-3.5 w-3.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 6.75h12M8.25 12h12m-12 5.25h12M3.75 6.75h.007v.008H3.75V6.75Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0ZM3.75 12h.007v.008H3.75V12Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm-.375 5.25h.007v.008H3.75v-.008Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z"/></svg>
              </span>
              <span x-text="item.name" class="truncate"></span>
            </a>
          </template>
        </div>
      </template>

    </div>
  </template>

  <!-- View all results -->
  <template x-if="query.trim() && !loading">
    <a :href="'/search?q=' + encodeURIComponent(query.trim())" @click="closeSearch()"
       class="mt-1 flex items-center justify-center gap-1.5 rounded px-3 py-2.5 text-sm font-medium text-orange-600 dark:text-white hover:bg-white dark:hover:bg-white/5 transition-colors">
      View all results for "<span x-text="query"></span>"
      <svg class="h-3 w-3" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"/>
      </svg>
    </a>
  </template>

</div>

<!-- Footer -->
<div class="flex items-center justify-between border-t border-zinc-100 dark:border-[#43444c] px-3 py-2">
  <span class="text-xs text-zinc-400 dark:text-white">{{ .AICount }} AIs indexed</span>
  <div class="hidden items-center gap-2 text-[10px] text-zinc-400 dark:text-white sm:flex">
    <span class="flex items-center gap-1"><kbd class="rounded border border-zinc-200 dark:border-[#43444c] px-1 py-0.5 font-medium">↑↓</kbd> navigate</span>
    <span class="flex items-center gap-1"><kbd class="rounded border border-zinc-200 dark:border-[#43444c] px-1 py-0.5 font-medium">↵</kbd> open</span>
  </div>
</div>
