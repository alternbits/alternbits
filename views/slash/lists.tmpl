<!doctype html>
<html lang="en">
<head>
  <title>Curated Lists — {{ appName }}</title>
  <meta name="description" content="Hand-picked collections of AI tools for every use case.">
  {{ template "_slash_head.tmpl" . }}
</head>
<body x-data="{
  darkMode: document.documentElement.classList.contains('dark'),
  toggle() {
    this.darkMode = !this.darkMode;
    this.darkMode
      ? document.documentElement.classList.add('dark')
      : document.documentElement.classList.remove('dark');
    localStorage.setItem('theme', this.darkMode ? 'dark' : 'light');
  }
}" class="min-h-screen bg-white dark:bg-[#1c1d22] text-zinc-900 dark:text-white antialiased">

  {{ template "_header.tmpl" . }}
  {{ template "_sidebar.tmpl" . }}

  <div class="md:pl-[3.75rem]">

  <!-- Page header -->
  <div class="border-b border-zinc-100 dark:border-[#34353d] bg-zinc-50 dark:bg-[#202127] px-4 py-8 sm:px-6">
    <div class="mx-auto max-w-5xl">
      <a href="/" class="mb-4 inline-flex items-center gap-1.5 text-xs text-zinc-400 dark:text-zinc-500 hover:text-zinc-600 dark:hover:text-zinc-300 transition-colors">
        <svg class="h-3 w-3" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
        Home
      </a>
      <h1 class="text-2xl font-black tracking-tight text-zinc-900 dark:text-white sm:text-3xl">Curated Lists</h1>
      <p class="mt-1 text-sm text-zinc-500 dark:text-zinc-400">Hand-picked collections of AI tools for every use case.</p>
    </div>
  </div>

  <!-- Lists grid -->
  <div class="mx-auto max-w-5xl px-4 py-10 sm:px-6">
    {{ if .Lists }}
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {{ range .Lists }}
      <a href="/lists/{{ .Slug }}"
         class="group flex flex-col rounded-md border border-zinc-200 dark:border-[#34353d] bg-white dark:bg-[#26272e] p-5 hover:border-zinc-300 dark:hover:border-[#3d3e47] hover:shadow-sm dark:hover:shadow-black/20 transition-all">
        <div class="flex items-start justify-between gap-2">
          <h2 class="text-sm font-semibold text-zinc-900 dark:text-white">{{ .Name }}</h2>
          <svg class="mt-0.5 h-3.5 w-3.5 shrink-0 text-zinc-300 dark:text-[#34353d] group-hover:text-zinc-500 transition-colors" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
          </svg>
        </div>
        {{ if .Subtitle }}
        <p class="mt-1.5 text-xs text-zinc-500 dark:text-zinc-400 flex-1">{{ .Subtitle }}</p>
        {{ end }}
        <div class="mt-3 flex items-center gap-1.5 text-[11px] text-zinc-400 dark:text-zinc-500">
          <svg class="h-3.5 w-3.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 6.75h12M8.25 12h12m-12 5.25h12M3.75 6.75h.007v.008H3.75V6.75Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0ZM3.75 12h.007v.008H3.75V12Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm-.375 5.25h.007v.008H3.75v-.008Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z"/>
          </svg>
          {{ len .Items }} AIs
        </div>
      </a>
      {{ end }}
    </div>
    {{ else }}
    <div class="rounded-md border border-dashed border-zinc-200 dark:border-[#34353d] py-20 text-center text-sm text-zinc-400 dark:text-zinc-500">
      No lists yet — check back soon.
    </div>
    {{ end }}
  </div>

  </div>

  {{ template "_footer.tmpl" . }}

</body>
</html>
