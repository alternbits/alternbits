<!doctype html>
<html lang="en">
<head>
  {{ with .AI }}
  <title>{{ .Name }} — {{ appName }}</title>
  <meta name="description" content="{{ .Subtitle }}">
  {{ else }}
  <title>Not found — {{ appName }}</title>
  {{ end }}
  {{ template "_slash_head.tmpl" . }}
  <style>
    .markdown-body h1 { font-size: 1.75rem; font-weight: 800; margin: 1.5rem 0 0.75rem; }
    .markdown-body h2 { font-size: 1.375rem; font-weight: 700; margin: 1.25rem 0 0.6rem; }
    .markdown-body h3 { font-size: 1.125rem; font-weight: 600; margin: 1rem 0 0.5rem; }
    .markdown-body p  { margin: 0.75rem 0; line-height: 1.7; }
    .markdown-body ul, .markdown-body ol { margin: 0.75rem 0; padding-left: 1.5rem; }
    .markdown-body ul { list-style-type: disc; }
    .markdown-body ol { list-style-type: decimal; }
    .markdown-body li { margin: 0.25rem 0; line-height: 1.6; }
    .markdown-body a  { color: #f97316; text-decoration: underline; }
    .markdown-body a:hover { color: #fb923c; }
    .markdown-body code { font-family: ui-monospace, monospace; font-size: 0.875em; background: rgba(0,0,0,0.06); padding: 0.15em 0.4em; border-radius: 4px; }
    .dark .markdown-body code { background: rgba(255,255,255,0.1); }
    .markdown-body pre  { background: rgba(0,0,0,0.06); border-radius: 8px; padding: 1rem; overflow-x: auto; margin: 1rem 0; }
    .dark .markdown-body pre { background: rgba(255,255,255,0.07); }
    .markdown-body pre code { background: none; padding: 0; }
    .markdown-body blockquote { border-left: 3px solid #e5e7eb; padding-left: 1rem; color: #6b7280; margin: 1rem 0; }
    .dark .markdown-body blockquote { border-left-color: #43444c; color: #9ca3af; }
    .markdown-body hr { border: none; border-top: 1px solid #e5e7eb; margin: 1.5rem 0; }
    .dark .markdown-body hr { border-top-color: #43444c; }
    .markdown-body strong { font-weight: 700; }
    .markdown-body em { font-style: italic; }
  </style>
</head>
<body x-data="{
  darkMode: document.documentElement.classList.contains('dark'),
  toggle() {
    this.darkMode = !this.darkMode;
    this.darkMode
      ? document.documentElement.classList.add('dark')
      : document.documentElement.classList.remove('dark');
    localStorage.setItem('theme', this.darkMode ? 'dark' : 'light');
  }
}" class="min-h-screen bg-white dark:bg-[#2b2c31] text-zinc-900 dark:text-white antialiased">

  {{ template "_header.tmpl" . }}
  {{ template "_sidebar.tmpl" . }}

  <div class="md:pl-[3.75rem]">

  {{ if .Error }}
  <div class="mx-auto max-w-2xl px-4 py-24 text-center sm:px-6">
    <p class="text-sm text-zinc-500 dark:text-white">{{ .Error }}</p>
    <a href="/" class="mt-4 inline-block text-sm font-medium text-orange-500 dark:text-white hover:text-orange-400 dark:hover:text-white">← Back home</a>
  </div>
  {{ else }}
  {{ with .AI }}

  <!-- AI header -->
  <div class="border-b border-zinc-100 dark:border-[#43444c] bg-zinc-50 dark:bg-[#2f3036] px-4 py-8 sm:px-6">
    <div class="mx-auto max-w-5xl">
      <a href="/" class="mb-5 inline-flex items-center gap-1.5 text-xs text-zinc-400 dark:text-white hover:text-zinc-600 dark:hover:text-white transition-colors">
        <svg class="h-3 w-3" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
        Home
      </a>
      <div class="flex items-start gap-5">
        {{ if .LogoURL }}
        <img src="{{ .LogoURL }}" alt="{{ .Name }}"
             class="h-16 w-16 shrink-0 rounded-lg bg-zinc-100 dark:bg-[#43444c] object-cover shadow-sm">
        {{ else if .Website }}
        <img src="{{ faviconURL .Website }}" alt="{{ .Name }}"
             class="h-16 w-16 shrink-0 rounded-lg bg-zinc-100 dark:bg-[#43444c] object-cover shadow-sm p-3">
        {{ else }}
        <div class="flex h-16 w-16 shrink-0 items-center justify-center rounded-lg bg-zinc-200 dark:bg-[#43444c] text-2xl font-black text-zinc-500 dark:text-white shadow-sm">
          {{ if .Name }}{{ slice .Name 0 1 }}{{ end }}
        </div>
        {{ end }}

        <div class="min-w-0 flex-1">
          <div class="flex flex-wrap items-start justify-between gap-3">
            <div>
              <div class="flex flex-wrap items-center gap-2">
                <h1 class="text-2xl font-black tracking-tight text-zinc-900 dark:text-white sm:text-3xl">{{ .Name }}</h1>
                {{ if .HaveFree }}
                <span class="rounded-full bg-emerald-100 dark:bg-emerald-500/15 px-2.5 py-0.5 text-xs font-semibold text-emerald-700 dark:text-white">Free plan</span>
                {{ end }}
              </div>
              {{ if .Subtitle }}
              <p class="mt-1 text-sm text-zinc-500 dark:text-white">{{ .Subtitle }}</p>
              {{ end }}
            </div>
            {{ if .Website }}
            <a href="{{ .Website }}" target="_blank" rel="noopener noreferrer"
               class="shrink-0 rounded-md bg-orange-500 dark:bg-amber-500 px-5 py-2.5 text-sm font-semibold text-white hover:bg-orange-400 dark:hover:bg-amber-400 transition-colors">
              Visit →
            </a>
            {{ end }}
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Body: main + sidebar -->
  <div class="mx-auto max-w-5xl px-4 py-8 sm:px-6">
    <div class="flex flex-col gap-6 lg:flex-row lg:items-start lg:gap-8">

      <!-- Main content -->
      <div class="min-w-0 flex-1">
        {{ if .Description }}
        <section class="mb-6 rounded-md border border-zinc-100 dark:border-[#43444c] bg-white dark:bg-[#35363d] px-6 py-5">
          <h2 class="mb-3 text-xs font-semibold uppercase tracking-widest text-zinc-400 dark:text-white">About</h2>
          <div class="markdown-body text-sm text-zinc-700 dark:text-white">{{ markdownHTML .Description }}</div>
        </section>
        {{ else }}
        <section class="mb-6 rounded-md border border-dashed border-zinc-200 dark:border-[#43444c] px-6 py-10 text-center">
          <p class="text-sm text-zinc-400 dark:text-white">No description yet.</p>
        </section>
        {{ end }}

        {{ if .Screenshots }}
        <section class="mb-6 rounded-md border border-zinc-100 dark:border-[#43444c] bg-white dark:bg-[#35363d] px-6 py-5"
                 x-data="{ open: false, src: '', alt: '' }">
          <h2 class="mb-4 text-xs font-semibold uppercase tracking-widest text-zinc-400 dark:text-white">Screenshots</h2>
          <div class="grid gap-3 sm:grid-cols-2">
            {{ range .Screenshots }}
            <figure class="group cursor-zoom-in overflow-hidden rounded border border-zinc-100 dark:border-[#43444c]"
                    @click="open = true; src = $el.querySelector('img').src; alt = $el.querySelector('img').alt">
              <img src="{{ .URL }}" alt="{{ .Alt }}" loading="lazy"
                   class="w-full object-cover transition-transform duration-200 group-hover:scale-[1.02]">
              {{ if .Alt }}
              <figcaption class="bg-zinc-50 dark:bg-[#2f3036] px-3 py-1.5 text-xs text-zinc-400 dark:text-white">{{ .Alt }}</figcaption>
              {{ end }}
            </figure>
            {{ end }}
          </div>
          <!-- Lightbox -->
          <div x-show="open" x-cloak
               @click="open = false"
               @keydown.escape.window="open = false"
               class="fixed inset-0 z-50 flex items-center justify-center bg-black/80 p-4 backdrop-blur-sm">
            <img :src="src" :alt="alt" class="max-h-[90vh] max-w-full rounded-md shadow-2xl" @click.stop>
            <button @click="open = false"
                    class="absolute right-4 top-4 rounded-full bg-white/10 p-2 text-white hover:bg-white/20 transition-colors">
              <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"><path d="M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 1 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 1 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 0 0-1.06-1.06L10 8.94 6.28 5.22Z"/></svg>
            </button>
          </div>
        </section>
        {{ end }}
      </div>

      <!-- Sidebar -->
      <aside class="w-full shrink-0 space-y-4 lg:w-64">

        <!-- Visit -->
        {{ if .Website }}
        <a href="{{ .Website }}" target="_blank" rel="noopener noreferrer"
           class="flex w-full items-center justify-center gap-2 rounded-md bg-orange-500 dark:bg-amber-500 px-4 py-3 text-sm font-semibold text-white hover:bg-orange-400 dark:hover:bg-amber-400 transition-colors">
          Visit {{ .Name }}
          <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"/>
          </svg>
        </a>
        {{ end }}

        <!-- Save -->
        <button type="button"
                x-data="saveButton({{ .ID }}, {{ if index $.SavedIDs .ID }}true{{ else }}false{{ end }}, {{ if $.CurrentUser }}true{{ else }}false{{ end }})"
                @click="toggle()"
                :aria-pressed="saved"
                :class="saved ? 'border-orange-400 dark:border-amber-500/50 bg-orange-50 dark:bg-amber-500/10 text-orange-600 dark:text-white' : 'border-zinc-200 dark:border-[#43444c] bg-white dark:bg-[#35363d] text-zinc-700 dark:text-white hover:bg-zinc-50 dark:hover:bg-[#3a3b42]'"
                class="flex w-full items-center justify-center gap-2 rounded-md border px-4 py-3 text-sm font-semibold transition-colors">
          <svg class="h-4 w-4" :class="saved ? 'fill-current' : 'fill-none'" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17.593 3.322c1.1.128 1.907 1.077 1.907 2.185V21L12 17.25 4.5 21V5.507c0-1.108.806-2.057 1.907-2.185a48.507 48.507 0 0 1 11.186 0Z"/>
          </svg>
          <span x-text="saved ? 'Saved' : 'Save'"></span>
        </button>

        <!-- Categories -->
        {{ if .Categories }}
        <div class="rounded-md border border-zinc-100 dark:border-[#43444c] bg-white dark:bg-[#35363d] px-4 py-4">
          <h3 class="mb-3 text-xs font-semibold uppercase tracking-widest text-zinc-400 dark:text-white">Categories</h3>
          <div class="flex flex-wrap gap-1.5">
            {{ range .Categories }}
            <a href="/categories/{{ .Slug }}"
               class="rounded-full border border-zinc-200 dark:border-[#43444c] bg-zinc-50 dark:bg-[#2f3036] px-3 py-1 text-xs font-medium text-zinc-700 dark:text-white hover:border-orange-400 hover:bg-orange-50 dark:hover:bg-amber-500/10 hover:text-orange-600 dark:hover:text-white transition-colors">
              {{ .Name }}
            </a>
            {{ end }}
          </div>
        </div>
        {{ end }}

        <!-- Genera -->
        {{ if .Genera }}
        <div class="rounded-md border border-zinc-100 dark:border-[#43444c] bg-white dark:bg-[#35363d] px-4 py-4">
          <h3 class="mb-3 text-xs font-semibold uppercase tracking-widest text-zinc-400 dark:text-white">Type</h3>
          <div class="flex flex-wrap gap-1.5">
            {{ range .Genera }}
            <span class="rounded-full border border-zinc-200 dark:border-[#43444c] bg-zinc-50 dark:bg-[#2f3036] px-3 py-1 text-xs font-medium text-zinc-500 dark:text-white">
              {{ .Name }}
            </span>
            {{ end }}
          </div>
        </div>
        {{ end }}

        <!-- Alternatives -->
        {{ if $.AlternativesPreview }}
        <div class="rounded-md border border-zinc-100 dark:border-[#43444c] bg-white dark:bg-[#35363d] px-4 py-4">
          <h3 class="mb-3 text-xs font-semibold uppercase tracking-widest text-zinc-400 dark:text-white">Alternatives</h3>
          <div class="space-y-2">
            {{ range $.AlternativesPreview }}
            <a href="/ai/{{ .Slug }}"
               class="flex items-center gap-2.5 rounded-md border border-zinc-100 dark:border-[#43444c] px-2.5 py-2 hover:border-orange-400 dark:hover:border-amber-500/50 hover:bg-orange-50 dark:hover:bg-amber-500/10 transition-colors">
              {{ if .LogoURL }}
              <img src="{{ .LogoURL }}" alt="{{ .Name }}"
                   class="h-8 w-8 shrink-0 rounded bg-zinc-100 dark:bg-[#43444c] object-cover">
              {{ else if .Website }}
              <img src="{{ faviconURL .Website }}" alt="{{ .Name }}"
                   class="h-8 w-8 shrink-0 rounded bg-zinc-100 dark:bg-[#43444c] object-cover p-1.5">
              {{ else }}
              <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded bg-zinc-100 dark:bg-[#43444c] text-xs font-semibold text-zinc-500 dark:text-white">
                {{ if .Name }}{{ slice .Name 0 1 }}{{ end }}
              </div>
              {{ end }}
              <span class="truncate text-xs font-medium text-zinc-700 dark:text-white">{{ .Name }}</span>
            </a>
            {{ end }}
          </div>
          <a href="/alternatives/{{ .Slug }}"
             class="mt-3 inline-flex items-center gap-1 text-xs font-medium text-orange-500 dark:text-white hover:text-orange-400 dark:hover:text-white transition-colors">
            See all {{ $.AlternativesCount }} alternative{{ if ne $.AlternativesCount 1 }}s{{ end }}
            <svg class="h-3 w-3" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
          </a>
        </div>
        {{ end }}

        <!-- Meta -->
        <div class="rounded-md border border-zinc-100 dark:border-[#43444c] bg-white dark:bg-[#35363d] divide-y divide-zinc-100 dark:divide-[#43444c]">
          {{ if .HaveFree }}
          <div class="flex items-center justify-between px-4 py-3">
            <span class="text-xs text-zinc-400 dark:text-white">Pricing</span>
            <span class="rounded-full bg-emerald-100 dark:bg-emerald-500/15 px-2 py-0.5 text-xs font-semibold text-emerald-700 dark:text-white">Free plan</span>
          </div>
          {{ end }}
          {{ if .Website }}
          <div class="flex items-center justify-between gap-2 px-4 py-3">
            <span class="text-xs text-zinc-400 dark:text-white">Website</span>
            <a href="{{ .Website }}" target="_blank" rel="noopener noreferrer"
               class="truncate text-xs font-medium text-orange-500 dark:text-white hover:text-orange-400 dark:hover:text-white transition-colors">
              {{ .Website }}
            </a>
          </div>
          {{ end }}
          <div class="flex items-center justify-between px-4 py-3">
            <span class="text-xs text-zinc-400 dark:text-white">Added</span>
            <span class="text-xs font-medium text-zinc-700 dark:text-white">{{ .CreatedAt.Format "Jan 2, 2006" }}</span>
          </div>
          <div class="flex items-center justify-between px-4 py-3">
            <span class="text-xs text-zinc-400 dark:text-white">Slug</span>
            <code class="rounded bg-zinc-100 dark:bg-[#2f3036] px-1.5 py-0.5 text-[11px] text-zinc-600 dark:text-white">{{ .Slug }}</code>
          </div>
        </div>

      </aside>
    </div>
  </div>

  {{ end }}
  {{ end }}

  </div>

  {{ template "_footer.tmpl" . }}

</body>
</html>
