<!doctype html>
<html lang="en">
<head>
  {{ with .Category }}
  <title>{{ .Name }} — {{ appName }}</title>
  <meta name="description" content="{{ .Subtitle }}">
  <meta property="og:title" content="{{ .Name }} — {{ appName }}">
  <meta property="og:description" content="{{ .Subtitle }}">
  <meta name="twitter:title" content="{{ .Name }} — {{ appName }}">
  <meta name="twitter:description" content="{{ .Subtitle }}">
  {{ else }}
  <title>Not found — {{ appName }}</title>
  {{ end }}
  {{ template "_slash_head.tmpl" . }}
</head>
<body x-data="{
  darkMode: document.documentElement.classList.contains('dark'),
  toggle() {
    this.darkMode = !this.darkMode;
    this.darkMode
      ? document.documentElement.classList.add('dark')
      : document.documentElement.classList.remove('dark');
    localStorage.setItem('theme', this.darkMode ? 'dark' : 'light');
  }
}" class="min-h-screen bg-white dark:bg-[#2d2e39] text-zinc-900 dark:text-white antialiased">

  {{ template "_header.tmpl" . }}
  {{ template "_sidebar.tmpl" . }}

  <div class="md:pl-[3.75rem]">

  {{ if .Error }}
  <div class="mx-auto max-w-2xl px-4 py-24 text-center sm:px-6">
    <p class="text-sm text-zinc-500 dark:text-white">{{ .Error }}</p>
    <a href="/categories" class="mt-4 inline-block text-sm font-medium text-orange-500 dark:text-white hover:text-orange-400 dark:hover:text-white">← All categories</a>
  </div>
  {{ else }}
  {{ with .Category }}

  <!-- Category header -->
  <div class="border-b border-zinc-100 dark:border-[#43444c] bg-white dark:bg-[#2d2e39] px-4 py-8 sm:px-6">
    <div class="mx-auto max-w-5xl">
      <a href="/categories" class="mb-4 inline-flex items-center gap-1.5 text-xs text-zinc-400 dark:text-white hover:text-zinc-600 dark:hover:text-white transition-colors">
        <svg class="h-3 w-3" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
        {{ if .Parent }}{{ .Parent.Name }}{{ else }}All categories{{ end }}
      </a>

      <div class="flex items-start gap-4">
        <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-lg border border-zinc-200 dark:border-[#43444c] bg-white dark:bg-[#2d2e39] text-2xl font-black text-zinc-500 dark:text-white">
          {{ if .Name }}{{ slice .Name 0 1 }}{{ end }}
        </div>
        <div class="min-w-0">
          <h1 class="text-2xl font-black tracking-tight text-zinc-900 dark:text-white sm:text-3xl">{{ .Name }}</h1>
          {{ if .Subtitle }}
          <p class="mt-1 text-sm text-zinc-500 dark:text-white">{{ .Subtitle }}</p>
          {{ end }}
          <!-- Subcategory chips -->
          {{ if .Children }}
          <div class="mt-3 flex flex-wrap gap-1.5">
            {{ range .Children }}
            <a href="/categories/{{ .Slug }}"
               class="rounded-full border border-zinc-200 dark:border-[#43444c] bg-white dark:bg-[#2d2e39] px-3 py-0.5 text-xs font-medium text-zinc-600 dark:text-white hover:border-orange-400 dark:hover:border-amber-500/50 hover:text-orange-600 dark:hover:text-white transition-colors">
              {{ .Name }}
            </a>
            {{ end }}
          </div>
          {{ end }}
        </div>
      </div>
    </div>
  </div>

  <!-- AIs -->
  <div class="mx-auto max-w-5xl px-4 py-8 sm:px-6">
    {{ end }}
    {{ if .AIs }}
    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {{ range .AIs }}
      <div class="group relative flex items-start gap-4 rounded-md border border-zinc-200 dark:border-[#43444c] bg-white dark:bg-[#2d2e39] p-4 hover:border-zinc-300 dark:hover:border-[#4c4d56] hover:shadow-sm dark:hover:shadow-black/20 transition-all">
        <a href="/ai/{{ .Slug }}" class="absolute inset-0" aria-label="{{ .Name }}"></a>
        {{ if .LogoURL }}
        <img src="{{ .LogoURL }}" alt="{{ .Name }}"
             class="h-11 w-11 shrink-0 rounded-[22%] bg-gradient-to-br from-white via-[#f7f3ea] to-[#ece2cc] object-contain p-1.5">
        {{ else if .Website }}
        <img src="{{ faviconURL .Website }}" alt="{{ .Name }}"
             class="h-11 w-11 shrink-0 rounded-[22%] bg-gradient-to-br from-white via-[#f7f3ea] to-[#ece2cc] object-contain p-1.5">
        {{ else }}
        <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-[22%] bg-gradient-to-br from-white via-[#f7f3ea] to-[#ece2cc] text-base font-semibold text-zinc-500">
          {{ if .Name }}{{ slice .Name 0 1 }}{{ end }}
        </div>
        {{ end }}
        <div class="min-w-0 flex-1">
          <div class="flex items-center justify-between gap-2">
            <span class="truncate text-sm font-semibold text-zinc-900 dark:text-white">{{ .Name }}</span>
            <div class="flex shrink-0 items-center gap-1">
              {{ template "_save_button.tmpl" (dict "AI" . "Saved" (index $.SavedIDs .ID) "LoggedIn" $.CurrentUser) }}
              <svg class="h-3.5 w-3.5 shrink-0 text-zinc-300 dark:text-white group-hover:text-zinc-500 transition-colors" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
              </svg>
            </div>
          </div>
          {{ if .Subtitle }}
          <p class="mt-0.5 truncate text-xs text-zinc-500 dark:text-white">{{ .Subtitle }}</p>
          {{ end }}
          {{ if .Genera }}
          <div class="mt-2 flex flex-wrap gap-1">
            {{ range .Genera }}
            <span class="rounded-full border border-zinc-200 dark:border-[#43444c] bg-white dark:bg-[#2d2e39] px-2 py-0.5 text-[11px] font-medium text-zinc-500 dark:text-white">{{ .Name }}</span>
            {{ end }}
          </div>
          {{ end }}
        </div>
      </div>
      {{ end }}
    </div>
    {{ else }}
    <div class="rounded-md border border-dashed border-zinc-200 dark:border-[#43444c] py-20 text-center text-sm text-zinc-400 dark:text-white">
      No AIs in this category yet.
    </div>
    {{ end }}
  </div>

  {{ end }}

  </div>

  {{ template "_footer.tmpl" . }}

</body>
</html>
