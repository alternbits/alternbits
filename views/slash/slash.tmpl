<!doctype html>
<html lang="en">
<head>
  <title>{{ appName }} — Find almost anything related to AI</title>
  <meta name="description" content="Discover AI tools, curated lists, and categories — all in one place.">
  {{ template "_slash_head.tmpl" . }}
</head>
<body x-data="{
  darkMode: document.documentElement.classList.contains('dark'),
  toggle() {
    this.darkMode = !this.darkMode;
    this.darkMode
      ? document.documentElement.classList.add('dark')
      : document.documentElement.classList.remove('dark');
    localStorage.setItem('theme', this.darkMode ? 'dark' : 'light');
  }
}" class="min-h-screen bg-white dark:bg-[#37353E] text-zinc-900 dark:text-white antialiased">

  {{ template "_header.tmpl" . }}

  <!-- Hero -->
  <section class="border-b border-zinc-100 dark:border-[#4A4854] bg-zinc-50 dark:bg-[#32303A] px-4 py-20 text-center sm:px-6 sm:py-28">
    <div class="mx-auto max-w-2xl">
      <div class="mb-4 inline-flex items-center gap-2 rounded-full border border-zinc-200 dark:border-[#4A4854] bg-white dark:bg-[#3F3D48] px-3 py-1 text-xs font-medium text-zinc-500 dark:text-zinc-400">
        {{ .ToolCount }} tools indexed
      </div>
      <h1 class="text-4xl font-semibold tracking-tight text-zinc-900 dark:text-white sm:text-5xl">
        Find almost anything<br>related to AI.
      </h1>
      <p class="mt-4 text-base text-zinc-500 dark:text-zinc-400">
        The most complete directory of AI tools, organized by category and curated into lists.
      </p>
      <form class="mt-8 flex items-center gap-2 rounded-xl border border-zinc-200 dark:border-[#4A4854] bg-white dark:bg-[#3F3D48] px-4 py-3 shadow-sm focus-within:border-zinc-400 dark:focus-within:border-orange-500/50 focus-within:ring-2 focus-within:ring-zinc-900/5 dark:focus-within:ring-orange-500/10">
        <svg class="h-4 w-4 shrink-0 text-zinc-400 dark:text-zinc-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M17 11A6 6 0 1 1 5 11a6 6 0 0 1 12 0z"/>
        </svg>
        <input
          type="search"
          name="q"
          placeholder="Search tools, categories…"
          class="flex-1 bg-transparent text-sm text-zinc-900 dark:text-white placeholder-zinc-400 dark:placeholder-zinc-500 outline-none"
        >
        <button type="submit"
                class="shrink-0 rounded-lg bg-zinc-900 dark:bg-orange-500 px-4 py-1.5 text-sm font-medium text-white hover:bg-zinc-800 dark:hover:bg-orange-400">
          Search
        </button>
      </form>
    </div>
  </section>

  <!-- Categories -->
  {{ if .Categories }}
  <section id="categories" class="border-b border-zinc-100 dark:border-[#4A4854] px-4 py-10 sm:px-6">
    <div class="mx-auto max-w-6xl">
      <div class="mb-6 flex items-center justify-between">
        <h2 class="text-lg font-semibold tracking-tight text-zinc-900 dark:text-white">Browse by category</h2>
      </div>
      <div class="flex flex-wrap gap-2">
        {{ range .Categories }}
        <a href="/categories/{{ .Slug }}"
           class="rounded-full border border-zinc-200 dark:border-[#4A4854] bg-white dark:bg-[#3F3D48] px-4 py-1.5 text-sm font-medium text-zinc-700 dark:text-zinc-200 hover:border-zinc-300 dark:hover:border-[#5C5968] hover:bg-zinc-50 dark:hover:bg-[#47454F] hover:text-zinc-900 dark:hover:text-white">
          {{ .Name }}
        </a>
        {{ end }}
      </div>
    </div>
  </section>
  {{ end }}

  <!-- Tools -->
  <section id="tools" class="px-4 py-12 sm:px-6">
    <div class="mx-auto max-w-6xl">
      <div class="mb-6 flex items-center justify-between">
        <h2 class="text-lg font-semibold tracking-tight text-zinc-900 dark:text-white">Recently added</h2>
        <a href="/tools" class="text-sm text-zinc-500 dark:text-zinc-400 hover:text-zinc-700 dark:hover:text-zinc-200">All tools &rarr;</a>
      </div>

      {{ if .Tools }}
      <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {{ range .Tools }}
        <a href="/tools/{{ .Slug }}"
           class="group flex items-start gap-4 rounded-xl border border-zinc-200 dark:border-[#4A4854] bg-white dark:bg-[#3F3D48] p-4 hover:border-zinc-300 dark:hover:border-[#5C5968] hover:shadow-sm dark:hover:shadow-black/20">
          {{ if .LogoURL }}
          <img src="{{ .LogoURL }}" alt="{{ .Name }}"
               class="h-11 w-11 shrink-0 rounded-lg bg-zinc-100 dark:bg-[#4A4854] object-cover">
          {{ else }}
          <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-zinc-100 dark:bg-[#4A4854] text-base font-semibold text-zinc-500 dark:text-zinc-400">
            {{ if .Name }}{{ slice .Name 0 1 }}{{ end }}
          </div>
          {{ end }}
          <div class="min-w-0 flex-1">
            <div class="flex items-center justify-between gap-2">
              <span class="truncate text-sm font-semibold text-zinc-900 dark:text-white group-hover:text-zinc-700 dark:group-hover:text-zinc-100">{{ .Name }}</span>
              <svg class="h-3.5 w-3.5 shrink-0 text-zinc-300 dark:text-[#4A4854] group-hover:text-zinc-500 dark:group-hover:text-zinc-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
              </svg>
            </div>
            {{ if .Subtitle }}
            <p class="mt-0.5 truncate text-xs text-zinc-500 dark:text-zinc-400">{{ .Subtitle }}</p>
            {{ end }}
            {{ if .Categories }}
            <div class="mt-2 flex flex-wrap gap-1">
              {{ range .Categories }}
              <span class="rounded-full bg-zinc-100 dark:bg-[#4A4854] px-2 py-0.5 text-[11px] font-medium text-zinc-500 dark:text-zinc-400">{{ .Name }}</span>
              {{ end }}
            </div>
            {{ end }}
          </div>
        </a>
        {{ end }}
      </div>
      {{ else }}
      <div class="rounded-xl border border-dashed border-zinc-200 dark:border-[#4A4854] py-16 text-center text-sm text-zinc-400 dark:text-zinc-500">
        No tools yet — check back soon.
      </div>
      {{ end }}
    </div>
  </section>

  <!-- Lists -->
  {{ if .Lists }}
  <section id="lists" class="border-t border-zinc-100 dark:border-[#4A4854] bg-zinc-50 dark:bg-[#32303A] px-4 py-12 sm:px-6">
    <div class="mx-auto max-w-6xl">
      <div class="mb-6 flex items-center justify-between">
        <div>
          <h2 class="text-lg font-semibold tracking-tight text-zinc-900 dark:text-white">Curated lists</h2>
          <p class="mt-0.5 text-sm text-zinc-500 dark:text-zinc-400">Hand-picked collections for every use case.</p>
        </div>
        <a href="/lists" class="text-sm text-zinc-500 dark:text-zinc-400 hover:text-zinc-700 dark:hover:text-zinc-200">All lists &rarr;</a>
      </div>
      <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {{ range .Lists }}
        <a href="/lists/{{ .ID }}"
           class="group rounded-xl border border-zinc-200 dark:border-[#4A4854] bg-white dark:bg-[#3F3D48] p-5 hover:border-zinc-300 dark:hover:border-[#5C5968] hover:shadow-sm dark:hover:shadow-black/20">
          <div class="flex items-start justify-between gap-2">
            <h3 class="text-sm font-semibold text-zinc-900 dark:text-white group-hover:text-zinc-700 dark:group-hover:text-zinc-100">{{ .Name }}</h3>
            <svg class="mt-0.5 h-3.5 w-3.5 shrink-0 text-zinc-300 dark:text-[#4A4854] group-hover:text-zinc-500 dark:group-hover:text-zinc-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
            </svg>
          </div>
          {{ if .Subtitle }}
          <p class="mt-1 text-xs text-zinc-500 dark:text-zinc-400">{{ .Subtitle }}</p>
          {{ end }}
        </a>
        {{ end }}
      </div>
    </div>
  </section>
  {{ end }}

  <!-- Footer -->
  <footer class="border-t border-zinc-100 dark:border-[#4A4854] bg-white dark:bg-[#37353E]">
    <div class="mx-auto flex max-w-6xl flex-col items-start gap-2 px-4 py-5 text-xs text-zinc-400 dark:text-zinc-500 sm:flex-row sm:items-center sm:justify-between sm:px-6">
      <div class="flex items-center gap-2">
        <span class="font-medium text-zinc-600 dark:text-zinc-300">{{ appName }}</span>
        <span class="text-zinc-200 dark:text-[#4A4854]">·</span>
        <span>{{ appDomain }}</span>
      </div>
      <div class="flex items-center gap-4">
        <a href="/tools" class="hover:text-zinc-600 dark:hover:text-zinc-300">Tools</a>
        <a href="/categories" class="hover:text-zinc-600 dark:hover:text-zinc-300">Categories</a>
        <a href="/lists" class="hover:text-zinc-600 dark:hover:text-zinc-300">Lists</a>
      </div>
    </div>
  </footer>

</body>
</html>
