<!doctype html>
<html lang="en">
<head>
  <title>{{ appName }} — Find almost anything related to AI</title>
  <meta name="description" content="Discover AI tools, curated lists, and categories — all in one place.">
  <meta property="og:title" content="{{ appName }} — Find almost anything related to AI">
  <meta property="og:description" content="Discover AI tools, curated lists, and categories — all in one place.">
  <meta name="twitter:title" content="{{ appName }} — Find almost anything related to AI">
  <meta name="twitter:description" content="Discover AI tools, curated lists, and categories — all in one place.">
  {{ template "_slash_head.tmpl" . }}
</head>
<body x-data="{
  darkMode: document.documentElement.classList.contains('dark'),
  toggle() {
    this.darkMode = !this.darkMode;
    this.darkMode
      ? document.documentElement.classList.add('dark')
      : document.documentElement.classList.remove('dark');
    localStorage.setItem('theme', this.darkMode ? 'dark' : 'light');
  }
}" class="min-h-screen bg-white dark:bg-[#2d2e39] text-zinc-900 dark:text-white antialiased">

  {{ template "_header.tmpl" . }}

  {{ template "_sidebar.tmpl" . }}

  <div class="md:pl-[3.75rem]">

  <!-- Hero -->
  <section class="bg-white dark:bg-[#2d2e39] px-4 py-8 text-center sm:px-6 sm:py-12">
    <div class="mx-auto max-w-2xl">

      <h1 class="text-3xl font-bold leading-[1.1] tracking-tight text-zinc-900 dark:text-white sm:text-5xl">
        Find anything related to AI
      </h1>

     

      <div x-data="heroSearch()" class="relative mx-auto mt-8 max-w-xl text-left" @click.outside="closeSearch()">
        <form action="/search" method="GET"
              class="flex items-center gap-3 rounded-lg border border-zinc-200 dark:border-[#43444c] bg-white dark:bg-[#343434] px-5 py-3.5 shadow-sm transition-colors"
              :class="open ? 'border-zinc-400 dark:border-amber-500/50 ring-4 ring-zinc-900/5 dark:ring-amber-500/10' : ''">
          <svg class="h-5 w-5 shrink-0 text-zinc-400 dark:text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M17 11A6 6 0 1 1 5 11a6 6 0 0 1 12 0z"/>
          </svg>
          <input x-model="query" name="q" placeholder="Search AIs, categories, lists…"
                 @focus="openSearch()" @input="runSearch()" @keydown="onSearchKeydown($event)"
                 type="text" autocomplete="off" spellcheck="false"
                 class="flex-1 bg-transparent text-base text-zinc-900 dark:text-white placeholder-zinc-400 dark:placeholder-zinc-500 outline-none">
          <button x-show="query" x-cloak type="button"
                  @click="query = ''; results = { ais: [], categories: [], lists: [] }; activeIndex = -1"
                  class="shrink-0 text-zinc-400 dark:text-white hover:text-zinc-600">
            <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
            </svg>
          </button>
          <button type="submit"
                  class="shrink-0 rounded-md bg-zinc-900 dark:bg-amber-500 px-4 py-2 text-sm font-semibold text-white hover:bg-zinc-800 dark:hover:bg-amber-400 transition-colors">
            Search
          </button>
        </form>

        <!-- Live results dropdown (shared with header search) -->
        <div x-show="open" x-cloak
             x-transition:enter="transition ease-out duration-150"
             x-transition:enter-start="opacity-0 -translate-y-1"
             x-transition:enter-end="opacity-100 translate-y-0"
             x-transition:leave="transition ease-in duration-100"
             x-transition:leave-start="opacity-100 translate-y-0"
             x-transition:leave-end="opacity-0 -translate-y-1"
             class="absolute left-0 right-0 top-full z-50 mt-2 rounded-md border border-zinc-200 dark:border-[#43444c] bg-white dark:bg-[#2d2e39] shadow-xl dark:shadow-black/40 overflow-hidden">
          {{ template "_search_results.tmpl" . }}
        </div>
      </div>

      {{ if .TrendingAIs }}
      <div class="mx-auto mt-8 flex max-w-xl flex-wrap items-center justify-center gap-2">
        <span class="text-xs text-zinc-400 dark:text-zinc-500">Recently added</span>
        {{ range .TrendingAIs }}
        <a href="/ai/{{ .Slug }}"
           class="group flex items-center gap-1.5 rounded-full border border-zinc-200 dark:border-[#43444c] bg-white dark:bg-[#2d2e39] py-1 pl-1 pr-3 hover:border-orange-300 dark:hover:border-amber-500/40 hover:bg-white dark:hover:bg-white/5 transition-colors">
          {{ if .LogoURL }}
          <img src="{{ .LogoURL }}" alt="" class="h-5 w-5 shrink-0 rounded-[22%] bg-gradient-to-br from-white via-[#f7f3ea] to-[#ece2cc] object-contain p-0.5">
          {{ else if .Website }}
          <img src="{{ faviconURL .Website }}" alt="" class="h-5 w-5 shrink-0 rounded-[22%] bg-gradient-to-br from-white via-[#f7f3ea] to-[#ece2cc] object-contain p-0.5">
          {{ else }}
          <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-[22%] bg-gradient-to-br from-white via-[#f7f3ea] to-[#ece2cc] text-[10px] font-semibold text-zinc-500">
            {{ if .Name }}{{ slice .Name 0 1 }}{{ end }}
          </span>
          {{ end }}
          <span class="text-xs font-medium text-zinc-700 dark:text-white group-hover:text-orange-600 dark:group-hover:text-white">{{ .Name }}</span>
        </a>
        {{ end }}
      </div>
      {{ end }}

    </div>
  </section>

  <script>
    function heroSearch() {
      return {
        open: false,
        query: '',
        results: { ais: [], categories: [], lists: [] },
        loading: false,
        activeIndex: -1,
        _searchTimer: null,

        openSearch() {
          this.open = true;
        },

        closeSearch() {
          this.open = false;
        },

        runSearch() {
          clearTimeout(this._searchTimer);
          const q = this.query.trim();
          this.activeIndex = -1;
          this.open = true;
          if (!q) {
            this.results = { ais: [], categories: [], lists: [] };
            this.loading = false;
            return;
          }
          this.loading = true;
          this._searchTimer = setTimeout(async () => {
            try {
              const res = await fetch('/search/suggest?q=' + encodeURIComponent(q));
              this.results = await res.json();
            } catch (e) {
              this.results = { ais: [], categories: [], lists: [] };
            }
            this.loading = false;
          }, 200);
        },

        get flatResults() {
          return [...this.results.ais, ...this.results.categories, ...this.results.lists];
        },

        get hasResults() {
          return this.results.ais.length > 0 || this.results.categories.length > 0 || this.results.lists.length > 0;
        },

        onSearchKeydown(e) {
          const items = this.flatResults;
          if (e.key === 'ArrowDown') {
            e.preventDefault();
            if (items.length) this.activeIndex = (this.activeIndex + 1) % items.length;
          } else if (e.key === 'ArrowUp') {
            e.preventDefault();
            if (items.length) this.activeIndex = (this.activeIndex - 1 + items.length) % items.length;
          } else if (e.key === 'Enter') {
            const item = items[this.activeIndex];
            if (item) {
              e.preventDefault();
              window.location.href = item.url;
            }
          } else if (e.key === 'Escape') {
            this.closeSearch();
            e.target.blur();
          }
        },
      };
    }
  </script>

  <!-- AIs -->
  <section id="ais" class="px-4 pb-12 pt-2 sm:px-6 sm:pt-4">
    <div class="mx-auto max-w-7xl">
      <div class="mb-4 flex items-center justify-between">
        <h2 class="text-lg font-semibold tracking-tight text-zinc-900 dark:text-white">AIs</h2>
        <a href="/#ais" class="text-sm text-zinc-500 dark:text-white hover:text-zinc-700">All AIs &rarr;</a>
      </div>

      {{ if .Genera }}
      <div class="mb-6 flex flex-wrap gap-1.5">
        <a href="/#ais"
           class="rounded-full px-3 py-1.5 text-xs font-medium transition-colors {{ if not .SelectedGenus }}bg-zinc-900 text-white dark:bg-amber-500 dark:text-[#2d2e39]{{ else }}text-zinc-500 dark:text-zinc-400 hover:bg-zinc-100 dark:hover:bg-white/5 hover:text-zinc-900 dark:hover:text-white{{ end }}">
          Recently added
        </a>
        {{ $selected := .SelectedGenus }}
        {{ range .Genera }}
        <a href="/?genus={{ .Slug }}#ais"
           class="rounded-full px-3 py-1.5 text-xs font-medium transition-colors {{ if eq $selected .Slug }}bg-zinc-900 text-white dark:bg-amber-500 dark:text-[#2d2e39]{{ else }}text-zinc-500 dark:text-zinc-400 hover:bg-zinc-100 dark:hover:bg-white/5 hover:text-zinc-900 dark:hover:text-white{{ end }}">
          {{ .Name }}
        </a>
        {{ end }}
      </div>
      {{ end }}

      {{ if .AIs }}
      <table class="w-full border-collapse">
        <thead>
          <tr class="border-b border-zinc-100 dark:border-[#43444c]">
            <th class="pb-2.5 text-left text-[11px] font-semibold uppercase tracking-wider text-zinc-400 dark:text-zinc-500">Name</th>
            <th class="hidden pb-2.5 text-left text-[11px] font-semibold uppercase tracking-wider text-zinc-400 dark:text-zinc-500 md:table-cell">Category</th>
            <th class="hidden w-20 pb-2.5 text-right text-[11px] font-semibold uppercase tracking-wider text-zinc-400 dark:text-zinc-500 sm:table-cell">Added</th>
            <th class="w-8 pb-2.5"></th>
          </tr>
        </thead>
        <tbody>
          {{ range .AIs }}
          <tr class="group border-b border-zinc-100 dark:border-[#38393f] last:border-b-0 hover:bg-zinc-50 dark:hover:bg-white/[0.03] transition-colors">
            <td class="py-3 pr-4">
              <a href="/ai/{{ .Slug }}" class="flex min-w-0 items-center gap-3">
                {{ if .LogoURL }}
                <img src="{{ .LogoURL }}" alt="{{ .Name }}"
                     class="h-8 w-8 shrink-0 rounded-[22%] bg-gradient-to-br from-white via-[#f7f3ea] to-[#ece2cc] object-contain p-1">
                {{ else if .Website }}
                <img src="{{ faviconURL .Website }}" alt="{{ .Name }}"
                     class="h-8 w-8 shrink-0 rounded-[22%] bg-gradient-to-br from-white via-[#f7f3ea] to-[#ece2cc] object-contain p-1">
                {{ else }}
                <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-[22%] bg-gradient-to-br from-white via-[#f7f3ea] to-[#ece2cc] text-sm font-semibold text-zinc-500">
                  {{ if .Name }}{{ slice .Name 0 1 }}{{ end }}
                </div>
                {{ end }}
                <div class="min-w-0">
                  <span class="block truncate text-sm font-medium text-zinc-900 dark:text-white">{{ .Name }}</span>
                  {{ if .Subtitle }}
                  <span class="block truncate text-xs text-zinc-400 dark:text-zinc-500">{{ .Subtitle }}</span>
                  {{ end }}
                </div>
              </a>
            </td>
            <td class="hidden py-3 pr-4 md:table-cell">
              {{ if .Categories }}
              {{ with index .Categories 0 }}
              <a href="/categories/{{ .Slug }}" class="text-xs text-zinc-500 dark:text-zinc-400 hover:text-zinc-700 dark:hover:text-white">{{ .Name }}</a>
              {{ end }}
              {{ end }}
            </td>
            <td class="hidden py-3 pr-4 text-right text-xs text-zinc-400 dark:text-zinc-500 sm:table-cell">{{ .CreatedAt.Format "Jan 2" }}</td>
            <td class="py-3 text-right">
              {{ template "_save_button.tmpl" (dict "AI" . "Saved" (index $.SavedIDs .ID) "LoggedIn" $.CurrentUser) }}
            </td>
          </tr>
          {{ end }}
        </tbody>
      </table>
      {{ else }}
      <div class="rounded-md border border-dashed border-zinc-200 dark:border-[#43444c] py-16 text-center text-sm text-zinc-400 dark:text-white">
        {{ if .SelectedGenus }}No AIs in this genus yet.{{ else }}No AIs yet — check back soon.{{ end }}
      </div>
      {{ end }}
    </div>
  </section>

  <!-- Lists -->
  {{ if .Lists }}
  <section id="lists" class="border-t border-zinc-100 dark:border-[#43444c] bg-white dark:bg-[#2d2e39] px-4 py-12 sm:px-6">
    <div class="mx-auto max-w-6xl">
      <div class="mb-6 flex items-center justify-between">
        <div>
          <h2 class="text-lg font-semibold tracking-tight text-zinc-900 dark:text-white">Curated lists</h2>
          <p class="mt-0.5 text-sm text-zinc-500 dark:text-white">Hand-picked collections for every use case.</p>
        </div>
        <a href="/lists" class="text-sm text-zinc-500 dark:text-white hover:text-zinc-700">All lists &rarr;</a>
      </div>
      <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {{ range .Lists }}
        <a href="/lists/{{ .Slug }}"
           class="group rounded-md border border-zinc-200 dark:border-[#43444c] bg-white dark:bg-[#2d2e39] p-5 hover:border-zinc-300 dark:hover:border-[#4c4d56] hover:shadow-sm dark:hover:shadow-black/20">
          <div class="flex items-start justify-between gap-2">
            <h3 class="text-sm font-semibold text-zinc-900 dark:text-white group-hover:text-zinc-700 dark:group-hover:text-white">{{ .Name }}</h3>
            <svg class="mt-0.5 h-3.5 w-3.5 shrink-0 text-zinc-300 dark:text-white group-hover:text-zinc-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
            </svg>
          </div>
          {{ if .Subtitle }}
          <p class="mt-1 text-xs text-zinc-500 dark:text-white">{{ .Subtitle }}</p>
          {{ end }}
        </a>
        {{ end }}
      </div>
    </div>
  </section>
  {{ end }}

  <!-- Categories -->
  {{ if .Categories }}
  <section id="categories" class="border-t border-zinc-100 dark:border-[#43444c] px-4 py-10 sm:px-6">
    <div class="mx-auto max-w-6xl">
      <div class="mb-6 flex items-center justify-between">
        <h2 class="text-lg font-semibold tracking-tight text-zinc-900 dark:text-white">Browse by category</h2>
      </div>
      <div class="flex flex-wrap gap-2">
        {{ range .Categories }}
        <a href="/categories/{{ .Slug }}"
           class="rounded-full border border-zinc-200 dark:border-[#43444c] bg-white dark:bg-[#2d2e39] px-4 py-1.5 text-sm font-medium text-zinc-700 dark:text-white hover:border-zinc-300 dark:hover:border-[#4c4d56] hover:bg-white dark:hover:bg-white/5 hover:text-zinc-900">
          {{ .Name }}
        </a>
        {{ end }}
      </div>
    </div>
  </section>
  {{ end }}

  </div>

  {{ template "_footer.tmpl" . }}

</body>
</html>
