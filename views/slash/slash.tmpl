<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{ appName }} — Find almost anything related to AI</title>
  <meta name="description" content="Discover AI tools, curated lists, and categories — all in one place.">
  <script src="https://cdn.tailwindcss.com"></script>
  <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
  <style>[x-cloak] { display: none !important; }</style>
</head>
<body class="min-h-screen bg-white text-zinc-900 antialiased">

  <!-- Navbar -->
  <header class="sticky top-0 z-20 border-b border-zinc-100 bg-white/90 backdrop-blur">
    <div class="mx-auto flex h-14 max-w-6xl items-center justify-between px-4 sm:px-6">
      <a href="/" class="flex items-center gap-2 text-sm font-semibold tracking-tight text-zinc-900">
        <span class="inline-flex h-6 w-6 items-center justify-center rounded-md bg-zinc-900 text-[11px] font-bold text-white">
          {{ slice (appName) 0 1 }}
        </span>
        {{ appName }}
      </a>
      <nav class="hidden items-center gap-1 md:flex">
        <a href="/#tools" class="rounded-lg px-3 py-1.5 text-sm text-zinc-600 hover:bg-zinc-50 hover:text-zinc-900">Tools</a>
        <a href="/#categories" class="rounded-lg px-3 py-1.5 text-sm text-zinc-600 hover:bg-zinc-50 hover:text-zinc-900">Categories</a>
        <a href="/#lists" class="rounded-lg px-3 py-1.5 text-sm text-zinc-600 hover:bg-zinc-50 hover:text-zinc-900">Lists</a>
      </nav>
    </div>
  </header>

  <!-- Hero -->
  <section class="border-b border-zinc-100 bg-zinc-50 px-4 py-20 text-center sm:px-6 sm:py-28">
    <div class="mx-auto max-w-2xl">
      <div class="mb-4 inline-flex items-center gap-2 rounded-full border border-zinc-200 bg-white px-3 py-1 text-xs font-medium text-zinc-500">
        {{ .ToolCount }} tools indexed
      </div>
      <h1 class="text-4xl font-semibold tracking-tight text-zinc-900 sm:text-5xl">
        Find almost anything<br>related to AI.
      </h1>
      <p class="mt-4 text-base text-zinc-500">
        The most complete directory of AI tools, organized by category and curated into lists.
      </p>
      <form class="mt-8 flex items-center gap-2 rounded-xl border border-zinc-200 bg-white px-4 py-3 shadow-sm focus-within:border-zinc-400 focus-within:ring-2 focus-within:ring-zinc-900/5">
        <svg class="h-4 w-4 shrink-0 text-zinc-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M17 11A6 6 0 1 1 5 11a6 6 0 0 1 12 0z"/>
        </svg>
        <input
          type="search"
          name="q"
          placeholder="Search tools, categories…"
          class="flex-1 bg-transparent text-sm text-zinc-900 placeholder-zinc-400 outline-none"
        >
        <button type="submit"
                class="shrink-0 rounded-lg bg-zinc-900 px-4 py-1.5 text-sm font-medium text-white hover:bg-zinc-800">
          Search
        </button>
      </form>
    </div>
  </section>

  <!-- Categories -->
  {{ if .Categories }}
  <section id="categories" class="border-b border-zinc-100 px-4 py-10 sm:px-6">
    <div class="mx-auto max-w-6xl">
      <div class="mb-6 flex items-center justify-between">
        <h2 class="text-lg font-semibold tracking-tight text-zinc-900">Browse by category</h2>
      </div>
      <div class="flex flex-wrap gap-2">
        {{ range .Categories }}
        <a href="/categories/{{ .Slug }}"
           class="rounded-full border border-zinc-200 bg-white px-4 py-1.5 text-sm font-medium text-zinc-700 hover:border-zinc-300 hover:bg-zinc-50 hover:text-zinc-900">
          {{ .Name }}
        </a>
        {{ end }}
      </div>
    </div>
  </section>
  {{ end }}

  <!-- Tools -->
  <section id="tools" class="px-4 py-12 sm:px-6">
    <div class="mx-auto max-w-6xl">
      <div class="mb-6 flex items-center justify-between">
        <h2 class="text-lg font-semibold tracking-tight text-zinc-900">Recently added</h2>
        <a href="/tools" class="text-sm text-zinc-500 hover:text-zinc-700">All tools &rarr;</a>
      </div>

      {{ if .Tools }}
      <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {{ range .Tools }}
        <a href="/tools/{{ .Slug }}"
           class="group flex items-start gap-4 rounded-xl border border-zinc-200 bg-white p-4 hover:border-zinc-300 hover:shadow-sm">
          {{ if .LogoURL }}
          <img src="{{ .LogoURL }}" alt="{{ .Name }}"
               class="h-11 w-11 shrink-0 rounded-lg bg-zinc-100 object-cover">
          {{ else }}
          <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-zinc-100 text-base font-semibold text-zinc-500">
            {{ if .Name }}{{ slice .Name 0 1 }}{{ end }}
          </div>
          {{ end }}
          <div class="min-w-0 flex-1">
            <div class="flex items-center justify-between gap-2">
              <span class="truncate text-sm font-semibold text-zinc-900 group-hover:text-zinc-700">{{ .Name }}</span>
              <svg class="h-3.5 w-3.5 shrink-0 text-zinc-300 group-hover:text-zinc-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
              </svg>
            </div>
            {{ if .Subtitle }}
            <p class="mt-0.5 truncate text-xs text-zinc-500">{{ .Subtitle }}</p>
            {{ end }}
            {{ if .Categories }}
            <div class="mt-2 flex flex-wrap gap-1">
              {{ range .Categories }}
              <span class="rounded-full bg-zinc-100 px-2 py-0.5 text-[11px] font-medium text-zinc-500">{{ .Name }}</span>
              {{ end }}
            </div>
            {{ end }}
          </div>
        </a>
        {{ end }}
      </div>
      {{ else }}
      <div class="rounded-xl border border-dashed border-zinc-200 py-16 text-center text-sm text-zinc-400">
        No tools yet — check back soon.
      </div>
      {{ end }}
    </div>
  </section>

  <!-- Lists -->
  {{ if .Lists }}
  <section id="lists" class="border-t border-zinc-100 bg-zinc-50 px-4 py-12 sm:px-6">
    <div class="mx-auto max-w-6xl">
      <div class="mb-6 flex items-center justify-between">
        <div>
          <h2 class="text-lg font-semibold tracking-tight text-zinc-900">Curated lists</h2>
          <p class="mt-0.5 text-sm text-zinc-500">Hand-picked collections for every use case.</p>
        </div>
        <a href="/lists" class="text-sm text-zinc-500 hover:text-zinc-700">All lists &rarr;</a>
      </div>
      <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {{ range .Lists }}
        <a href="/lists/{{ .ID }}"
           class="group rounded-xl border border-zinc-200 bg-white p-5 hover:border-zinc-300 hover:shadow-sm">
          <div class="flex items-start justify-between gap-2">
            <h3 class="text-sm font-semibold text-zinc-900 group-hover:text-zinc-700">{{ .Name }}</h3>
            <svg class="mt-0.5 h-3.5 w-3.5 shrink-0 text-zinc-300 group-hover:text-zinc-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
            </svg>
          </div>
          {{ if .Subtitle }}
          <p class="mt-1 text-xs text-zinc-500">{{ .Subtitle }}</p>
          {{ end }}
        </a>
        {{ end }}
      </div>
    </div>
  </section>
  {{ end }}

  <!-- Footer -->
  <footer class="border-t border-zinc-100 bg-white">
    <div class="mx-auto flex max-w-6xl flex-col items-start gap-2 px-4 py-5 text-xs text-zinc-400 sm:flex-row sm:items-center sm:justify-between sm:px-6">
      <div class="flex items-center gap-2">
        <span class="font-medium text-zinc-600">{{ appName }}</span>
        <span class="text-zinc-200">·</span>
        <span>{{ appDomain }}</span>
      </div>
      <div class="flex items-center gap-4">
        <a href="/tools" class="hover:text-zinc-600">Tools</a>
        <a href="/categories" class="hover:text-zinc-600">Categories</a>
        <a href="/lists" class="hover:text-zinc-600">Lists</a>
      </div>
    </div>
  </footer>

</body>
</html>
