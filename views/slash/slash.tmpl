<!doctype html>
<html lang="en">
<head>
  <title>{{ appName }} — Find almost anything related to AI</title>
  <meta name="description" content="Discover AI tools, curated lists, and categories — all in one place.">
  {{ template "_slash_head.tmpl" . }}
</head>
<body x-data="{
  darkMode: document.documentElement.classList.contains('dark'),
  toggle() {
    this.darkMode = !this.darkMode;
    this.darkMode
      ? document.documentElement.classList.add('dark')
      : document.documentElement.classList.remove('dark');
    localStorage.setItem('theme', this.darkMode ? 'dark' : 'light');
  }
}" class="min-h-screen bg-white dark:bg-[#37353E] text-zinc-900 dark:text-white antialiased">

  {{ template "_header.tmpl" . }}

  <!-- Desktop sidebar -->
  <aside x-data="{ open: false }"
         @mouseenter="open = true"
         @mouseleave="open = false"
         class="fixed left-0 top-14 z-40 hidden h-[calc(100vh-3.5rem)] md:flex">
    <div :class="open ? 'w-44' : 'w-14'"
         class="flex h-full flex-col gap-0.5 overflow-hidden border-r border-zinc-100 dark:border-[#4A4854] bg-white dark:bg-[#37353E] px-2 py-3 transition-[width] duration-200 ease-in-out">

      <a href="#tools"
         class="group flex items-center gap-2.5 rounded-lg p-1.5 text-zinc-500 dark:text-white hover:bg-zinc-50 dark:hover:bg-[#3F3D48] hover:text-zinc-900 transition-colors">
        <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-zinc-100 dark:border-[#4A4854] bg-zinc-50 dark:bg-[#3F3D48] group-hover:border-zinc-200 dark:group-hover:border-[#5C5968] transition-colors">
          <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09Z"/>
          </svg>
        </span>
        <span :class="open ? 'opacity-100' : 'opacity-0'"
              class="whitespace-nowrap text-sm font-medium transition-opacity duration-150">Tools</span>
      </a>

      <a href="#categories"
         class="group flex items-center gap-2.5 rounded-lg p-1.5 text-zinc-500 dark:text-white hover:bg-zinc-50 dark:hover:bg-[#3F3D48] hover:text-zinc-900 transition-colors">
        <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-zinc-100 dark:border-[#4A4854] bg-zinc-50 dark:bg-[#3F3D48] group-hover:border-zinc-200 dark:group-hover:border-[#5C5968] transition-colors">
          <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 0 1 6 3.75h2.25A2.25 2.25 0 0 1 10.5 6v2.25a2.25 2.25 0 0 1-2.25 2.25H6a2.25 2.25 0 0 1-2.25-2.25V6ZM3.75 15.75A2.25 2.25 0 0 1 6 13.5h2.25a2.25 2.25 0 0 1 2.25 2.25V18a2.25 2.25 0 0 1-2.25 2.25H6A2.25 2.25 0 0 1 3.75 18v-2.25ZM13.5 6a2.25 2.25 0 0 1 2.25-2.25H18A2.25 2.25 0 0 1 20.25 6v2.25A2.25 2.25 0 0 1 18 10.5h-2.25a2.25 2.25 0 0 1-2.25-2.25V6ZM13.5 15.75a2.25 2.25 0 0 1 2.25-2.25H18a2.25 2.25 0 0 1 2.25 2.25V18A2.25 2.25 0 0 1 18 20.25h-2.25A2.25 2.25 0 0 1 13.5 18v-2.25Z"/>
          </svg>
        </span>
        <span :class="open ? 'opacity-100' : 'opacity-0'"
              class="whitespace-nowrap text-sm font-medium transition-opacity duration-150">Categories</span>
      </a>

      <a href="#lists"
         class="group flex items-center gap-2.5 rounded-lg p-1.5 text-zinc-500 dark:text-white hover:bg-zinc-50 dark:hover:bg-[#3F3D48] hover:text-zinc-900 transition-colors">
        <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-zinc-100 dark:border-[#4A4854] bg-zinc-50 dark:bg-[#3F3D48] group-hover:border-zinc-200 dark:group-hover:border-[#5C5968] transition-colors">
          <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 6.75h12M8.25 12h12m-12 5.25h12M3.75 6.75h.007v.008H3.75V6.75Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0ZM3.75 12h.007v.008H3.75V12Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm-.375 5.25h.007v.008H3.75v-.008Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z"/>
          </svg>
        </span>
        <span :class="open ? 'opacity-100' : 'opacity-0'"
              class="whitespace-nowrap text-sm font-medium transition-opacity duration-150">Lists</span>
      </a>

    </div>
  </aside>

  <!-- Hero -->
  <section class="border-b border-zinc-100 dark:border-[#4A4854] bg-zinc-50 dark:bg-[#32303A] px-4 py-12 text-center sm:px-6 sm:py-16">
    <div class="mx-auto max-w-xl">
      <h1 class="text-3xl font-black tracking-tight text-zinc-900 dark:text-white sm:text-4xl">
        Find anything related to <span class="text-orange-500 dark:text-orange-400">AI.</span>
      </h1>

      <div x-data="{ open: false }" class="relative mt-6 text-left" @click.outside="open = false">
        <form action="/search" method="GET"
              class="flex items-center gap-2 rounded-xl border border-zinc-200 dark:border-[#4A4854] bg-white dark:bg-[#3F3D48] px-4 py-2.5 shadow-sm transition-colors"
              :class="open ? 'border-zinc-400 dark:border-orange-500/50 ring-2 ring-zinc-900/5 dark:ring-orange-500/10' : ''">
          <svg class="h-4 w-4 shrink-0 text-zinc-400 dark:text-zinc-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M17 11A6 6 0 1 1 5 11a6 6 0 0 1 12 0z"/>
          </svg>
          <input type="search" name="q" placeholder="Search tools, categories…"
                 @focus="open = true"
                 autocomplete="off"
                 class="flex-1 bg-transparent text-sm text-zinc-900 dark:text-white placeholder-zinc-400 dark:placeholder-zinc-500 outline-none">
          <button type="submit"
                  class="shrink-0 rounded-lg bg-zinc-900 dark:bg-orange-500 px-4 py-1.5 text-sm font-semibold text-white hover:bg-zinc-800 dark:hover:bg-orange-400">
            Search
          </button>
        </form>

        <!-- Expanding dropdown -->
        <div x-show="open"
             x-transition:enter="transition ease-out duration-150"
             x-transition:enter-start="opacity-0 -translate-y-1"
             x-transition:enter-end="opacity-100 translate-y-0"
             x-transition:leave="transition ease-in duration-100"
             x-transition:leave-start="opacity-100 translate-y-0"
             x-transition:leave-end="opacity-0 -translate-y-1"
             class="absolute left-0 right-0 top-full z-50 mt-2 rounded-xl border border-zinc-200 dark:border-[#4A4854] bg-white dark:bg-[#3F3D48] shadow-xl dark:shadow-black/40 overflow-hidden">

          <div class="px-4 pt-4 pb-3">
            <p class="mb-2.5 text-[11px] font-semibold uppercase tracking-widest text-zinc-400 dark:text-zinc-500">Categories</p>
            <div class="flex flex-wrap gap-1.5">
              <a href="/categories/writing-content" class="rounded-full border border-zinc-200 dark:border-[#4A4854] bg-zinc-50 dark:bg-[#32303A] px-3 py-1 text-xs font-medium text-zinc-700 dark:text-white hover:border-orange-400 hover:bg-orange-50 dark:hover:bg-orange-500/10 hover:text-orange-600 dark:hover:text-orange-400 transition-colors">Writing & Content</a>
              <a href="/categories/image-generation" class="rounded-full border border-zinc-200 dark:border-[#4A4854] bg-zinc-50 dark:bg-[#32303A] px-3 py-1 text-xs font-medium text-zinc-700 dark:text-white hover:border-orange-400 hover:bg-orange-50 dark:hover:bg-orange-500/10 hover:text-orange-600 dark:hover:text-orange-400 transition-colors">Image Generation</a>
              <a href="/categories/code-development" class="rounded-full border border-zinc-200 dark:border-[#4A4854] bg-zinc-50 dark:bg-[#32303A] px-3 py-1 text-xs font-medium text-zinc-700 dark:text-white hover:border-orange-400 hover:bg-orange-50 dark:hover:bg-orange-500/10 hover:text-orange-600 dark:hover:text-orange-400 transition-colors">Code & Development</a>
              <a href="/categories/video-animation" class="rounded-full border border-zinc-200 dark:border-[#4A4854] bg-zinc-50 dark:bg-[#32303A] px-3 py-1 text-xs font-medium text-zinc-700 dark:text-white hover:border-orange-400 hover:bg-orange-50 dark:hover:bg-orange-500/10 hover:text-orange-600 dark:hover:text-orange-400 transition-colors">Video & Animation</a>
              <a href="/categories/audio-music" class="rounded-full border border-zinc-200 dark:border-[#4A4854] bg-zinc-50 dark:bg-[#32303A] px-3 py-1 text-xs font-medium text-zinc-700 dark:text-white hover:border-orange-400 hover:bg-orange-50 dark:hover:bg-orange-500/10 hover:text-orange-600 dark:hover:text-orange-400 transition-colors">Audio & Music</a>
              <a href="/categories/productivity" class="rounded-full border border-zinc-200 dark:border-[#4A4854] bg-zinc-50 dark:bg-[#32303A] px-3 py-1 text-xs font-medium text-zinc-700 dark:text-white hover:border-orange-400 hover:bg-orange-50 dark:hover:bg-orange-500/10 hover:text-orange-600 dark:hover:text-orange-400 transition-colors">Productivity</a>
              <a href="/categories/chatbots-assistants" class="rounded-full border border-zinc-200 dark:border-[#4A4854] bg-zinc-50 dark:bg-[#32303A] px-3 py-1 text-xs font-medium text-zinc-700 dark:text-white hover:border-orange-400 hover:bg-orange-50 dark:hover:bg-orange-500/10 hover:text-orange-600 dark:hover:text-orange-400 transition-colors">Chatbots & Assistants</a>
              <a href="/categories/design-ux" class="rounded-full border border-zinc-200 dark:border-[#4A4854] bg-zinc-50 dark:bg-[#32303A] px-3 py-1 text-xs font-medium text-zinc-700 dark:text-white hover:border-orange-400 hover:bg-orange-50 dark:hover:bg-orange-500/10 hover:text-orange-600 dark:hover:text-orange-400 transition-colors">Design & UX</a>
            </div>
          </div>

          <div class="border-t border-zinc-100 dark:border-[#4A4854] px-4 pt-3 pb-2">
            <p class="mb-2 text-[11px] font-semibold uppercase tracking-widest text-zinc-400 dark:text-zinc-500">Trending</p>
            <ul>
              <li><a href="/ai/chatgpt" class="flex items-center gap-3 rounded-lg px-1.5 py-1.5 hover:bg-zinc-50 dark:hover:bg-[#32303A] transition-colors">
                <div class="flex h-7 w-7 shrink-0 items-center justify-center rounded-md bg-zinc-100 dark:bg-[#4A4854] text-xs font-semibold text-zinc-500 dark:text-zinc-400">C</div>
                <div class="min-w-0 flex-1"><span class="block truncate text-sm font-medium text-zinc-900 dark:text-white">ChatGPT</span><span class="block truncate text-xs text-zinc-400 dark:text-zinc-500">Conversational AI by OpenAI</span></div>
                <svg class="h-3.5 w-3.5 shrink-0 text-zinc-300 dark:text-[#4A4854]" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
              </a></li>
              <li><a href="/ai/midjourney" class="flex items-center gap-3 rounded-lg px-1.5 py-1.5 hover:bg-zinc-50 dark:hover:bg-[#32303A] transition-colors">
                <div class="flex h-7 w-7 shrink-0 items-center justify-center rounded-md bg-zinc-100 dark:bg-[#4A4854] text-xs font-semibold text-zinc-500 dark:text-zinc-400">M</div>
                <div class="min-w-0 flex-1"><span class="block truncate text-sm font-medium text-zinc-900 dark:text-white">Midjourney</span><span class="block truncate text-xs text-zinc-400 dark:text-zinc-500">High-quality AI art from text prompts</span></div>
                <svg class="h-3.5 w-3.5 shrink-0 text-zinc-300 dark:text-[#4A4854]" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
              </a></li>
              <li><a href="/ai/github-copilot" class="flex items-center gap-3 rounded-lg px-1.5 py-1.5 hover:bg-zinc-50 dark:hover:bg-[#32303A] transition-colors">
                <div class="flex h-7 w-7 shrink-0 items-center justify-center rounded-md bg-zinc-100 dark:bg-[#4A4854] text-xs font-semibold text-zinc-500 dark:text-zinc-400">G</div>
                <div class="min-w-0 flex-1"><span class="block truncate text-sm font-medium text-zinc-900 dark:text-white">GitHub Copilot</span><span class="block truncate text-xs text-zinc-400 dark:text-zinc-500">AI pair programmer in your editor</span></div>
                <svg class="h-3.5 w-3.5 shrink-0 text-zinc-300 dark:text-[#4A4854]" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
              </a></li>
              <li><a href="/ai/elevenlabs" class="flex items-center gap-3 rounded-lg px-1.5 py-1.5 hover:bg-zinc-50 dark:hover:bg-[#32303A] transition-colors">
                <div class="flex h-7 w-7 shrink-0 items-center justify-center rounded-md bg-zinc-100 dark:bg-[#4A4854] text-xs font-semibold text-zinc-500 dark:text-zinc-400">E</div>
                <div class="min-w-0 flex-1"><span class="block truncate text-sm font-medium text-zinc-900 dark:text-white">ElevenLabs</span><span class="block truncate text-xs text-zinc-400 dark:text-zinc-500">Realistic AI voice synthesis and cloning</span></div>
                <svg class="h-3.5 w-3.5 shrink-0 text-zinc-300 dark:text-[#4A4854]" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
              </a></li>
              <li><a href="/ai/perplexity" class="flex items-center gap-3 rounded-lg px-1.5 py-1.5 hover:bg-zinc-50 dark:hover:bg-[#32303A] transition-colors">
                <div class="flex h-7 w-7 shrink-0 items-center justify-center rounded-md bg-zinc-100 dark:bg-[#4A4854] text-xs font-semibold text-zinc-500 dark:text-zinc-400">P</div>
                <div class="min-w-0 flex-1"><span class="block truncate text-sm font-medium text-zinc-900 dark:text-white">Perplexity</span><span class="block truncate text-xs text-zinc-400 dark:text-zinc-500">AI-powered search with cited answers</span></div>
                <svg class="h-3.5 w-3.5 shrink-0 text-zinc-300 dark:text-[#4A4854]" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
              </a></li>
            </ul>
          </div>

          <div class="border-t border-zinc-100 dark:border-[#4A4854] px-4 py-2.5">
            <a href="/tools" class="flex items-center justify-between text-xs font-medium text-orange-500 dark:text-orange-400 hover:text-orange-600 dark:hover:text-orange-300">
              <span>Browse all tools</span>
              <svg class="h-3.5 w-3.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
            </a>
          </div>

        </div>
      </div>

    </div>
  </section>

  <!-- Categories -->
  {{ if .Categories }}
  <section id="categories" class="border-b border-zinc-100 dark:border-[#4A4854] px-4 py-10 sm:px-6">
    <div class="mx-auto max-w-6xl">
      <div class="mb-6 flex items-center justify-between">
        <h2 class="text-lg font-semibold tracking-tight text-zinc-900 dark:text-white">Browse by category</h2>
      </div>
      <div class="flex flex-wrap gap-2">
        {{ range .Categories }}
        <a href="/categories/{{ .Slug }}"
           class="rounded-full border border-zinc-200 dark:border-[#4A4854] bg-white dark:bg-[#3F3D48] px-4 py-1.5 text-sm font-medium text-zinc-700 dark:text-white hover:border-zinc-300 dark:hover:border-[#5C5968] hover:bg-zinc-50 dark:hover:bg-[#47454F] hover:text-zinc-900">
          {{ .Name }}
        </a>
        {{ end }}
      </div>
    </div>
  </section>
  {{ end }}

  <!-- Tools -->
  <section id="tools" class="px-4 py-12 sm:px-6">
    <div class="mx-auto max-w-6xl">
      <div class="mb-6 flex items-center justify-between">
        <h2 class="text-lg font-semibold tracking-tight text-zinc-900 dark:text-white">Recently added</h2>
        <a href="/tools" class="text-sm text-zinc-500 dark:text-white hover:text-zinc-700">All tools &rarr;</a>
      </div>

      {{ if .Tools }}
      <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {{ range .Tools }}
        <a href="/ai/{{ .Slug }}"
           class="group flex items-start gap-4 rounded-xl border border-zinc-200 dark:border-[#4A4854] bg-white dark:bg-[#3F3D48] p-4 hover:border-zinc-300 dark:hover:border-[#5C5968] hover:shadow-sm dark:hover:shadow-black/20">
          {{ if .LogoURL }}
          <img src="{{ .LogoURL }}" alt="{{ .Name }}"
               class="h-11 w-11 shrink-0 rounded-lg bg-zinc-100 dark:bg-[#4A4854] object-cover">
          {{ else }}
          <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-zinc-100 dark:bg-[#4A4854] text-base font-semibold text-zinc-500 dark:text-zinc-400">
            {{ if .Name }}{{ slice .Name 0 1 }}{{ end }}
          </div>
          {{ end }}
          <div class="min-w-0 flex-1">
            <div class="flex items-center justify-between gap-2">
              <span class="truncate text-sm font-semibold text-zinc-900 dark:text-white group-hover:text-zinc-700 dark:group-hover:text-white">{{ .Name }}</span>
              <svg class="h-3.5 w-3.5 shrink-0 text-zinc-300 dark:text-[#4A4854] group-hover:text-zinc-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
              </svg>
            </div>
            {{ if .Subtitle }}
            <p class="mt-0.5 truncate text-xs text-zinc-500 dark:text-zinc-400">{{ .Subtitle }}</p>
            {{ end }}
            {{ if .Categories }}
            <div class="mt-2 flex flex-wrap gap-1">
              {{ range .Categories }}
              <span class="rounded-full bg-zinc-100 dark:bg-[#4A4854] px-2 py-0.5 text-[11px] font-medium text-zinc-500 dark:text-zinc-400">{{ .Name }}</span>
              {{ end }}
            </div>
            {{ end }}
          </div>
        </a>
        {{ end }}
      </div>
      {{ else }}
      <div class="rounded-xl border border-dashed border-zinc-200 dark:border-[#4A4854] py-16 text-center text-sm text-zinc-400 dark:text-zinc-500">
        No tools yet — check back soon.
      </div>
      {{ end }}
    </div>
  </section>

  <!-- Lists -->
  {{ if .Lists }}
  <section id="lists" class="border-t border-zinc-100 dark:border-[#4A4854] bg-zinc-50 dark:bg-[#32303A] px-4 py-12 sm:px-6">
    <div class="mx-auto max-w-6xl">
      <div class="mb-6 flex items-center justify-between">
        <div>
          <h2 class="text-lg font-semibold tracking-tight text-zinc-900 dark:text-white">Curated lists</h2>
          <p class="mt-0.5 text-sm text-zinc-500 dark:text-zinc-400">Hand-picked collections for every use case.</p>
        </div>
        <a href="/lists" class="text-sm text-zinc-500 dark:text-white hover:text-zinc-700">All lists &rarr;</a>
      </div>
      <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {{ range .Lists }}
        <a href="/lists/{{ .ID }}"
           class="group rounded-xl border border-zinc-200 dark:border-[#4A4854] bg-white dark:bg-[#3F3D48] p-5 hover:border-zinc-300 dark:hover:border-[#5C5968] hover:shadow-sm dark:hover:shadow-black/20">
          <div class="flex items-start justify-between gap-2">
            <h3 class="text-sm font-semibold text-zinc-900 dark:text-white group-hover:text-zinc-700 dark:group-hover:text-white">{{ .Name }}</h3>
            <svg class="mt-0.5 h-3.5 w-3.5 shrink-0 text-zinc-300 dark:text-[#4A4854] group-hover:text-zinc-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
            </svg>
          </div>
          {{ if .Subtitle }}
          <p class="mt-1 text-xs text-zinc-500 dark:text-zinc-400">{{ .Subtitle }}</p>
          {{ end }}
        </a>
        {{ end }}
      </div>
    </div>
  </section>
  {{ end }}

  {{ template "_footer.tmpl" . }}

</body>
</html>
