<!doctype html>
<html lang="en">
<head>
  <title>{{ appName }} · Edit category</title>
  {{ template "_root_head.tmpl" . }}
</head>
<body class="min-h-screen bg-zinc-50 text-zinc-900">
  {{ template "_root_navbar.tmpl" . }}

  <div class="r-page-narrow">
    <header class="mb-6">
      <a href="/root/categories" class="mb-3 inline-flex items-center gap-1 text-xs text-zinc-400 hover:text-zinc-600">
        <svg class="h-3 w-3" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
        Categories
      </a>
      <h1 class="r-page-title">Edit category</h1>
      {{ with .Category }}<p class="r-page-sub">ID {{ .ID }} · created {{ .CreatedAt.Format "Jan 2, 2006" }}</p>{{ end }}
    </header>

    {{ if .Error }}<div class="r-error">{{ .Error }}</div>{{ end }}

    <form method="POST" action="/root/categories/{{ .Category.ID }}" class="r-form-card">
      {{ with .Category }}
      <div>
        <label for="name" class="r-label">Name <span class="r-req">*</span></label>
        <input type="text" id="name" name="name" required value="{{ .Name }}" class="r-input">
      </div>

      <div>
        <label for="slug" class="r-label">Slug <span class="r-req">*</span></label>
        <input type="text" id="slug" name="slug" required value="{{ .Slug }}" class="r-input">
      </div>

      <div>
        <label for="subtitle" class="r-label">Subtitle</label>
        <input type="text" id="subtitle" name="subtitle" value="{{ .Subtitle }}" class="r-input">
      </div>
      {{ end }}

      <div>
        <label for="parent_id" class="r-label">Parent</label>
        <select id="parent_id" name="parent_id" class="r-select">
          <option value="">— None (top-level) —</option>
          {{ $selected := .ParentID }}
          {{ range .Parents }}
          <option value="{{ .ID }}" {{ if eq (printf "%d" .ID) $selected }}selected{{ end }}>{{ .Name }}</option>
          {{ end }}
        </select>
        <p class="r-help">Optional — nest under an existing category.</p>
      </div>

      <div class="flex items-center justify-between pt-2">
        <a href="/root/categories" class="r-btn-ghost">Cancel</a>
        <button type="submit" class="r-btn-primary">Save changes</button>
      </div>
    </form>
  </div>

  {{ template "_root_footer.tmpl" . }}
</body>
</html>
