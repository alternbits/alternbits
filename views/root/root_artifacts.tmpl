<!doctype html>
<html lang="en">
<head>
  <title>{{ appName }} · Artifacts</title>
  {{ template "_root_head.tmpl" . }}
</head>
<body class="min-h-screen bg-zinc-50 text-zinc-900">
  {{ template "_root_navbar.tmpl" . }}

  <div class="r-page">
    <header class="r-page-header">
      <div>
        <h1 class="r-page-title">Artifacts</h1>
        {{ with .Page }}<p class="r-page-sub">{{ .Total }} total · page {{ .Page }} of {{ .TotalPages }}.</p>{{ end }}
      </div>
      <a href="/root/artifacts/new" class="r-btn-primary">+ New artifact</a>
    </header>

    <form method="GET" action="/root/artifacts" class="r-filter-bar">
      <div class="relative flex-1 min-w-48">
        <svg class="pointer-events-none absolute left-2.5 top-1/2 -translate-y-1/2 h-4 w-4 text-zinc-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
        <input type="text" name="q" value="{{ .Filters.Search }}" placeholder="Search name, slug…" class="r-filter-input" />
      </div>

      <select name="sort" class="r-filter-select">
        <option value=""{{ if eq .Filters.Sort "" }} selected{{ end }}>Newest first</option>
        <option value="oldest"{{ if eq .Filters.Sort "oldest" }} selected{{ end }}>Oldest first</option>
        <option value="name_asc"{{ if eq .Filters.Sort "name_asc" }} selected{{ end }}>Name A→Z</option>
        <option value="name_desc"{{ if eq .Filters.Sort "name_desc" }} selected{{ end }}>Name Z→A</option>
      </select>

      <button type="submit" class="r-filter-apply">Apply</button>

      {{ if or .Filters.Search .Filters.Sort }}<a href="/root/artifacts" class="r-filter-clear">Clear</a>{{ end }}
    </form>

    {{ if .Error }}<div class="r-error">{{ .Error }}</div>{{ end }}

    {{ with .Page }}
    <section class="overflow-hidden r-card">
      <ul class="divide-y divide-zinc-100 md:hidden">
        {{ range .Artifacts }}
        <li class="px-4 py-3">
          <div class="flex items-start justify-between gap-2">
            <div class="min-w-0 flex-1">
              <div class="truncate font-medium text-zinc-900">{{ .Name }}</div>
              <div class="truncate r-meta">{{ .Slug }}</div>
              <div class="mt-1 r-meta">{{ len .Fields }} field{{ if ne (len .Fields) 1 }}s{{ end }}</div>
            </div>
            <div class="flex shrink-0 items-center gap-3">
              <span class="text-xs text-zinc-400">{{ .CreatedAt.Format "2006-01-02" }}</span>
              <a href="/root/artifacts/{{ .ID }}/edit" class="r-row-action">Edit</a>
            </div>
          </div>
        </li>
        {{ else }}
        <li class="r-empty">No artifacts found.</li>
        {{ end }}
      </ul>

      <div class="hidden md:block">
        <table class="r-table">
          <thead class="r-thead">
            <tr>
              <th class="r-th">Artifact</th>
              <th class="r-th">Slug</th>
              <th class="r-th">Fields</th>
              <th class="r-th">Created</th>
              <th class="r-th"></th>
            </tr>
          </thead>
          <tbody class="r-tbody">
            {{ range .Artifacts }}
            <tr class="r-tr">
              <td class="r-td font-medium text-zinc-900">{{ .Name }}</td>
              <td class="r-td text-zinc-700"><code class="r-code">{{ .Slug }}</code></td>
              <td class="r-td text-zinc-700">{{ len .Fields }}</td>
              <td class="r-td r-muted">{{ .CreatedAt.Format "2006-01-02" }}</td>
              <td class="r-td text-right"><a href="/root/artifacts/{{ .ID }}/edit" class="r-row-action">Edit</a></td>
            </tr>
            {{ else }}
            <tr><td colspan="5" class="r-empty">No artifacts found.</td></tr>
            {{ end }}
          </tbody>
        </table>
      </div>

      {{ if or .HasPrev .HasNext }}
      <div class="r-pager">
        {{ if .HasPrev }}<a href="?page={{ .PrevPage }}{{ $.Filters.QueryStr }}" class="r-pager-link">&larr; Previous</a>{{ else }}<span class="r-pager-disabled">&larr; Previous</span>{{ end }}
        {{ if .HasNext }}<a href="?page={{ .NextPage }}{{ $.Filters.QueryStr }}" class="r-pager-link">Next &rarr;</a>{{ else }}<span class="r-pager-disabled">Next &rarr;</span>{{ end }}
      </div>
      {{ end }}
    </section>
    {{ end }}
  </div>

  {{ template "_root_footer.tmpl" . }}
</body>
</html>
