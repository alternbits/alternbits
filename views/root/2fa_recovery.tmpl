<!doctype html>
<html lang="en">
<head>
  <title>{{ appName }} · Recovery codes</title>
  {{ template "_root_head.tmpl" . }}
</head>
<body class="min-h-screen bg-zinc-50 text-zinc-900">
  <div class="mx-auto flex min-h-screen max-w-md flex-col items-center justify-center px-6">
    <div class="w-full rounded-2xl border border-zinc-200 bg-white p-8 shadow-sm">
      <h1 class="text-xl font-semibold tracking-tight">Save your recovery codes</h1>
      <p class="mt-1 text-sm text-zinc-500">Each code works once. Store them somewhere safe &mdash; you won&rsquo;t see them again.</p>

      <ul class="mt-6 grid grid-cols-2 gap-2 font-mono text-sm">
        {{ range .Codes }}
        <li class="rounded-lg border border-zinc-200 bg-zinc-50 px-3 py-2 text-center tracking-wider">{{ . }}</li>
        {{ end }}
      </ul>

      <form method="POST" action="{{ .Post }}" class="mt-6">
        <button type="submit"
                class="w-full rounded-lg bg-zinc-900 px-4 py-2.5 text-sm font-medium text-white hover:bg-zinc-800">
          I&rsquo;ve saved these &mdash; continue
        </button>
      </form>
    </div>
  </div>
</body>
</html>
