<nav x-data="{ open: false }"
     class="sticky top-0 z-20 border-b border-zinc-200 bg-white/80 backdrop-blur">
  <div class="mx-auto max-w-5xl px-4 sm:px-6">
    <div class="flex h-14 items-center justify-between">

      <!-- Brand + search -->
      <div class="flex items-center gap-4">
        <a href="/root" class="flex items-center gap-2 text-sm font-semibold tracking-tight text-zinc-900">
          <span class="inline-flex h-6 w-6 items-center justify-center rounded-md bg-zinc-900 text-[11px] font-bold text-white">
            {{ slice (appName) 0 1 }}
          </span>
          <span>{{ appName }}</span>
          <span class="hidden text-zinc-300 sm:inline">/</span>
          <span class="hidden text-zinc-500 sm:inline">root</span>
        </a>

        <!-- Global search (desktop) -->
        <div class="relative hidden md:block"
             x-data="{
               q: '',
               open: false,
               active: -1,
               sections: [
                 { label: 'AIs',        href: '/root/ais'        },
                 { label: 'Lists',      href: '/root/lists'      },
                 { label: 'Users',      href: '/root/users'      },
                 { label: 'Categories', href: '/root/categories' },
                 { label: 'Genera',     href: '/root/genera'     },
                 { label: 'Artifacts',  href: '/root/artifacts'  },
                 { label: 'Pages',      href: '/root/pages'      },
               ],
               go(href) {
                 if (this.q.trim()) window.location.href = href + '?q=' + encodeURIComponent(this.q.trim());
               },
               submit() {
                 if (this.active >= 0) this.go(this.sections[this.active].href);
                 else this.go('/root/ais');
               },
               onKeydown(e) {
                 if (!this.open) return;
                 if (e.key === 'ArrowDown') { e.preventDefault(); this.active = Math.min(this.active + 1, this.sections.length - 1); }
                 else if (e.key === 'ArrowUp') { e.preventDefault(); this.active = Math.max(this.active - 1, -1); }
               }
             }"
             @click.outside="open = false; active = -1">
          <div class="relative">
            <svg class="pointer-events-none absolute left-2.5 top-1/2 -translate-y-1/2 h-3.5 w-3.5 text-zinc-400"
                 xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M9 3.5a5.5 5.5 0 100 11 5.5 5.5 0 000-11zM2 9a7 7 0 1112.452 4.391l3.328 3.329a.75.75 0 11-1.06 1.06l-3.329-3.328A7 7 0 012 9z" clip-rule="evenodd" />
            </svg>
            <input type="text"
                   placeholder="Search…"
                   x-model="q"
                   @focus="open = q.trim().length > 0"
                   @input="open = q.trim().length > 0; active = -1"
                   @keydown.enter.prevent="submit()"
                   @keydown.escape="open = false; active = -1; $el.blur()"
                   @keydown="onKeydown($event)"
                   class="w-44 rounded-lg border border-zinc-200 bg-white py-1.5 pl-8 pr-3 text-sm text-zinc-900 placeholder-zinc-400 focus:border-zinc-400 focus:outline-none focus:ring-1 focus:ring-zinc-300" />
          </div>
          <div x-show="open"
               x-cloak
               x-transition:enter="transition ease-out duration-100"
               x-transition:enter-start="opacity-0 translate-y-0.5"
               x-transition:enter-end="opacity-100 translate-y-0"
               class="absolute left-0 top-full z-50 mt-1 w-56 rounded-lg border border-zinc-200 bg-white py-1 shadow-lg">
            <template x-for="(section, i) in sections" :key="section.href">
              <button type="button"
                      @click="go(section.href)"
                      @mouseenter="active = i"
                      :class="active === i ? 'bg-zinc-100 text-zinc-900' : 'text-zinc-700'"
                      class="flex w-full items-center gap-2.5 px-3 py-2 text-left text-sm">
                <svg class="h-3.5 w-3.5 shrink-0 text-zinc-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M9 3.5a5.5 5.5 0 100 11 5.5 5.5 0 000-11zM2 9a7 7 0 1112.452 4.391l3.328 3.329a.75.75 0 11-1.06 1.06l-3.329-3.328A7 7 0 012 9z" clip-rule="evenodd" />
                </svg>
                <span>Search in <span class="font-medium" x-text="section.label"></span></span>
              </button>
            </template>
            <div class="border-t border-zinc-100 px-3 py-1.5 text-xs text-zinc-400">
              ↵ defaults to AIs &nbsp;·&nbsp; ↑↓ to navigate
            </div>
          </div>
        </div>
      </div>

      <!-- Right side: nav links + More dropdown + actions -->
      <div class="hidden items-center gap-1 md:flex">
        {{ $active := .ActiveNav }}

        <a href="/root/ais"
           class="flex items-center gap-1.5 rounded-lg px-3 py-1.5 text-sm font-medium {{ if eq $active "ais" }}bg-zinc-100 text-zinc-900{{ else }}text-zinc-600 hover:bg-zinc-50 hover:text-zinc-900{{ end }}">
          <svg class="h-4 w-4 shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09ZM18.259 8.715 18 9.75l-.259-1.035a3.375 3.375 0 0 0-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 0 0 2.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 0 0 2.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 0 0-2.456 2.456ZM16.894 20.567 16.5 21.75l-.394-1.183a2.25 2.25 0 0 0-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 0 0 1.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 0 0 1.423 1.423l1.183.394-1.183.394a2.25 2.25 0 0 0-1.423 1.423Z" />
          </svg>
          AIs
        </a>
        <a href="/root/lists"
           class="flex items-center gap-1.5 rounded-lg px-3 py-1.5 text-sm font-medium {{ if eq $active "lists" }}bg-zinc-100 text-zinc-900{{ else }}text-zinc-600 hover:bg-zinc-50 hover:text-zinc-900{{ end }}">
          <svg class="h-4 w-4 shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 6.75h12M8.25 12h12m-12 5.25h12M3.75 6.75h.007v.008H3.75V6.75Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0ZM3.75 12h.007v.008H3.75V12Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm-.375 5.25h.007v.008H3.75v-.008Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" />
          </svg>
          Lists
        </a>
        <a href="/root/users"
           class="flex items-center gap-1.5 rounded-lg px-3 py-1.5 text-sm font-medium {{ if eq $active "users" }}bg-zinc-100 text-zinc-900{{ else }}text-zinc-600 hover:bg-zinc-50 hover:text-zinc-900{{ end }}">
          <svg class="h-4 w-4 shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z" />
          </svg>
          Users
        </a>

        <!-- More dropdown -->
        <div class="relative"
             x-data="{ more: false }"
             @click.outside="more = false"
             @keydown.escape.window="more = false">
          <button type="button"
                  @click="more = !more"
                  class="flex items-center gap-1 rounded-lg px-3 py-1.5 text-sm font-medium {{ if or (eq $active "categories") (eq $active "genera") (eq $active "artifacts") (eq $active "pages") }}bg-zinc-100 text-zinc-900{{ else }}text-zinc-600 hover:bg-zinc-50 hover:text-zinc-900{{ end }}">
            More
            <svg class="h-3.5 w-3.5 transition-transform duration-150" :class="more ? 'rotate-180' : ''"
                 xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
            </svg>
          </button>
          <div x-show="more"
               x-cloak
               x-transition:enter="transition ease-out duration-100"
               x-transition:enter-start="opacity-0 scale-95"
               x-transition:enter-end="opacity-100 scale-100"
               class="absolute right-0 top-full z-50 mt-1.5 w-44 rounded-xl border border-zinc-200 bg-white py-1.5 shadow-lg">
            <p class="px-3 pb-1 pt-0.5 text-[10px] font-semibold uppercase tracking-wider text-zinc-400">Taxonomy</p>
            <a href="/root/categories"
               class="flex items-center gap-2.5 px-3 py-2 text-sm {{ if eq $active "categories" }}bg-zinc-50 font-medium text-zinc-900{{ else }}text-zinc-700 hover:bg-zinc-50 hover:text-zinc-900{{ end }}">
              <svg class="h-4 w-4 shrink-0 text-zinc-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 0 1 6 3.75h2.25A2.25 2.25 0 0 1 10.5 6v2.25a2.25 2.25 0 0 1-2.25 2.25H6a2.25 2.25 0 0 1-2.25-2.25V6ZM3.75 15.75A2.25 2.25 0 0 1 6 13.5h2.25a2.25 2.25 0 0 1 2.25 2.25V18a2.25 2.25 0 0 1-2.25 2.25H6A2.25 2.25 0 0 1 3.75 18v-2.25ZM13.5 6a2.25 2.25 0 0 1 2.25-2.25H18A2.25 2.25 0 0 1 20.25 6v2.25A2.25 2.25 0 0 1 18 10.5h-2.25a2.25 2.25 0 0 1-2.25-2.25V6ZM13.5 15.75a2.25 2.25 0 0 1 2.25-2.25H18a2.25 2.25 0 0 1 2.25 2.25V18A2.25 2.25 0 0 1 18 20.25h-2.25A2.25 2.25 0 0 1 13.5 18v-2.25Z" />
              </svg>
              Categories
            </a>
            <a href="/root/genera"
               class="flex items-center gap-2.5 px-3 py-2 text-sm {{ if eq $active "genera" }}bg-zinc-50 font-medium text-zinc-900{{ else }}text-zinc-700 hover:bg-zinc-50 hover:text-zinc-900{{ end }}">
              <svg class="h-4 w-4 shrink-0 text-zinc-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9.568 3H5.25A2.25 2.25 0 0 0 3 5.25v4.318c0 .597.237 1.17.659 1.591l9.581 9.581c.699.699 1.78.872 2.607.33a18.095 18.095 0 0 0 5.223-5.223c.542-.827.369-1.908-.33-2.607L11.16 3.66A2.25 2.25 0 0 0 9.568 3Z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 6h.008v.008H6V6Z" />
              </svg>
              Genera
            </a>
            <div class="my-1.5 border-t border-zinc-100"></div>
            <p class="px-3 pb-1 pt-0.5 text-[10px] font-semibold uppercase tracking-wider text-zinc-400">Schema</p>
            <a href="/root/artifacts"
               class="flex items-center gap-2.5 px-3 py-2 text-sm {{ if eq $active "artifacts" }}bg-zinc-50 font-medium text-zinc-900{{ else }}text-zinc-700 hover:bg-zinc-50 hover:text-zinc-900{{ end }}">
              <svg class="h-4 w-4 shrink-0 text-zinc-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75 22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3-4.5 16.5" />
              </svg>
              Artifacts
            </a>
            <div class="my-1.5 border-t border-zinc-100"></div>
            <p class="px-3 pb-1 pt-0.5 text-[10px] font-semibold uppercase tracking-wider text-zinc-400">Content</p>
            <a href="/root/pages"
               class="flex items-center gap-2.5 px-3 py-2 text-sm {{ if eq $active "pages" }}bg-zinc-50 font-medium text-zinc-900{{ else }}text-zinc-700 hover:bg-zinc-50 hover:text-zinc-900{{ end }}">
              <svg class="h-4 w-4 shrink-0 text-zinc-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
              </svg>
              Pages
            </a>
          </div>
        </div>

        <div class="ml-2 flex items-center gap-2 border-l border-zinc-200 pl-3">
          <a href="/"
             class="rounded-lg border border-zinc-200 bg-white px-3 py-1.5 text-sm font-medium text-zinc-600 hover:bg-zinc-50 hover:text-zinc-900">
            Website
          </a>
          <form method="POST" action="/root/logout">
            <button type="submit"
                    class="rounded-lg border border-zinc-300 bg-white px-3 py-1.5 text-sm font-medium text-zinc-700 hover:bg-zinc-100">
              Sign out
            </button>
          </form>
        </div>
      </div>

      <!-- Mobile: hamburger -->
      <button type="button"
              @click="open = !open"
              :aria-expanded="open"
              aria-controls="root-mobile-menu"
              class="inline-flex h-9 w-9 items-center justify-center rounded-lg text-zinc-600 hover:bg-zinc-100 md:hidden">
        <span class="sr-only">Toggle menu</span>
        <svg x-show="!open" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg x-show="open" x-cloak xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
    </div>

    <!-- Mobile search bar -->
    <div class="border-t border-zinc-100 py-2 md:hidden"
         x-data="{
           q: '',
           open: false,
           active: -1,
           sections: [
             { label: 'AIs',        href: '/root/ais'        },
             { label: 'Lists',      href: '/root/lists'      },
             { label: 'Users',      href: '/root/users'      },
             { label: 'Categories', href: '/root/categories' },
             { label: 'Genera',     href: '/root/genera'     },
             { label: 'Artifacts',  href: '/root/artifacts'  },
             { label: 'Pages',      href: '/root/pages'      },
           ],
           go(href) {
             if (this.q.trim()) window.location.href = href + '?q=' + encodeURIComponent(this.q.trim());
           },
           submit() {
             if (this.active >= 0) this.go(this.sections[this.active].href);
             else this.go('/root/ais');
           },
           onKeydown(e) {
             if (!this.open) return;
             if (e.key === 'ArrowDown') { e.preventDefault(); this.active = Math.min(this.active + 1, this.sections.length - 1); }
             else if (e.key === 'ArrowUp') { e.preventDefault(); this.active = Math.max(this.active - 1, -1); }
           }
         }"
         @click.outside="open = false; active = -1">
      <div class="relative">
        <svg class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 h-3.5 w-3.5 text-zinc-400"
             xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M9 3.5a5.5 5.5 0 100 11 5.5 5.5 0 000-11zM2 9a7 7 0 1112.452 4.391l3.328 3.329a.75.75 0 11-1.06 1.06l-3.329-3.328A7 7 0 012 9z" clip-rule="evenodd" />
        </svg>
        <input type="text"
               placeholder="Search…"
               x-model="q"
               @focus="open = q.trim().length > 0"
               @input="open = q.trim().length > 0; active = -1"
               @keydown.enter.prevent="submit()"
               @keydown.escape="open = false; active = -1; $el.blur()"
               @keydown="onKeydown($event)"
               class="w-full rounded-lg border border-zinc-200 bg-white py-2 pl-9 pr-3 text-sm text-zinc-900 placeholder-zinc-400 focus:border-zinc-400 focus:outline-none focus:ring-1 focus:ring-zinc-300" />
      </div>
      <div x-show="open"
           x-cloak
           x-transition:enter="transition ease-out duration-100"
           x-transition:enter-start="opacity-0 translate-y-0.5"
           x-transition:enter-end="opacity-100 translate-y-0"
           class="absolute left-4 right-4 top-full z-50 mt-1 rounded-lg border border-zinc-200 bg-white py-1 shadow-lg">
        <template x-for="(section, i) in sections" :key="section.href">
          <button type="button"
                  @click="go(section.href)"
                  @mouseenter="active = i"
                  :class="active === i ? 'bg-zinc-100 text-zinc-900' : 'text-zinc-700'"
                  class="flex w-full items-center gap-2.5 px-3 py-2 text-left text-sm">
            <svg class="h-3.5 w-3.5 shrink-0 text-zinc-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M9 3.5a5.5 5.5 0 100 11 5.5 5.5 0 000-11zM2 9a7 7 0 1112.452 4.391l3.328 3.329a.75.75 0 11-1.06 1.06l-3.329-3.328A7 7 0 012 9z" clip-rule="evenodd" />
            </svg>
            <span>Search in <span class="font-medium" x-text="section.label"></span></span>
          </button>
        </template>
        <div class="border-t border-zinc-100 px-3 py-1.5 text-xs text-zinc-400">
          ↵ defaults to AIs &nbsp;·&nbsp; ↑↓ to navigate
        </div>
      </div>
    </div>

    <!-- Mobile panel -->
    <div x-show="open" x-cloak x-transition.opacity
         id="root-mobile-menu"
         class="border-t border-zinc-200 pb-3 pt-2 md:hidden">
      {{ $active := .ActiveNav }}
      <div class="flex flex-col gap-0.5">
        <a href="/root"
           class="rounded-lg px-3 py-2 text-sm font-medium {{ if eq $active "dashboard" }}bg-zinc-100 text-zinc-900{{ else }}text-zinc-700 hover:bg-zinc-50{{ end }}">
          Dashboard
        </a>
        <a href="/root/ais"
           class="rounded-lg px-3 py-2 text-sm font-medium {{ if eq $active "ais" }}bg-zinc-100 text-zinc-900{{ else }}text-zinc-700 hover:bg-zinc-50{{ end }}">
          AIs
        </a>
        <a href="/root/lists"
           class="rounded-lg px-3 py-2 text-sm font-medium {{ if eq $active "lists" }}bg-zinc-100 text-zinc-900{{ else }}text-zinc-700 hover:bg-zinc-50{{ end }}">
          Lists
        </a>
        <a href="/root/users"
           class="rounded-lg px-3 py-2 text-sm font-medium {{ if eq $active "users" }}bg-zinc-100 text-zinc-900{{ else }}text-zinc-700 hover:bg-zinc-50{{ end }}">
          Users
        </a>

        <div class="mt-2 border-t border-zinc-100 pt-2">
          <p class="px-3 pb-1 text-[10px] font-semibold uppercase tracking-wider text-zinc-400">More</p>
          <a href="/root/categories"
             class="rounded-lg px-3 py-2 text-sm font-medium {{ if eq $active "categories" }}bg-zinc-100 text-zinc-900{{ else }}text-zinc-700 hover:bg-zinc-50{{ end }}">
            Categories
          </a>
          <a href="/root/genera"
             class="rounded-lg px-3 py-2 text-sm font-medium {{ if eq $active "genera" }}bg-zinc-100 text-zinc-900{{ else }}text-zinc-700 hover:bg-zinc-50{{ end }}">
            Genera
          </a>
          <a href="/root/artifacts"
             class="rounded-lg px-3 py-2 text-sm font-medium {{ if eq $active "artifacts" }}bg-zinc-100 text-zinc-900{{ else }}text-zinc-700 hover:bg-zinc-50{{ end }}">
            Artifacts
          </a>
          <a href="/root/pages"
             class="rounded-lg px-3 py-2 text-sm font-medium {{ if eq $active "pages" }}bg-zinc-100 text-zinc-900{{ else }}text-zinc-700 hover:bg-zinc-50{{ end }}">
            Pages
          </a>
        </div>
      </div>

      <div class="mt-3 flex items-center justify-between border-t border-zinc-200 pt-3">
        <span class="text-xs text-zinc-400">{{ appDomain }}</span>
        <div class="flex items-center gap-2">
          <a href="/settings"
             class="rounded-lg border border-zinc-200 bg-white px-3 py-1.5 text-sm font-medium text-zinc-600 hover:bg-zinc-50">
