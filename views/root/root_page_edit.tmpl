<!doctype html>
<html lang="en">
<head>
  <title>{{ appName }} · Edit page</title>
  {{ template "_root_head.tmpl" . }}
  <link rel="stylesheet" href="/static/js/easymde.min.css">
  <style>
    .EasyMDEContainer .CodeMirror { border-radius: 0 0 0.5rem 0.5rem; border-color: #d4d4d8; font-size: 0.875rem; min-height: 200px; }
    .EasyMDEContainer .CodeMirror-focused { border-color: #18181b; box-shadow: 0 0 0 1px #18181b; }
    .EasyMDEContainer .editor-toolbar { border-color: #d4d4d8; border-radius: 0.5rem 0.5rem 0 0; }
    .EasyMDEContainer .editor-toolbar button:hover, .EasyMDEContainer .editor-toolbar button.active { background: #f4f4f5; }
  </style>
</head>
<body class="min-h-screen bg-zinc-50 text-zinc-900">
  {{ template "_root_navbar.tmpl" . }}

  <div class="r-page-narrow">
    <header class="mb-6">
      <h1 class="r-page-title">Edit page</h1>
      {{ with .Page }}<p class="r-page-sub">{{ .Title }}</p>{{ end }}
    </header>

    {{ if .Error }}<div class="r-error">{{ .Error }}</div>{{ end }}

    {{ with .Page }}
    <form method="POST" action="/root/pages/{{ .ID }}" class="r-form-card">
      <div>
        <label for="title" class="r-label">Title <span class="r-req">*</span></label>
        <input type="text" id="title" name="title" required value="{{ .Title }}" class="r-input">
      </div>

      <div>
        <label for="slug" class="r-label">Slug</label>
        <input type="text" id="slug" name="slug" value="{{ .Slug }}" class="r-input">
        <p class="r-help">Leave blank to derive from the title.</p>
      </div>

      <div>
        <label for="subtitle" class="r-label">Subtitle</label>
        <input type="text" id="subtitle" name="subtitle" value="{{ .Subtitle }}" class="r-input">
      </div>

      <div>
        <label for="description" class="r-label">Description</label>
        <textarea id="description" name="description">{{ .Description }}</textarea>
      </div>

      <div class="flex items-center justify-between pt-2">
        <a href="/root/pages" class="r-btn-ghost">Cancel</a>
        <button type="submit" class="r-btn-primary">Save changes</button>
      </div>
    </form>
    {{ end }}
  </div>

  {{ template "_root_footer.tmpl" . }}
  <script src="/static/js/easymde.min.js"></script>
  <script>
    new EasyMDE({
      element: document.getElementById('description'),
      spellChecker: false,
      toolbar: ['bold','italic','heading','|','quote','unordered-list','ordered-list','|','link','|','preview','side-by-side','fullscreen'],
      minHeight: '200px',
    });
  </script>
</body>
</html>
