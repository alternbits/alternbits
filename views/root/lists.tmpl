<!doctype html>
<html lang="en">
<head>
  <title>{{ appName }} · Lists</title>
  {{ template "_root_head.tmpl" . }}
</head>
<body class="min-h-screen bg-zinc-50 text-zinc-900">
  {{ template "_navbar.tmpl" . }}

  <div class="mx-auto max-w-5xl px-4 py-10 sm:px-6 sm:py-12">
    <header class="mb-8 flex items-start justify-between gap-4">
      <div>
        <h1 class="text-2xl font-semibold tracking-tight">Lists</h1>
        {{ with .Page }}
        <p class="mt-1 text-sm text-zinc-500">{{ .Total }} total &middot; page {{ .Page }} of {{ .TotalPages }}.</p>
        {{ end }}
      </div>
      <a href="/root/lists/new"
         class="shrink-0 rounded-lg bg-zinc-900 px-3 py-1.5 text-sm font-medium text-white hover:bg-zinc-800">
        + New list
      </a>
    </header>

    {{ if .Error }}
    <div class="mb-6 rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700">{{ .Error }}</div>
    {{ end }}

    {{ with .Page }}
    <section class="overflow-hidden rounded-xl border border-zinc-200 bg-white">
      <!-- Mobile: card list -->
      <ul class="divide-y divide-zinc-100 md:hidden">
        {{ range .Lists }}
        <li class="px-4 py-3">
          <div class="flex items-start justify-between gap-2">
            <div class="min-w-0 flex-1">
              <div class="flex items-center gap-2">
                <span class="truncate font-medium text-zinc-900">{{ .Name }}</span>
                {{ if .IsAutoGenerated }}
                <span class="inline-flex shrink-0 items-center rounded-full bg-indigo-50 px-1.5 py-0.5 text-[10px] font-medium uppercase tracking-wide text-indigo-700">Auto</span>
                {{ end }}
              </div>
              {{ if .Subtitle }}<div class="mt-1 line-clamp-2 text-sm text-zinc-600">{{ .Subtitle }}</div>{{ end }}
              <div class="mt-1 flex items-center gap-2 text-xs text-zinc-500">
                <span>{{ .ItemCount }} tool{{ if ne .ItemCount 1 }}s{{ end }}</span>
                {{ if .User }}
                <span class="text-zinc-300">·</span>
                <span>by {{ if .User.Username }}@{{ .User.Username }}{{ else }}{{ .User.Name }}{{ end }}</span>
                {{ end }}
              </div>
            </div>
            <span class="shrink-0 text-xs text-zinc-400">{{ .CreatedAt.Format "2006-01-02" }}</span>
          </div>
        </li>
        {{ else }}
        <li class="px-4 py-8 text-center text-zinc-500">No lists yet.</li>
        {{ end }}
      </ul>

      <!-- Desktop: table -->
      <div class="hidden md:block">
        <table class="w-full text-sm">
          <thead class="bg-zinc-50 text-left text-xs uppercase tracking-wide text-zinc-500">
            <tr>
              <th class="px-5 py-2 font-medium">List</th>
              <th class="px-5 py-2 font-medium">Owner</th>
              <th class="px-5 py-2 font-medium">Tools</th>
              <th class="px-5 py-2 font-medium">Source</th>
              <th class="px-5 py-2 font-medium">Created</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-zinc-100">
            {{ range .Lists }}
            <tr class="hover:bg-zinc-50">
              <td class="px-5 py-3">
                <div class="font-medium text-zinc-900">{{ .Name }}</div>
                {{ if .Subtitle }}<div class="mt-0.5 line-clamp-1 text-xs text-zinc-500">{{ .Subtitle }}</div>{{ end }}
              </td>
              <td class="px-5 py-3 text-zinc-700">
                {{ if .User }}
                  <div class="flex items-center gap-2">
                    {{ if .User.AvatarURL }}
                    <img src="{{ .User.AvatarURL }}" alt="" class="h-6 w-6 rounded-full bg-zinc-100">
                    {{ else }}
                    <div class="h-6 w-6 rounded-full bg-zinc-200"></div>
                    {{ end }}
                    <span class="text-sm">{{ if .User.Username }}@{{ .User.Username }}{{ else }}{{ .User.Name }}{{ end }}</span>
                  </div>
                {{ else }}
                  <span class="text-zinc-400">&mdash;</span>
                {{ end }}
              </td>
              <td class="px-5 py-3 tabular-nums text-zinc-700">{{ .ItemCount }}</td>
              <td class="px-5 py-3">
                {{ if .IsAutoGenerated }}
                <span class="inline-flex items-center rounded-full bg-indigo-50 px-2 py-0.5 text-xs font-medium text-indigo-700">Auto</span>
                {{ else }}
                <span class="inline-flex items-center rounded-full bg-zinc-100 px-2 py-0.5 text-xs font-medium text-zinc-600">Manual</span>
                {{ end }}
              </td>
              <td class="px-5 py-3 text-zinc-500">{{ .CreatedAt.Format "2006-01-02" }}</td>
            </tr>
            {{ else }}
            <tr>
              <td colspan="5" class="px-5 py-8 text-center text-zinc-500">No lists yet.</td>
            </tr>
            {{ end }}
          </tbody>
        </table>
      </div>

      {{ if or .HasPrev .HasNext }}
      <div class="flex items-center justify-between border-t border-zinc-200 px-4 py-3 text-sm sm:px-5">
        {{ if .HasPrev }}
        <a href="?page={{ .PrevPage }}" class="rounded-lg border border-zinc-300 bg-white px-3 py-1.5 font-medium text-zinc-700 hover:bg-zinc-100">&larr; Previous</a>
        {{ else }}
        <span class="rounded-lg border border-zinc-200 px-3 py-1.5 text-zinc-400">&larr; Previous</span>
        {{ end }}
        {{ if .HasNext }}
        <a href="?page={{ .NextPage }}" class="rounded-lg border border-zinc-300 bg-white px-3 py-1.5 font-medium text-zinc-700 hover:bg-zinc-100">Next &rarr;</a>
        {{ else }}
        <span class="rounded-lg border border-zinc-200 px-3 py-1.5 text-zinc-400">Next &rarr;</span>
        {{ end }}
      </div>
      {{ end }}
    </section>
    {{ end }}
  </div>

  {{ template "_footer.tmpl" . }}
</body>
</html>
