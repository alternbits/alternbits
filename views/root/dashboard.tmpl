<!doctype html>
<html lang="en">
<head>
  <title>{{ appName }} · Root</title>
  {{ template "_root_head.tmpl" . }}
</head>
<body class="min-h-screen bg-zinc-50 text-zinc-900">
  {{ template "_navbar.tmpl" . }}

  <div class="mx-auto max-w-5xl px-4 py-10 sm:px-6 sm:py-12">
    <header class="mb-8 flex flex-wrap items-end justify-between gap-3">
      <div>
        <h1 class="text-2xl font-semibold tracking-tight">Dashboard</h1>
        <p class="mt-1 text-sm text-zinc-500">Overview of activity across {{ appName }}.</p>
      </div>
      <div class="flex items-center gap-2">
        <a href="/root/tools/new"
           class="rounded-lg bg-zinc-900 px-3 py-1.5 text-sm font-medium text-white hover:bg-zinc-800">
          + Tool
        </a>
        <a href="/root/categories/new"
           class="rounded-lg border border-zinc-300 bg-white px-3 py-1.5 text-sm font-medium text-zinc-700 hover:bg-zinc-100">
          + Category
        </a>
        <a href="/root/lists/new"
           class="rounded-lg border border-zinc-300 bg-white px-3 py-1.5 text-sm font-medium text-zinc-700 hover:bg-zinc-100">
          + List
        </a>
      </div>
    </header>

    <section class="grid grid-cols-2 gap-3 sm:grid-cols-4">
      <a href="/root/users"
         class="group rounded-xl border border-zinc-200 bg-white p-5 hover:border-zinc-300 hover:bg-white">
        <div class="flex items-center justify-between">
          <div class="text-sm font-medium text-zinc-500">Users</div>
          <span class="text-xs text-zinc-400 group-hover:text-zinc-600">&rarr;</span>
        </div>
        <div class="mt-2 text-3xl font-semibold tabular-nums">{{ .Users }}</div>
        <div class="mt-1 text-xs text-zinc-500">{{ .Admins }} superuser{{ if ne .Admins 1 }}s{{ end }}</div>
      </a>
      <a href="/root/tools"
         class="group rounded-xl border border-zinc-200 bg-white p-5 hover:border-zinc-300">
        <div class="flex items-center justify-between">
          <div class="text-sm font-medium text-zinc-500">Tools</div>
          <span class="text-xs text-zinc-400 group-hover:text-zinc-600">&rarr;</span>
        </div>
        <div class="mt-2 text-3xl font-semibold tabular-nums">{{ .Tools }}</div>
        <div class="mt-1 text-xs text-zinc-500">
          {{ if gt .Uncategorized 0 }}
            <span class="text-amber-600">{{ .Uncategorized }} uncategorized</span>
          {{ else }}
            all categorized
          {{ end }}
        </div>
      </a>
      <a href="/root/categories"
         class="group rounded-xl border border-zinc-200 bg-white p-5 hover:border-zinc-300">
        <div class="flex items-center justify-between">
          <div class="text-sm font-medium text-zinc-500">Categories</div>
          <span class="text-xs text-zinc-400 group-hover:text-zinc-600">&rarr;</span>
        </div>
        <div class="mt-2 text-3xl font-semibold tabular-nums">{{ .Categories }}</div>
        <div class="mt-1 text-xs text-zinc-500">taxonomy</div>
      </a>
      <a href="/root/lists"
         class="group col-span-2 rounded-xl border border-zinc-200 bg-white p-5 hover:border-zinc-300 sm:col-span-1">
        <div class="flex items-center justify-between">
          <div class="text-sm font-medium text-zinc-500">Lists</div>
          <span class="text-xs text-zinc-400 group-hover:text-zinc-600">&rarr;</span>
        </div>
        <div class="mt-2 text-3xl font-semibold tabular-nums">{{ .Lists }}</div>
        <div class="mt-1 text-xs text-zinc-500">curated collections</div>
      </a>
    </section>

    <section class="mt-6 grid grid-cols-1 gap-4 md:grid-cols-2">
      <div class="rounded-xl border border-zinc-200 bg-white">
        <div class="flex items-center justify-between border-b border-zinc-100 px-5 py-3">
          <h2 class="text-sm font-semibold tracking-tight text-zinc-900">Recent tools</h2>
          <a href="/root/tools" class="text-xs text-zinc-500 hover:text-zinc-700">All &rarr;</a>
        </div>
        <ul class="divide-y divide-zinc-100">
          {{ range .RecentTools }}
          <li class="flex items-center gap-3 px-5 py-3">
            {{ if .LogoURL }}
            <img src="{{ .LogoURL }}" alt="" class="h-8 w-8 shrink-0 rounded-md bg-zinc-100 object-cover">
            {{ else }}
            <div class="h-8 w-8 shrink-0 rounded-md bg-zinc-100 text-center text-xs font-semibold leading-8 text-zinc-500">
              {{ if .Name }}{{ slice .Name 0 1 }}{{ end }}
            </div>
            {{ end }}
            <div class="min-w-0 flex-1">
              <div class="truncate text-sm font-medium text-zinc-900">{{ .Name }}</div>
              <div class="truncate text-xs text-zinc-500">
                {{ if .Categories }}
                  {{ range $i, $c := .Categories }}{{ if $i }}, {{ end }}{{ $c.Name }}{{ end }}
                {{ else }}
                  <span class="text-zinc-400">no category</span>
                {{ end }}
              </div>
            </div>
            <div class="shrink-0 text-xs text-zinc-400">{{ .CreatedAt.Format "Jan 02" }}</div>
          </li>
          {{ else }}
          <li class="px-5 py-6 text-center text-sm text-zinc-500">No tools yet.</li>
          {{ end }}
        </ul>
      </div>

      <div class="rounded-xl border border-zinc-200 bg-white">
        <div class="flex items-center justify-between border-b border-zinc-100 px-5 py-3">
          <h2 class="text-sm font-semibold tracking-tight text-zinc-900">Recent users</h2>
          <a href="/root/users" class="text-xs text-zinc-500 hover:text-zinc-700">All &rarr;</a>
        </div>
        <ul class="divide-y divide-zinc-100">
          {{ range .RecentUsers }}
          <li class="flex items-center gap-3 px-5 py-3">
            {{ if .AvatarURL }}
            <img src="{{ .AvatarURL }}" alt="" class="h-8 w-8 shrink-0 rounded-full bg-zinc-100">
            {{ else }}
            <div class="h-8 w-8 shrink-0 rounded-full bg-zinc-200"></div>
            {{ end }}
            <div class="min-w-0 flex-1">
              <div class="flex items-center gap-2">
                <span class="truncate text-sm font-medium text-zinc-900">{{ if .Name }}{{ .Name }}{{ else }}{{ .Username }}{{ end }}</span>
                {{ if .IsAdmin }}
                <span class="inline-flex shrink-0 items-center rounded-full bg-zinc-900 px-1.5 py-0.5 text-[10px] font-medium uppercase tracking-wide text-white">su</span>
                {{ end }}
              </div>
              <div class="truncate text-xs text-zinc-500">
                {{ if .GitHubLogin }}@{{ .GitHubLogin }}{{ else }}{{ .Email }}{{ end }}
              </div>
            </div>
            <div class="shrink-0 text-xs text-zinc-400">{{ .CreatedAt.Format "Jan 02" }}</div>
          </li>
          {{ else }}
          <li class="px-5 py-6 text-center text-sm text-zinc-500">No users yet.</li>
          {{ end }}
        </ul>
      </div>
    </section>
  </div>

  {{ template "_root_footer.tmpl" . }}
</body>
</html>
