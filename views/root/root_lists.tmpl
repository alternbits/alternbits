<!doctype html>
<html lang="en">
<head>
  <title>{{ appName }} · Lists</title>
  {{ template "_root_head.tmpl" . }}
</head>
<body class="min-h-screen bg-zinc-50 text-zinc-900">
  {{ template "_root_navbar.tmpl" . }}

  <div class="r-page">
    <header class="r-page-header">
      <div>
        <h1 class="r-page-title">Lists</h1>
        {{ with .Page }}
        <p class="r-page-sub">{{ .Total }} total · page {{ .Page }} of {{ .TotalPages }}.</p>
        {{ end }}
      </div>
      <a href="/root/lists/new" class="r-btn-primary">+ New list</a>
    </header>

    <form method="GET" action="/root/lists" class="r-filter-bar">
      <div class="relative flex-1 min-w-48">
        <svg class="pointer-events-none absolute left-2.5 top-1/2 -translate-y-1/2 h-4 w-4 text-zinc-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
        <input type="text" name="q" value="{{ .Filters.Search }}" placeholder="Search name or slug…" class="r-filter-input" />
      </div>

      <select name="source" class="r-filter-select">
        <option value=""{{ if eq .Filters.Source "" }} selected{{ end }}>All sources</option>
        <option value="manual"{{ if eq .Filters.Source "manual" }} selected{{ end }}>Manual</option>
        <option value="auto"{{ if eq .Filters.Source "auto" }} selected{{ end }}>Auto-generated</option>
      </select>

      <select name="visibility" class="r-filter-select">
        <option value=""{{ if eq .Filters.Visibility "" }} selected{{ end }}>All visibility</option>
        <option value="public"{{ if eq .Filters.Visibility "public" }} selected{{ end }}>Public</option>
        <option value="private"{{ if eq .Filters.Visibility "private" }} selected{{ end }}>Private</option>
      </select>

      <select name="sort" class="r-filter-select">
        <option value=""{{ if eq .Filters.Sort "" }} selected{{ end }}>Newest first</option>
        <option value="oldest"{{ if eq .Filters.Sort "oldest" }} selected{{ end }}>Oldest first</option>
        <option value="name_asc"{{ if eq .Filters.Sort "name_asc" }} selected{{ end }}>Name A→Z</option>
        <option value="name_desc"{{ if eq .Filters.Sort "name_desc" }} selected{{ end }}>Name Z→A</option>
        <option value="most_ais"{{ if eq .Filters.Sort "most_ais" }} selected{{ end }}>Most AIs</option>
        <option value="fewest_ais"{{ if eq .Filters.Sort "fewest_ais" }} selected{{ end }}>Fewest AIs</option>
      </select>

      <button type="submit" class="r-filter-apply">Apply</button>

      {{ if or .Filters.Search .Filters.Source .Filters.Visibility .Filters.Sort }}
      <a href="/root/lists" class="r-filter-clear">Clear</a>
      {{ end }}
    </form>

    {{ if .Error }}<div class="r-error">{{ .Error }}</div>{{ end }}

    {{ with .Page }}
    <section class="overflow-hidden r-card">
      <ul class="divide-y divide-zinc-100 md:hidden">
        {{ range .Lists }}
        <li class="px-4 py-3">
          <div class="flex items-start justify-between gap-2">
            <div class="min-w-0 flex-1">
              <div class="flex items-center gap-2">
                <span class="truncate font-medium text-zinc-900">{{ .Name }}</span>
                {{ if .IsAutoGenerated }}<span class="r-pill-indigo">Auto</span>{{ end }}
                {{ if .IsPrivate }}<span class="r-pill-amber">Private</span>{{ end }}
              </div>
              {{ if .Subtitle }}<div class="mt-1 line-clamp-2 text-sm text-zinc-600">{{ .Subtitle }}</div>{{ end }}
              <div class="mt-1 flex items-center gap-2 r-meta">
                <span>{{ .ItemCount }} AI{{ if ne .ItemCount 1 }}s{{ end }}</span>
                {{ if .User }}<span class="text-zinc-300">·</span><span>by {{ if .User.Username }}@{{ .User.Username }}{{ else }}{{ .User.Name }}{{ end }}</span>{{ end }}
              </div>
            </div>
            <div class="flex shrink-0 items-center gap-2">
              <span class="text-xs text-zinc-400">{{ .CreatedAt.Format "2006-01-02" }}</span>
              <a href="/root/lists/{{ .ID }}/edit" class="r-row-action">Edit</a>
            </div>
          </div>
        </li>
        {{ else }}
        <li class="r-empty">No lists found.</li>
        {{ end }}
      </ul>

      <div class="hidden md:block">
        <table class="r-table">
          <thead class="r-thead">
            <tr>
              <th class="r-th">List</th>
              <th class="r-th">Owner</th>
              <th class="r-th">AIs</th>
              <th class="r-th">Source</th>
              <th class="r-th">Visibility</th>
              <th class="r-th">Created</th>
              <th class="r-th"></th>
            </tr>
          </thead>
          <tbody class="r-tbody">
            {{ range .Lists }}
            <tr class="r-tr">
              <td class="r-td">
                <div class="font-medium text-zinc-900">{{ .Name }}</div>
                {{ if .Subtitle }}<div class="mt-0.5 line-clamp-1 r-meta">{{ .Subtitle }}</div>{{ end }}
              </td>
              <td class="r-td text-zinc-700">
                {{ if .User }}
                  <div class="flex items-center gap-2">
                    {{ if .User.AvatarURL }}<img src="{{ .User.AvatarURL }}" alt="" class="h-6 w-6 rounded-full bg-zinc-100">{{ else }}<div class="h-6 w-6 rounded-full bg-zinc-200"></div>{{ end }}
                    <span class="text-sm">{{ if .User.Username }}@{{ .User.Username }}{{ else }}{{ .User.Name }}{{ end }}</span>
                  </div>
                {{ else }}<span class="r-dash">—</span>{{ end }}
              </td>
              <td class="r-td tabular-nums text-zinc-700">{{ .ItemCount }}</td>
              <td class="r-td">
                {{ if .IsAutoGenerated }}<span class="r-pill-indigo">Auto</span>{{ else }}<span class="r-pill-zinc">Manual</span>{{ end }}
              </td>
              <td class="r-td">
                {{ if .IsPrivate }}<span class="r-pill-amber">Private</span>{{ else }}<span class="r-pill-green">Public</span>{{ end }}
              </td>
              <td class="r-td r-muted">{{ .CreatedAt.Format "2006-01-02" }}</td>
              <td class="r-td"><a href="/root/lists/{{ .ID }}/edit" class="r-row-action">Edit</a></td>
            </tr>
            {{ else }}
            <tr><td colspan="7" class="r-empty">No lists found.</td></tr>
            {{ end }}
          </tbody>
        </table>
      </div>

      {{ if or .HasPrev .HasNext }}
      <div class="r-pager">
        {{ if .HasPrev }}<a href="?page={{ .PrevPage }}{{ $.Filters.QueryStr }}" class="r-pager-link">&larr; Previous</a>{{ else }}<span class="r-pager-disabled">&larr; Previous</span>{{ end }}
        {{ if .HasNext }}<a href="?page={{ .NextPage }}{{ $.Filters.QueryStr }}" class="r-pager-link">Next &rarr;</a>{{ else }}<span class="r-pager-disabled">Next &rarr;</span>{{ end }}
      </div>
      {{ end }}
    </section>
    {{ end }}
  </div>

  {{ template "_root_footer.tmpl" . }}
</body>
</html>
