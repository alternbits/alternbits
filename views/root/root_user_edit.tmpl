<!doctype html>
<html lang="en">
<head>
  <title>{{ appName }} · Edit user</title>
  {{ template "_root_head.tmpl" . }}
</head>
<body class="min-h-screen bg-zinc-50 text-zinc-900">
  {{ template "_root_navbar.tmpl" . }}

  <div class="r-page-narrow">
    <header class="mb-6">
      <a href="/root/users" class="mb-3 inline-flex items-center gap-1 text-xs text-zinc-400 hover:text-zinc-600">
        <svg class="h-3 w-3" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
        Users
      </a>
      <h1 class="r-page-title">Edit user</h1>
      {{ with .User }}<p class="r-page-sub">ID {{ .ID }} · joined {{ .CreatedAt.Format "Jan 2, 2006" }}</p>{{ end }}
    </header>

    {{ if .Error }}<div class="r-error">{{ .Error }}</div>{{ end }}

    <form method="POST" action="/root/users/{{ .User.ID }}" class="space-y-5">

      <div class="space-y-4 r-card-pad shadow-sm">
        <h2 class="r-card-title">Profile</h2>

        {{ with .User }}
        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label for="name" class="r-label">Name</label>
            <input type="text" id="name" name="name" value="{{ .Name }}" class="r-input">
          </div>
          <div>
            <label for="username" class="r-label">Username</label>
            <input type="text" id="username" name="username" value="{{ .Username }}" class="r-input">
          </div>
        </div>

        <div>
          <label for="email" class="r-label">Email <span class="r-req">*</span></label>
          <input type="email" id="email" name="email" required value="{{ .Email }}" class="r-input">
        </div>

        <div>
          <label for="bio" class="r-label">Bio</label>
          <textarea id="bio" name="bio" rows="3" class="r-textarea">{{ .Bio }}</textarea>
        </div>

        <div>
          <label for="avatar_url" class="r-label">Avatar URL</label>
          <div class="mt-1 flex items-center gap-3">
            {{ if .AvatarURL }}
            <img src="{{ .AvatarURL }}" alt="" class="h-9 w-9 shrink-0 rounded-full bg-zinc-100 object-cover">
            {{ else }}
            <div class="h-9 w-9 shrink-0 rounded-full bg-zinc-200"></div>
            {{ end }}
            <input type="url" id="avatar_url" name="avatar_url" value="{{ .AvatarURL }}" placeholder="https://…" class="r-input">
          </div>
        </div>
        {{ end }}
      </div>

      <div class="r-card-pad shadow-sm">
        <h2 class="mb-3 r-card-title">Role</h2>
        {{ with .User }}
        <label class="flex cursor-pointer items-start gap-3">
          <input type="checkbox" name="is_admin" {{ if .IsAdmin }}checked{{ end }}
                 class="mt-0.5 h-4 w-4 rounded border-zinc-300 text-zinc-900 focus:ring-zinc-900">
          <div>
            <span class="text-sm font-medium text-zinc-900">Superuser</span>
            <p class="r-meta">Grants access to the /root admin area and all admin operations.</p>
          </div>
        </label>
        {{ end }}
      </div>

      <div class="r-card-pad shadow-sm">
        <h2 class="mb-3 r-card-title">Connected accounts</h2>
        {{ with .User }}
        <dl class="space-y-2 text-sm">
          <div class="flex items-center justify-between">
            <dt class="r-muted">GitHub</dt>
            <dd class="font-medium text-zinc-900">
              {{ if .GitHubLogin }}<a href="https://github.com/{{ .GitHubLogin }}" target="_blank" rel="noopener" class="hover:underline">@{{ .GitHubLogin }}</a>{{ else }}<span class="r-dash">—</span>{{ end }}
            </dd>
          </div>
          <div class="flex items-center justify-between">
            <dt class="r-muted">Google</dt>
            <dd class="font-medium text-zinc-900">
              {{ if .GoogleID }}<span>Connected</span>{{ else }}<span class="r-dash">—</span>{{ end }}
            </dd>
          </div>
        </dl>
        {{ end }}
      </div>

      <div class="r-card-pad shadow-sm">
        <h2 class="mb-3 r-card-title">Security</h2>
        {{ with .User }}
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm font-medium text-zinc-900">Two-factor authentication</p>
            <p class="r-meta">{{ if .TOTPEnabled }}Enabled via authenticator app.{{ else }}Not enabled.{{ end }}</p>
          </div>
          {{ if .TOTPEnabled }}<span class="r-pill-emerald">On</span>{{ else }}<span class="r-pill-zinc">Off</span>{{ end }}
        </div>
        {{ if .TOTPEnabled }}
        <label class="mt-4 flex cursor-pointer items-start gap-3 rounded-lg border border-red-100 bg-red-50 p-3">
          <input type="checkbox" name="disable_totp"
                 class="mt-0.5 h-4 w-4 rounded border-red-300 text-red-600 focus:ring-red-500">
          <div>
            <span class="text-sm font-medium text-red-700">Disable 2FA for this user</span>
            <p class="text-xs text-red-600">Removes the TOTP secret and recovery codes. The user will need to re-enroll.</p>
          </div>
        </label>
        {{ end }}
        {{ end }}
      </div>

      <div class="flex items-center justify-between pt-2">
        <a href="/root/users" class="r-btn-ghost">Cancel</a>
        <button type="submit" class="r-btn-primary">Save changes</button>
      </div>

    </form>
  </div>

  {{ template "_root_footer.tmpl" . }}
</body>
</html>
