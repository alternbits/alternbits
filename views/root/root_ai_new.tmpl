<!doctype html>
<html lang="en">
<head>
  <title>{{ appName }} · New AI</title>
  {{ template "_root_head.tmpl" . }}
  <link rel="stylesheet" href="/static/js/easymde.min.css">
  <style>
    .EasyMDEContainer .CodeMirror { border-radius: 0 0 0.5rem 0.5rem; border-color: #d4d4d8; font-size: 0.875rem; min-height: 180px; }
    .EasyMDEContainer .CodeMirror-focused { border-color: #18181b; box-shadow: 0 0 0 1px #18181b; }
    .EasyMDEContainer .editor-toolbar { border-color: #d4d4d8; border-radius: 0.5rem 0.5rem 0 0; }
    .EasyMDEContainer .editor-toolbar button:hover, .EasyMDEContainer .editor-toolbar button.active { background: #f4f4f5; }
  </style>
</head>
<body class="min-h-screen bg-zinc-50 text-zinc-900">
  {{ template "_root_navbar.tmpl" . }}

  <div class="r-page">
    <header class="mb-6">
      <h1 class="r-page-title">New AI</h1>
      <p class="r-page-sub">Add an AI to the directory.</p>
    </header>

    {{ if .Error }}<div class="r-error">{{ .Error }}</div>{{ end }}

    <form method="POST" action="/root/ais" enctype="multipart/form-data" class="space-y-6">

      <!-- Core details -->
      <div class="space-y-4 r-card-pad shadow-sm">
        <h2 class="r-card-title">Details</h2>

        {{ with .Form }}
        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label for="name" class="r-label">Name <span class="r-req">*</span></label>
            <input type="text" id="name" name="name" required value="{{ .Name }}"
                   class="r-input">
          </div>
          <div>
            <label for="slug" class="r-label">Slug</label>
            <input type="text" id="slug" name="slug" value="{{ .Slug }}" placeholder="auto from name"
                   class="r-input">
          </div>
        </div>

        <div>
          <label for="subtitle" class="r-label">Subtitle</label>
          <input type="text" id="subtitle" name="subtitle" value="{{ .Subtitle }}"
                 class="r-input">
        </div>

        <div>
          <label for="website" class="r-label">Website</label>
          <input type="url" id="website" name="website" value="{{ .Website }}" placeholder="https://..."
                 class="r-input">
        </div>

        <div>
          <label for="description" class="r-label">Description</label>
          <textarea id="description" name="description">{{ .Description }}</textarea>
        </div>

        <div>
          <label class="r-label">Owner</label>
          <div x-data="ownerSearch('{{ .OwnerID }}', '{{ .OwnerLabel }}')" class="relative mt-1"
               @click.outside="open = false">
            <input type="hidden" name="owner_id" :value="selectedId">
            <!-- selected pill -->
            <div x-show="selectedId" class="flex items-center justify-between gap-2 rounded-lg border border-zinc-300 bg-white px-3 py-2 text-sm shadow-sm">
              <span class="text-zinc-900" x-text="selectedLabel"></span>
              <button type="button" @click="clear()" class="text-zinc-400 hover:text-zinc-700">
                <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"><path d="M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 1 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 1 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 0 0-1.06-1.06L10 8.94 6.28 5.22Z"/></svg>
              </button>
            </div>
            <!-- search input -->
            <div x-show="!selectedId">
              <input type="text" x-model="query" @input.debounce.200ms="doSearch()"
                     placeholder="Search by name, username or email…"
                     class="block w-full rounded-lg border border-zinc-300 bg-white px-3 py-2 text-sm text-zinc-900 placeholder-zinc-400 shadow-sm focus:border-zinc-900 focus:outline-none focus:ring-1 focus:ring-zinc-900">
              <div x-show="open" x-cloak
                   class="absolute z-10 mt-1 w-full rounded-lg border border-zinc-200 bg-white py-1 shadow-lg">
                <template x-for="r in results" :key="r.id">
                  <button type="button" @click="pick(r)"
                          class="flex w-full px-3 py-2 text-left text-sm text-zinc-700 hover:bg-zinc-50"
                          x-text="r.label"></button>
                </template>
                <p x-show="results.length === 0 && query.trim()" class="px-3 py-2 text-sm text-zinc-400">No users found.</p>
              </div>
            </div>
          </div>
        </div>
        <label class="flex cursor-pointer items-center gap-2">
          <input type="checkbox" name="have_free" id="have_free" {{ if .HaveFree }}checked{{ end }}
                 class="h-4 w-4 rounded border-zinc-300 text-zinc-900 focus:ring-zinc-900">
          <span class="text-sm font-medium text-zinc-700">Has a free plan</span>
        </label>

        {{ end }}
      </div>

      <!-- Artifact -->
      <div x-data="aiArtifact({{ .ArtifactsJSON }}, '{{ .SelectedArtifactID }}', {{ .ExistingData }})"
           class="space-y-4">
        <input type="hidden" name="artifact_id" :value="selectedId">
        <input type="hidden" name="artifact_data_json" :value="dataJSON">

        <div class="r-card-pad shadow-sm">
          <h2 class="mb-3 r-card-title">Artifact</h2>
          <select @change="selectArtifact($event.target.value)" class="r-select">
            <option value="">— None —</option>
            <template x-for="a in artifacts" :key="a.id">
              <option :value="a.id" :selected="String(a.id) === selectedId" x-text="a.name"></option>
            </template>
          </select>
          <p class="r-help">Select an artifact to define structured data fields for this AI.</p>
        </div>

        <div x-show="fields.length > 0"
             x-cloak
             class="r-card shadow-sm">
          <div class="border-b border-zinc-100 px-5 py-3">
            <span class="r-card-title">Artifact fields</span>
          </div>
          <div class="grid gap-px bg-zinc-100 sm:grid-cols-2">
            <template x-for="f in fields" :key="f.slug">
              <div class="bg-white px-5 py-4">
                <label class="mb-1 flex items-center gap-1.5 text-xs font-medium text-zinc-500">
                  <span x-text="f.name"></span>
                  <span x-show="f.required" class="text-red-400">*</span>
                  <code class="rounded bg-zinc-100 px-1 py-0.5 text-zinc-400" x-text="f.field_type"></code>
                </label>

                <!-- boolean: toggle -->
                <div x-show="f.field_type === 'boolean'">
                  <button type="button"
                          @click="values[f.slug] = !values[f.slug]"
                          :class="values[f.slug]
                            ? 'bg-zinc-900 text-white border-zinc-900'
                            : 'bg-white text-zinc-600 border-zinc-300 hover:border-zinc-500'"
                          class="rounded-lg border px-4 py-1.5 text-sm font-medium transition-colors"
                          x-text="values[f.slug] ? 'True' : 'False'">
                  </button>
                </div>

                <!-- text: textarea -->
                <div x-show="f.field_type === 'text'">
                  <textarea x-model="values[f.slug]" rows="3"
                            :placeholder="f.default_value || ''"
                            class="block w-full rounded-lg border border-zinc-300 bg-white px-3 py-2 text-sm focus:border-zinc-900 focus:outline-none focus:ring-1 focus:ring-zinc-900"></textarea>
                </div>

                <!-- all other types: input -->
                <div x-show="f.field_type !== 'boolean' && f.field_type !== 'text'">
                  <input :type="inputType(f.field_type)"
                         x-model="values[f.slug]"
                         :placeholder="f.default_value || ''"
                         class="block w-full rounded-lg border border-zinc-300 bg-white px-3 py-2 text-sm focus:border-zinc-900 focus:outline-none focus:ring-1 focus:ring-zinc-900">
                </div>
              </div>
            </template>
          </div>
        </div>
      </div>

      <!-- Logo -->
      <div class="r-card-pad shadow-sm">
        <h2 class="mb-3 r-card-title">Logo</h2>
        {{ if .R2Enabled }}
        <input type="file" name="logo" accept=".jpg,.jpeg,.png,.gif,.webp,.svg,image/*"
               class="block w-full text-sm text-zinc-700 file:mr-3 file:rounded-lg file:border-0 file:bg-zinc-900 file:px-3 file:py-2 file:text-sm file:font-medium file:text-white hover:file:bg-zinc-800">
        <p class="mt-1 text-xs text-zinc-500">JPG, PNG, GIF, WebP, or SVG. Max 5 MB. Stored in Cloudflare R2.</p>
        {{ else }}
        <div class="rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-xs text-amber-800">
          Logo upload disabled — set the <code class="font-mono">CLOUDFLARE_*</code> env vars to enable.
        </div>
        {{ end }}
      </div>

      <!-- Screenshots -->
      <div class="r-card-pad shadow-sm"
           x-data="screenshotsManager({{ .ExistingScreenshots }})">
        <input type="hidden" name="screenshots_json" :value="json">

        <div class="mb-3 flex items-center justify-between">
          <h2 class="r-card-title">Screenshots</h2>
          {{ if .R2Enabled }}
          <label class="cursor-pointer rounded-lg border border-zinc-300 bg-white px-3 py-1.5 text-xs font-medium text-zinc-700 hover:bg-zinc-50 transition-colors">
            Add images
            <input type="file" multiple accept=".jpg,.jpeg,.png,.gif,.webp,image/*" class="sr-only"
                   @change="pick($event)">
          </label>
          {{ end }}
        </div>

        {{ if not .R2Enabled }}
        <div class="rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-xs text-amber-800">
          Screenshot upload disabled — set the <code class="font-mono">CLOUDFLARE_*</code> env vars to enable.
        </div>
        {{ else }}
        <div x-show="items.length === 0" class="rounded-lg border-2 border-dashed border-zinc-200 py-8 text-center text-xs text-zinc-400">
          No screenshots yet — click "Add images" to upload.
        </div>
        <div x-show="items.length > 0" class="space-y-2">
          <template x-for="item in items" :key="item.id">
            <div class="flex items-start gap-3 rounded-lg border bg-zinc-50 p-2 transition-colors"
                 :class="dragOverId === item.id ? 'border-zinc-500 bg-zinc-100' : 'border-zinc-200'"
                 draggable="true"
                 @dragstart="onDragStart($event, item.id)"
                 @dragover="onDragOver($event, item.id)"
                 @dragleave="onDragLeave()"
                 @drop="onDrop($event, item.id)"
                 @dragend="onDragEnd()">
              <!-- drag handle -->
              <div class="mt-1 flex-shrink-0 cursor-grab text-zinc-300 hover:text-zinc-500" title="Drag to reorder">
                <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 5h16.5M3.75 12h16.5M3.75 19h16.5"/></svg>
              </div>
              <!-- preview -->
              <div class="relative h-16 w-24 flex-shrink-0 overflow-hidden rounded-md border border-zinc-200 bg-white">
                <img :src="item.url" x-show="item.url && !item.uploading" alt="" class="h-full w-full object-cover">
                <div x-show="item.uploading" class="absolute inset-0 flex items-center justify-center bg-white/80">
                  <svg class="h-5 w-5 animate-spin text-zinc-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/></svg>
                </div>
                <div x-show="item.err && !item.uploading" class="absolute inset-0 flex items-center justify-center bg-red-50 p-1 text-center text-xs leading-tight text-red-600" x-text="item.err"></div>
              </div>
              <!-- alt text -->
              <div class="min-w-0 flex-1">
                <label class="mb-1 block text-xs font-medium text-zinc-500">Alt text</label>
                <input type="text" x-model="item.alt" placeholder="Describe the screenshot…"
                       class="block w-full rounded-lg border border-zinc-300 bg-white px-2.5 py-1.5 text-sm focus:border-zinc-900 focus:outline-none focus:ring-1 focus:ring-zinc-900">
              </div>
              <!-- remove -->
              <button type="button" @click="remove(item.id)"
                      class="mt-0.5 flex-shrink-0 rounded-md p-1 text-zinc-400 hover:bg-red-50 hover:text-red-600 transition-colors">
                <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"><path d="M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 1 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 1 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 0 0-1.06-1.06L10 8.94 6.28 5.22Z"/></svg>
              </button>
            </div>
          </template>
        </div>
        <p class="mt-2 text-xs text-zinc-500">JPG, PNG, GIF, or WebP. Max 10 MB each. Drag rows to reorder.</p>
        {{ end }}
      </div>

      <!-- Categories -->
      <div class="r-card shadow-sm"
           x-data="{ search: '' }">
        <div class="flex items-center justify-between border-b border-zinc-100 px-5 py-3">
          <h2 class="r-card-title">Categories</h2>
          <input type="text" x-model="search" placeholder="Filter…"
                 class="w-40 rounded-lg border border-zinc-200 bg-zinc-50 px-2.5 py-1 text-xs placeholder-zinc-400 focus:border-zinc-400 focus:bg-white focus:outline-none focus:ring-1 focus:ring-zinc-900">
        </div>
        <div class="grid grid-cols-2 gap-px bg-zinc-100 sm:grid-cols-3">
          {{ $selCats := .Form.CategoryIDs }}
          {{ range .Categories }}
          {{ $id := .ID }}
          <label x-show="!search || '{{ .Name }}'.toLowerCase().includes(search.toLowerCase())"
                 class="flex cursor-pointer items-center gap-2 bg-white px-4 py-2.5 hover:bg-zinc-50 transition-colors">
            <input type="checkbox" name="category_ids" value="{{ .ID }}"
                   {{ range $selCats }}{{ if eq . $id }}checked{{ end }}{{ end }}
                   class="h-4 w-4 rounded border-zinc-300 text-zinc-900 focus:ring-zinc-900">
            <span class="text-sm text-zinc-700">{{ .Name }}</span>
          </label>
          {{ end }}
        </div>
      </div>

      <!-- Genera -->
      <div class="r-card-pad shadow-sm">
        <h2 class="mb-3 r-card-title">Genera</h2>
        <div class="flex flex-wrap gap-2">
          {{ $selGens := .Form.GenusIDs }}
          {{ range .Genera }}
          {{ $id := .ID }}
          <label class="flex cursor-pointer items-center gap-1.5 rounded-full border border-zinc-200 bg-zinc-50 px-3 py-1 text-sm hover:bg-zinc-100 transition-colors has-[:checked]:border-zinc-900 has-[:checked]:bg-zinc-900 has-[:checked]:text-white">
            <input type="checkbox" name="genus_ids" value="{{ .ID }}"
                   {{ range $selGens }}{{ if eq . $id }}checked{{ end }}{{ end }}
                   class="sr-only">
            {{ .Name }}
          </label>
          {{ end }}
        </div>
      </div>

      <div class="flex items-center justify-between">
        <a href="/root/ais" class="r-btn-ghost">Cancel</a>
        <button type="submit" class="r-btn-primary">
          Create AI
        </button>
      </div>

    </form>
  </div>

  {{ template "_root_footer.tmpl" . }}
  <script src="/static/js/easymde.min.js"></script>
  <script>
    new EasyMDE({
      element: document.getElementById('description'),
      spellChecker: false,
      toolbar: ['bold','italic','heading','|','quote','unordered-list','ordered-list','|','link','|','preview','side-by-side','fullscreen'],
      minHeight: '180px',
    });

    function ownerSearch(initId, initLabel) {
      return {
        selectedId: String(initId || ''),
        selectedLabel: initLabel || '',
        query: '',
        results: [],
        open: false,
        async doSearch() {
          const q = this.query.trim();
          if (!q) { this.results = []; this.open = false; return; }
          const res = await fetch('/root/users/search?q=' + encodeURIComponent(q));
          this.results = await res.json();
          this.open = true;
        },
        pick(r) {
          this.selectedId = String(r.id);
          this.selectedLabel = r.label;
          this.query = '';
          this.results = [];
          this.open = false;
        },
        clear() {
          this.selectedId = '';
          this.selectedLabel = '';
        },
      };
    }

    function screenshotsManager(initial) {
      return {
        items: [],
        nextId: 0,
        dragging: null,
        dragOverId: null,

        init() {
          for (const s of (initial || [])) {
            this.items.push({ id: this.nextId++, url: s.url || '', alt: s.alt || '', uploading: false, err: '' });
          }
        },

        async pick(event) {
          const files = Array.from(event.target.files || []);
          event.target.value = '';
          for (const f of files) {
            const id = this.nextId++;
            this.items.push({ id, url: '', alt: '', uploading: true, err: '' });
            try {
              const fd = new FormData();
              fd.append('file', f);
              const res = await fetch('/root/upload/screenshot', { method: 'POST', body: fd });
              const data = await res.json();
              const idx = this.items.findIndex(i => i.id === id);
              if (idx !== -1) {
                this.items.splice(idx, 1, { ...this.items[idx], url: res.ok && data.url ? data.url : '', uploading: false, err: res.ok && data.url ? '' : (data.error || 'Upload failed') });
              }
            } catch (e) {
              const idx = this.items.findIndex(i => i.id === id);
              if (idx !== -1) this.items.splice(idx, 1, { ...this.items[idx], uploading: false, err: 'Network error' });
            }
          }
        },

        remove(id) { this.items = this.items.filter(i => i.id !== id); },

        onDragStart(e, id) { this.dragging = id; e.dataTransfer.effectAllowed = 'move'; },
        onDragOver(e, id) { e.preventDefault(); this.dragOverId = id; },
        onDragLeave() { this.dragOverId = null; },
        onDrop(e, id) {
          e.preventDefault();
          if (this.dragging === null || this.dragging === id) { this.dragging = null; this.dragOverId = null; return; }
          const src = this.items.findIndex(i => i.id === this.dragging);
          const dst = this.items.findIndex(i => i.id === id);
          if (src !== -1 && dst !== -1) { const [m] = this.items.splice(src, 1); this.items.splice(dst, 0, m); }
          this.dragging = null; this.dragOverId = null;
        },
        onDragEnd() { this.dragging = null; this.dragOverId = null; },

        get json() {
          return JSON.stringify(this.items.filter(i => i.url && !i.uploading).map(i => ({ url: i.url, alt: i.alt })));
        },
      };
    }

    function aiArtifact(artifacts, initialId, initialData) {
      return {
        artifacts: artifacts,
        selectedId: String(initialId || ''),
        fields: [],
        values: {},

        get dataJSON() {
          const out = {};
          for (const f of this.fields) {
            const v = this.values[f.slug];
            out[f.slug] = f.field_type === 'boolean'
              ? (v === true || v === 'true')
              : (v !== undefined && v !== null ? v : '');
          }
          return JSON.stringify(out);
        },

        inputType(t) {
          return { number: 'number', integer: 'number', url: 'url', email: 'email', date: 'date' }[t] || 'text';
        },

        init() {
          if (this.selectedId) {
            this._load(this.selectedId, initialData);
          }
        },

        selectArtifact(id) {
          this.selectedId = String(id);
          this._load(id, {});
        },

        _load(id, preload) {
          const artifact = this.artifacts.find(a => String(a.id) === String(id));
          if (!artifact) { this.fields = []; this.values = {}; return; }
          this.fields = artifact.fields;
          this.values = {};
          for (const f of artifact.fields) {
            const v = preload[f.slug];
            if (f.field_type === 'boolean') {
              this.values[f.slug] = v === true || v === 'true';
            } else {
              this.values[f.slug] = v !== undefined && v !== null ? String(v) : (f.default_value || '');
            }
          }
        },
      };
    }
  </script>
</body>
</html>
