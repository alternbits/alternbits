<!doctype html>
<html lang="en">
<head>
  <title>{{ appName }} · {{ .AI.Name }} · Alternatives</title>
  {{ template "_root_head.tmpl" . }}
</head>
<body class="min-h-screen bg-zinc-50 text-zinc-900">
  {{ template "_root_navbar.tmpl" . }}

  <div class="r-page">
    <header class="mb-8">
      <a href="/root/alternatives" class="mb-3 inline-flex items-center gap-1 text-xs text-zinc-400 hover:text-zinc-600">
        <svg class="h-3 w-3" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
        Alternatives
      </a>
      <div class="flex items-start justify-between gap-4">
        <div>
          <h1 class="r-page-title">{{ .AI.Name }}</h1>
          <p class="mt-0.5 text-sm text-zinc-400">{{ .AI.Slug }}</p>
        </div>
        <div class="flex shrink-0 items-center gap-2">
          <a href="/root/ais/{{ .AI.ID }}/edit" class="r-btn-secondary">Edit AI</a>
          <a href="/root/alternatives/new?ai_id={{ .AI.ID }}" class="r-btn-primary">+ Add alternative</a>
        </div>
      </div>
    </header>

    {{ if not .Alternatives }}
    <div class="r-card px-5 py-12 text-center text-zinc-400">
      No alternatives yet. <a href="/root/alternatives/new?ai_id={{ .AI.ID }}" class="text-zinc-600 hover:underline">Add one.</a>
    </div>
    {{ else }}
    <section class="overflow-hidden r-card">
      <table class="r-table">
        <thead class="r-thead">
          <tr>
            <th class="r-th">Direction</th>
            <th class="r-th">AI</th>
            <th class="r-th">Status</th>
            <th class="r-th">Note</th>
            <th class="r-th">Added</th>
            <th class="r-th"></th>
          </tr>
        </thead>
        <tbody class="r-tbody">
          {{ range .Alternatives }}
          {{ $isPrimary := eq .AIID $.AI.ID }}
          {{ $other := .AlternativeAI }}
          {{ if not $isPrimary }}{{ $other = .AI }}{{ end }}
          <tr class="{{ if eq (printf "%s" .Status) "pending" }}bg-amber-50/40{{ else }}hover:bg-zinc-50{{ end }}">
            <td class="r-td">
              {{ if $isPrimary }}
              <span class="inline-flex items-center gap-1 rounded-md bg-zinc-100 px-2 py-0.5 text-xs font-medium text-zinc-600">
                <svg class="h-3 w-3" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"/></svg>
                has alt
              </span>
              {{ else }}
              <span class="inline-flex items-center gap-1 rounded-md bg-blue-50 px-2 py-0.5 text-xs font-medium text-blue-600">
                <svg class="h-3 w-3 rotate-180" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"/></svg>
                alt of
              </span>
              {{ end }}
            </td>
            <td class="r-td">
              {{ if $other }}
              <a href="/root/alternatives/ai/{{ $other.ID }}" class="font-medium text-zinc-900 hover:underline">{{ $other.Name }}</a>
              <div class="text-xs text-zinc-400">{{ $other.Slug }}</div>
              {{ else }}<span class="r-dash">—</span>{{ end }}
            </td>
            <td class="r-td">
              {{ if eq (printf "%s" .Status) "approved" }}<span class="r-pill-emerald">Approved</span>
              {{ else if eq (printf "%s" .Status) "rejected" }}<span class="r-pill-red">Rejected</span>
              {{ else }}<span class="r-pill-amber">Pending</span>{{ end }}
            </td>
            <td class="r-td text-zinc-500 max-w-xs">
              {{ if .Note }}<span class="line-clamp-1">{{ .Note }}</span>{{ else }}<span class="text-zinc-300">—</span>{{ end }}
            </td>
            <td class="r-td text-zinc-400 whitespace-nowrap">{{ .CreatedAt.Format "2006-01-02" }}</td>
            <td class="r-td">
              <div class="flex items-center gap-1.5">
                {{ if eq (printf "%s" .Status) "pending" }}
                <form method="POST" action="/root/alternatives/{{ .ID }}/approve">
                  <input type="hidden" name="back" value="{{ $.BackURL }}">
                  <button type="submit" class="r-btn-sm-success">Approve</button>
                </form>
                <form method="POST" action="/root/alternatives/{{ .ID }}/reject">
                  <input type="hidden" name="back" value="{{ $.BackURL }}">
                  <button type="submit" class="inline-flex items-center justify-center rounded-md border border-red-200 bg-white px-2.5 py-1 text-xs font-medium text-red-700 hover:bg-red-50">Reject</button>
                </form>
                {{ end }}
                <form method="POST" action="/root/alternatives/{{ .ID }}/delete" onsubmit="return confirm('Delete this alternative?')">
                  <input type="hidden" name="back" value="{{ $.BackURL }}">
                  <button type="submit" class="r-row-action">Delete</button>
                </form>
              </div>
            </td>
          </tr>
          {{ end }}
        </tbody>
      </table>
    </section>
    {{ end }}
  </div>

  {{ template "_root_footer.tmpl" . }}
</body>
</html>
