<!doctype html>
<html lang="en">
<head>
  <title>{{ appName }} · New artifact</title>
  {{ template "_root_head.tmpl" . }}
</head>
<body class="min-h-screen bg-zinc-50 text-zinc-900">
  {{ template "_root_navbar.tmpl" . }}

  <div class="mx-auto max-w-3xl px-4 py-10 sm:px-6 sm:py-12"
       x-data="artifactForm({{ if .FieldsJSON }}'{{ .FieldsJSON }}'{{ else }}'[]'{{ end }})"
       x-init="init()">

    <header class="mb-8">
      <h1 class="text-2xl font-semibold tracking-tight">New artifact</h1>
      <p class="mt-1 text-sm text-zinc-500">Define a schema of JSON fields that can be attached to AIs.</p>
    </header>

    {{ if .Error }}
    <div class="mb-6 rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700">{{ .Error }}</div>
    {{ end }}

    <form method="POST" action="/root/artifacts" @submit.prevent="submitForm($event)">
      <!-- Artifact identity -->
      <div class="mb-4 space-y-4 rounded-xl border border-zinc-200 bg-white p-5 shadow-sm">
        <div>
          <label for="name" class="block text-sm font-medium text-zinc-700">Name <span class="text-red-500">*</span></label>
          <input type="text" id="name" name="name" required
                 value="{{ .FormName }}"
                 x-ref="artifactName"
                 @input="onArtifactNameInput($event.target.value)"
                 placeholder="e.g. Pricing Info"
                 class="mt-1 block w-full rounded-lg border border-zinc-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-zinc-900 focus:outline-none focus:ring-1 focus:ring-zinc-900">
        </div>
        <div>
          <label for="slug" class="block text-sm font-medium text-zinc-700">Slug</label>
          <input type="text" id="slug" name="slug"
                 value="{{ .FormSlug }}"
                 x-ref="artifactSlug"
                 @input="slugEdited = true"
                 placeholder="auto from name"
                 class="mt-1 block w-full rounded-lg border border-zinc-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-zinc-900 focus:outline-none focus:ring-1 focus:ring-zinc-900">
          <p class="mt-1 text-xs text-zinc-500">Leave blank to derive from the name.</p>
        </div>
      </div>

      <!-- Fields -->
      <div class="mb-4 rounded-xl border border-zinc-200 bg-white shadow-sm">
        <div class="flex items-center justify-between border-b border-zinc-100 px-5 py-3">
          <span class="text-sm font-medium text-zinc-700">Fields</span>
          <span class="text-xs text-zinc-400" x-text="fields.length + ' field' + (fields.length === 1 ? '' : 's')"></span>
        </div>

        <!-- Field rows -->
        <div class="divide-y divide-zinc-100">
          <template x-for="(field, idx) in fields" :key="field._id">
            <div class="group px-5 py-4">
              <!-- Row 1: name + slug + type -->
              <div class="flex flex-wrap gap-3">
                <div class="flex-1 min-w-36">
                  <label class="block text-xs font-medium text-zinc-500 mb-1">Name <span class="text-red-400">*</span></label>
                  <input type="text"
                         x-model="field.name"
                         @input="onFieldNameInput(idx, $event.target.value)"
                         placeholder="e.g. Monthly price"
                         class="block w-full rounded-lg border border-zinc-300 bg-white px-3 py-1.5 text-sm focus:border-zinc-900 focus:outline-none focus:ring-1 focus:ring-zinc-900">
                </div>
                <div class="flex-1 min-w-36">
                  <label class="block text-xs font-medium text-zinc-500 mb-1">Slug (JSON key)</label>
                  <input type="text"
                         x-model="field.slug"
                         @input="field.slugEdited = true"
                         placeholder="auto from name"
                         class="block w-full rounded-lg border border-zinc-300 bg-white px-3 py-1.5 text-sm font-mono focus:border-zinc-900 focus:outline-none focus:ring-1 focus:ring-zinc-900">
                </div>
                <div class="w-36 shrink-0">
                  <label class="block text-xs font-medium text-zinc-500 mb-1">Type</label>
                  <select x-model="field.field_type"
                          class="block w-full rounded-lg border border-zinc-300 bg-white px-3 py-1.5 text-sm focus:border-zinc-900 focus:outline-none focus:ring-1 focus:ring-zinc-900">
                    <option value="string">string</option>
                    <option value="text">text</option>
                    <option value="number">number</option>
                    <option value="integer">integer</option>
                    <option value="boolean">boolean</option>
                    <option value="url">url</option>
                    <option value="email">email</option>
                    <option value="date">date</option>
                  </select>
                </div>
              </div>

              <!-- Row 2: default value + required + remove -->
              <div class="mt-3 flex flex-wrap items-end gap-3">
                <div class="flex-1 min-w-48">
                  <label class="block text-xs font-medium text-zinc-500 mb-1">Default value</label>
                  <input type="text"
                         x-model="field.default_value"
                         placeholder="optional"
                         class="block w-full rounded-lg border border-zinc-300 bg-white px-3 py-1.5 text-sm focus:border-zinc-900 focus:outline-none focus:ring-1 focus:ring-zinc-900">
                </div>
                <div class="flex items-center gap-2 pb-1.5">
                  <button type="button"
                          @click="field.required = !field.required"
                          :class="field.required
                            ? 'bg-zinc-900 text-white border-zinc-900'
                            : 'bg-white text-zinc-600 border-zinc-300 hover:border-zinc-500'"
                          class="rounded-lg border px-3 py-1.5 text-xs font-medium transition-colors">
                    <span x-text="field.required ? 'Required' : 'Optional'"></span>
                  </button>
                  <button type="button"
                          @click="removeField(idx)"
                          class="rounded-lg border border-zinc-200 bg-white px-2.5 py-1.5 text-xs text-zinc-400 hover:border-red-300 hover:text-red-500 transition-colors"
                          title="Remove field">
                    ✕
                  </button>
                </div>
              </div>
            </div>
          </template>

          <!-- Empty state -->
          <div x-show="fields.length === 0"
               class="px-5 py-8 text-center text-sm text-zinc-400">
            No fields yet — add one below.
          </div>
        </div>

        <!-- Add field -->
        <div class="border-t border-zinc-100 px-5 py-3">
          <button type="button"
                  @click="addField()"
                  class="rounded-lg border border-dashed border-zinc-300 px-4 py-1.5 text-sm text-zinc-500 hover:border-zinc-400 hover:text-zinc-700 transition-colors">
            + Add field
          </button>
        </div>
      </div>

      <!-- Hidden payload -->
      <input type="hidden" name="fields_json" x-ref="fieldsJSON">

      <!-- Actions -->
      <div class="flex items-center justify-between pt-2">
        <a href="/root/artifacts" class="text-sm font-medium text-zinc-600 hover:text-zinc-900">Cancel</a>
        <button type="submit"
                class="rounded-lg bg-zinc-900 px-4 py-2 text-sm font-medium text-white hover:bg-zinc-800">
          Create artifact
        </button>
      </div>
    </form>
  </div>

  {{ template "_root_footer.tmpl" . }}

  <script>
    function artifactForm(existingJSON) {
      return {
        fields: [],
        slugEdited: false,
        _counter: 0,

        init() {
          try {
            const parsed = JSON.parse(existingJSON);
            if (Array.isArray(parsed) && parsed.length > 0) {
              this.fields = parsed.map(f => ({ ...f, _id: this._counter++, slugEdited: !!f.slug }));
              return;
            }
          } catch (_) {}
        },

        slugify(s) {
          return s.toLowerCase()
            .replace(/[^a-z0-9\s_-]/g, '')
            .trim()
            .replace(/[\s_-]+/g, '_')
            .replace(/^_+|_+$/g, '');
        },

        onArtifactNameInput(val) {
          if (!this.slugEdited) {
            this.$refs.artifactSlug.value = this.slugify(val);
          }
        },

        addField() {
          this.fields.push({
            _id: this._counter++,
            name: '',
            slug: '',
            field_type: 'string',
            required: false,
            default_value: '',
            slugEdited: false,
          });
        },

        onFieldNameInput(idx, val) {
          if (!this.fields[idx].slugEdited) {
            this.fields[idx].slug = this.slugify(val);
          }
        },

        removeField(idx) {
          this.fields.splice(idx, 1);
        },

        submitForm(e) {
          const payload = this.fields.map(({ name, slug, field_type, required, default_value }) =>
            ({ name, slug, field_type, required, default_value })
          );
          this.$refs.fieldsJSON.value = JSON.stringify(payload);
          e.target.submit();
        },
      };
    }
  </script>
</body>
</html>
