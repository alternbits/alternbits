<!doctype html>
<html lang="en">
<head>
  <title>{{ appName }} · Genera</title>
  {{ template "_root_head.tmpl" . }}
</head>
<body class="min-h-screen bg-zinc-50 text-zinc-900">
  {{ template "_root_navbar.tmpl" . }}

  <div class="r-page">
    <header class="r-page-header">
      <div>
        <h1 class="r-page-title">Genera</h1>
        {{ with .Page }}<p class="r-page-sub">{{ .Total }} total · page {{ .Page }} of {{ .TotalPages }}.</p>{{ end }}
      </div>
      <a href="/root/genera/new" class="r-btn-primary">+ New genus</a>
    </header>

    {{ if .Error }}<div class="r-error">{{ .Error }}</div>{{ end }}

    {{ with .Page }}
    <section class="overflow-hidden r-card">
      <ul class="divide-y divide-zinc-100 md:hidden">
        {{ range .Genera }}
        <li class="px-4 py-3">
          <div class="flex items-start justify-between gap-2">
            <div class="min-w-0 flex-1">
              <div class="truncate font-medium text-zinc-900">{{ .Name }}</div>
              <div class="truncate r-meta">{{ .Slug }}</div>
              {{ if .Subtitle }}<div class="mt-1 line-clamp-2 text-sm text-zinc-600">{{ .Subtitle }}</div>{{ end }}
            </div>
            <span class="shrink-0 text-xs text-zinc-400">{{ .CreatedAt.Format "2006-01-02" }}</span>
          </div>
        </li>
        {{ else }}
        <li class="r-empty">No genera yet.</li>
        {{ end }}
      </ul>

      <div class="hidden md:block">
        <table class="r-table">
          <thead class="r-thead">
            <tr>
              <th class="r-th">Genus</th>
              <th class="r-th">Slug</th>
              <th class="r-th">Created</th>
            </tr>
          </thead>
          <tbody class="r-tbody">
            {{ range .Genera }}
            <tr class="r-tr">
              <td class="r-td">
                <div class="font-medium text-zinc-900">{{ .Name }}</div>
                {{ if .Subtitle }}<div class="mt-0.5 line-clamp-1 r-meta">{{ .Subtitle }}</div>{{ end }}
              </td>
              <td class="r-td text-zinc-700"><code class="r-code">{{ .Slug }}</code></td>
              <td class="r-td r-muted">{{ .CreatedAt.Format "2006-01-02" }}</td>
            </tr>
            {{ else }}
            <tr><td colspan="3" class="r-empty">No genera yet.</td></tr>
            {{ end }}
          </tbody>
        </table>
      </div>

      {{ if or .HasPrev .HasNext }}
      <div class="r-pager">
        {{ if .HasPrev }}<a href="?page={{ .PrevPage }}" class="r-pager-link">&larr; Previous</a>{{ else }}<span class="r-pager-disabled">&larr; Previous</span>{{ end }}
        {{ if .HasNext }}<a href="?page={{ .NextPage }}" class="r-pager-link">Next &rarr;</a>{{ else }}<span class="r-pager-disabled">Next &rarr;</span>{{ end }}
      </div>
      {{ end }}
    </section>
    {{ end }}
  </div>

  {{ template "_root_footer.tmpl" . }}
</body>
</html>
