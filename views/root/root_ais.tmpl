<!doctype html>
<html lang="en">
<head>
  <title>{{ appName }} · AIs</title>
  {{ template "_root_head.tmpl" . }}
</head>
<body class="min-h-screen bg-zinc-50 text-zinc-900">
  {{ template "_root_navbar.tmpl" . }}

  <div class="r-page">
    <header class="r-page-header">
      <div>
        <h1 class="r-page-title">AIs</h1>
        {{ with .Page }}<p class="r-page-sub">{{ .Total }} total · page {{ .Page }} of {{ .TotalPages }}.</p>{{ end }}
      </div>
      <a href="/root/ais/new" class="r-btn-primary">+ New AI</a>
    </header>

    <form method="GET" action="/root/ais" class="r-filter-bar">
      <div class="relative flex-1 min-w-48">
        <svg class="pointer-events-none absolute left-2.5 top-1/2 -translate-y-1/2 h-4 w-4 text-zinc-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
        <input type="text" name="q" value="{{ .Filters.Search }}" placeholder="Search name, slug, subtitle…" class="r-filter-input" />
      </div>

      <select name="category" class="r-filter-select">
        <option value="">All categories</option>
        {{ range .Categories }}<option value="{{ .Slug }}"{{ if eq $.Filters.Category .Slug }} selected{{ end }}>{{ .Name }}</option>{{ end }}
      </select>

      <select name="genus" class="r-filter-select">
        <option value="">All genera</option>
        {{ range .Genera }}<option value="{{ .Slug }}"{{ if eq $.Filters.Genus .Slug }} selected{{ end }}>{{ .Name }}</option>{{ end }}
      </select>

      <select name="sort" class="r-filter-select">
        <option value=""{{ if eq .Filters.Sort "" }} selected{{ end }}>Newest first</option>
        <option value="oldest"{{ if eq .Filters.Sort "oldest" }} selected{{ end }}>Oldest first</option>
        <option value="name_asc"{{ if eq .Filters.Sort "name_asc" }} selected{{ end }}>Name A→Z</option>
        <option value="name_desc"{{ if eq .Filters.Sort "name_desc" }} selected{{ end }}>Name Z→A</option>
      </select>

      <button type="submit" class="r-filter-apply">Apply</button>

      {{ if or .Filters.Search .Filters.Category .Filters.Genus .Filters.Sort }}
      <a href="/root/ais" class="r-filter-clear">Clear</a>
      {{ end }}
    </form>

    {{ if .Error }}<div class="r-error">{{ .Error }}</div>{{ end }}

    {{ with .Page }}
    <section class="overflow-hidden r-card">
      <ul class="divide-y divide-zinc-100 md:hidden">
        {{ range .AIs }}
        <li class="px-4 py-3">
          <div class="flex items-start justify-between gap-2">
            <div class="min-w-0 flex-1">
              <div class="truncate font-medium text-zinc-900">{{ .Name }}</div>
              <div class="truncate r-meta">{{ .Slug }}</div>
              {{ if .Subtitle }}<div class="mt-1 line-clamp-2 text-sm text-zinc-600">{{ .Subtitle }}</div>{{ end }}
            </div>
            <div class="flex shrink-0 items-center gap-3">
              <span class="text-xs text-zinc-400">{{ .CreatedAt.Format "2006-01-02" }}</span>
              <a href="/root/ais/{{ .ID }}/edit" class="r-row-action">Edit</a>
            </div>
          </div>
          <div class="mt-2">
            {{ if eq (printf "%s" .Status) "approved" }}<span class="r-pill-green">Approved</span>
            {{ else if eq (printf "%s" .Status) "pending" }}<span class="r-pill-amber">Pending</span>
            {{ else if eq (printf "%s" .Status) "rejected" }}<span class="r-pill-red">Rejected</span>{{ end }}
          </div>
        </li>
        {{ else }}
        <li class="r-empty">No AIs found.</li>
        {{ end }}
      </ul>

      <div class="hidden md:block">
        <table class="r-table">
          <thead class="r-thead">
            <tr>
              <th class="r-th">AI</th>
              <th class="r-th">Status</th>
              <th class="r-th">Submitter</th>
              <th class="r-th">Added</th>
              <th class="r-th"></th>
            </tr>
          </thead>
          <tbody class="r-tbody">
            {{ range .AIs }}
            <tr class="r-tr">
              <td class="r-td">
                <div class="font-medium text-zinc-900">{{ .Name }}</div>
                <div class="r-meta">{{ .Slug }}</div>
                {{ if .Subtitle }}<div class="mt-0.5 line-clamp-1 r-meta">{{ .Subtitle }}</div>{{ end }}
              </td>
              <td class="r-td">
                {{ if eq (printf "%s" .Status) "approved" }}<span class="r-pill-green">Approved</span>
                {{ else if eq (printf "%s" .Status) "pending" }}<span class="r-pill-amber">Pending</span>
                {{ else if eq (printf "%s" .Status) "rejected" }}<span class="r-pill-red">Rejected</span>
                {{ else }}<span class="r-dash">—</span>{{ end }}
              </td>
              <td class="r-td text-zinc-700">
                {{ if .User }}{{ if .User.Username }}@{{ .User.Username }}{{ else }}{{ .User.Email }}{{ end }}{{ else }}<span class="r-dash">—</span>{{ end }}
              </td>
              <td class="r-td r-muted">{{ .CreatedAt.Format "2006-01-02" }}</td>
              <td class="r-td"><a href="/root/ais/{{ .ID }}/edit" class="r-row-action">Edit</a></td>
            </tr>
            {{ else }}
            <tr><td colspan="5" class="r-empty">No AIs found.</td></tr>
            {{ end }}
          </tbody>
        </table>
      </div>

      {{ if or .HasPrev .HasNext }}
      <div class="r-pager">
        {{ if .HasPrev }}<a href="?page={{ .PrevPage }}{{ $.Filters.QueryStr }}" class="r-pager-link">&larr; Previous</a>{{ else }}<span class="r-pager-disabled">&larr; Previous</span>{{ end }}
        {{ if .HasNext }}<a href="?page={{ .NextPage }}{{ $.Filters.QueryStr }}" class="r-pager-link">Next &rarr;</a>{{ else }}<span class="r-pager-disabled">Next &rarr;</span>{{ end }}
      </div>
      {{ end }}
    </section>
    {{ end }}
  </div>

  {{ template "_root_footer.tmpl" . }}
</body>
</html>
