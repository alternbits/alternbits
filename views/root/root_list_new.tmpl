<!doctype html>
<html lang="en">
<head>
  <title>{{ appName }} · New list</title>
  {{ template "_root_head.tmpl" . }}
</head>
<body class="min-h-screen bg-zinc-50 text-zinc-900">
  {{ template "_root_navbar.tmpl" . }}

  <div class="r-page">
    <header class="r-page-header">
      <div>
        <h1 class="r-page-title">New list</h1>
        <p class="r-page-sub">Group AIs into a curated collection.</p>
      </div>
    </header>

    {{ if .Error }}<div class="r-error">{{ .Error }}</div>{{ end }}

    <form method="POST" action="/root/lists" x-data="listPicker()" @submit="onSubmit">

      <div class="mb-6 r-card-pad space-y-4 shadow-sm">
        <h2 class="r-card-title">Details</h2>

        {{ with .Form }}
        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label for="name" class="r-label">Name <span class="r-req">*</span></label>
            <input type="text" id="name" name="name" required value="{{ .Name }}"
                   class="r-input">
          </div>
          <div>
            <label for="slug" class="r-label">Slug <span class="r-req">*</span></label>
            <input type="text" id="slug" name="slug" value="{{ .Slug }}" placeholder="auto-generated from name"
                   class="r-input">
          </div>
        </div>
        <div>
          <label for="subtitle" class="r-label">Subtitle</label>
          <input type="text" id="subtitle" name="subtitle" value="{{ .Subtitle }}"
                 class="r-input">
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label for="owner_id" class="r-label">Owner</label>
            <select id="owner_id" name="owner_id" class="r-select">
              <option value="">— None —</option>
              {{ $selected := .OwnerID }}
              {{ range $.Owners }}
              <option value="{{ .ID }}" {{ if eq (printf "%d" .ID) $selected }}selected{{ end }}>
                {{ if .Username }}@{{ .Username }}{{ else if .Name }}{{ .Name }}{{ else }}{{ .Email }}{{ end }}
              </option>
              {{ end }}
            </select>
          </div>
          <div class="flex items-end gap-4 pb-0.5">
            <label class="flex items-center gap-2 cursor-pointer">
              <input type="checkbox" id="is_auto_generated" name="is_auto_generated"
                     {{ if .IsAutoGenerated }}checked{{ end }}
                     class="h-4 w-4 rounded border-zinc-300 text-zinc-900 focus:ring-zinc-900">
              <span class="text-sm font-medium text-zinc-700">Auto-generated</span>
            </label>
            <label class="flex items-center gap-2 cursor-pointer">
              <input type="checkbox" id="is_private" name="is_private"
                     {{ if .IsPrivate }}checked{{ end }}
                     class="h-4 w-4 rounded border-zinc-300 text-zinc-900 focus:ring-zinc-900">
              <span class="text-sm font-medium text-zinc-700">Private</span>
            </label>
          </div>
        </div>
        {{ end }}
      </div>

      <div class="r-card shadow-sm">
        <div class="r-card-head">
          <h2 class="r-card-title">AIs</h2>
          <span class="text-xs text-zinc-400" x-text="selected.length + ' selected'"></span>
        </div>

        <div class="grid grid-cols-1 divide-y divide-zinc-100 md:grid-cols-2 md:divide-x md:divide-y-0">

          <!-- Search panel -->
          <div class="flex flex-col p-4">
            <div class="relative mb-3">
              <svg class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-zinc-400"
                   xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M17 11A6 6 0 1 1 5 11a6 6 0 0 1 12 0z"/>
              </svg>
              <input type="text" x-model="search" placeholder="Search AIs…"
                     class="block w-full rounded-lg border border-zinc-200 bg-zinc-50 py-2 pl-9 pr-3 text-sm placeholder-zinc-400 focus:border-zinc-400 focus:bg-white focus:outline-none focus:ring-1 focus:ring-zinc-900">
            </div>

            <div class="h-80 overflow-y-auto">
              <p x-show="visibleCount() === 0"
                 class="py-8 text-center text-xs text-zinc-400"
                 x-text="search ? 'No results for \'' + search + '\'' : 'All AIs selected'"></p>
              <template x-for="ai in allAIs" :key="ai.id">
                <button type="button"
                        x-show="!isSelected(ai.id) && matchesSearch(ai)"
                        @click="add(ai)"
                        class="flex w-full items-center gap-3 rounded-lg px-2 py-2 text-left hover:bg-zinc-50 transition-colors group">
                  <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-md bg-zinc-100 text-xs font-semibold text-zinc-500 group-hover:bg-zinc-200"
                        x-text="ai.name.charAt(0)"></span>
                  <span class="min-w-0 flex-1">
                    <span class="block truncate text-sm font-medium text-zinc-800" x-text="ai.name"></span>
                    <span class="block truncate text-xs text-zinc-400" x-text="ai.subtitle"></span>
                  </span>
                  <svg class="h-4 w-4 shrink-0 text-zinc-300 group-hover:text-zinc-500 transition-colors"
                       xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
                  </svg>
                </button>
              </template>
            </div>
          </div>

          <!-- Selected panel -->
          <div class="flex flex-col p-4">
            <p class="mb-3 text-xs font-medium text-zinc-500">Selected — drag to reorder</p>

            <div class="h-80 overflow-y-auto">
              <template x-if="selected.length === 0">
                <div class="flex h-full items-center justify-center rounded-lg border-2 border-dashed border-zinc-200">
                  <p class="text-xs text-zinc-400">No AIs added yet</p>
                </div>
              </template>

              <ul class="space-y-1">
                <template x-for="(ai, index) in selected" :key="ai.id">
                  <li draggable="true"
                      @dragstart="dragStart(index)"
                      @dragover.prevent="dragOver(index)"
                      @drop.prevent
                      @dragend="dragEnd()"
                      :class="dragFrom === index ? 'opacity-40' : 'opacity-100'"
                      class="flex cursor-grab items-center gap-2 rounded-lg border border-zinc-200 bg-zinc-50 px-2.5 py-2 transition-opacity active:cursor-grabbing">
                    <!-- Drag handle -->
                    <svg class="h-4 w-4 shrink-0 text-zinc-300" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 9h16.5m-16.5 6.75h16.5"/>
                    </svg>
                    <!-- Index badge -->
                    <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded bg-zinc-200 text-[10px] font-bold text-zinc-600"
                          x-text="index + 1"></span>
                    <!-- Name -->
                    <span class="min-w-0 flex-1 truncate text-sm font-medium text-zinc-800" x-text="ai.name"></span>
                    <!-- Remove -->
                    <button type="button" @click="remove(ai.id)"
                            class="shrink-0 rounded p-0.5 text-zinc-300 hover:bg-red-50 hover:text-red-500 transition-colors">
                      <svg class="h-3.5 w-3.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12"/>
                      </svg>
                    </button>
                  </li>
                </template>
              </ul>
            </div>
          </div>

        </div>
      </div>

      <!-- Hidden field populated on submit -->
      <input type="hidden" name="ai_ids" x-bind:value="selected.map(a => a.id).join(',')">

      <div class="mt-6 flex items-center justify-between">
        <a href="/root/lists" class="r-btn-ghost">Cancel</a>
        <button type="submit" class="r-btn-primary">Create list</button>
      </div>

    </form>
  </div>

  <script>
  function listPicker() {
    return {
      allAIs: {{ .AIsJSON }},
      search: '',
      selected: [],
      dragFrom: null,

      isSelected(id) {
        return this.selected.some(t => t.id === id);
      },

      matchesSearch(ai) {
        if (!this.search) return true;
        const q = this.search.toLowerCase();
        return ai.name.toLowerCase().includes(q) ||
               (ai.subtitle || '').toLowerCase().includes(q);
      },

      visibleCount() {
        return this.allAIs.filter(a => !this.isSelected(a.id) && this.matchesSearch(a)).length;
      },

      add(ai) {
        if (!this.isSelected(ai.id)) {
          this.selected.push(ai);
          this.search = '';
        }
      },

      remove(id) {
        this.selected = this.selected.filter(a => a.id !== id);
      },

      dragStart(index) {
        this.dragFrom = index;
      },

      dragOver(index) {
        if (this.dragFrom === null || this.dragFrom === index) return;
        const item = this.selected.splice(this.dragFrom, 1)[0];
        this.selected.splice(index, 0, item);
        this.dragFrom = index;
      },

      dragEnd() {
        this.dragFrom = null;
      },
    };
  }
  </script>

  {{ template "_root_footer.tmpl" . }}
</body>
</html>
