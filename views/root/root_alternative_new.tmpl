<!doctype html>
<html lang="en">
<head>
  <title>{{ appName }} · New alternative</title>
  {{ template "_root_head.tmpl" . }}
</head>
<body class="min-h-screen bg-zinc-50 text-zinc-900">
  {{ template "_root_navbar.tmpl" . }}

  <div class="r-page-narrow">
    <header class="mb-6">
      <a href="/root/alternatives" class="mb-3 inline-flex items-center gap-1 text-xs text-zinc-400 hover:text-zinc-600">
        <svg class="h-3 w-3" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
        Alternatives
      </a>
      <h1 class="r-page-title">New alternative</h1>
      <p class="r-page-sub">Link two AIs as alternatives to each other.</p>
    </header>

    {{ if .Error }}<div class="r-error">{{ .Error }}</div>{{ end }}

    <form method="POST" action="/root/alternatives">

      <div class="space-y-5 r-card-pad shadow-sm">

        <!-- AI picker -->
        <div x-data="aiSearch('ai_id', '{{ .AIIDStr }}', '{{ .AILabel }}')" class="relative">
          <label class="r-label">AI <span class="r-req">*</span></label>
          <p class="mb-1.5 mt-0.5 text-xs text-zinc-400">The AI that has an alternative.</p>

          <!-- Selected pill -->
          <div x-show="selectedId" class="flex items-center gap-2 rounded-lg border border-zinc-200 bg-zinc-50 px-3 py-2">
            <span class="flex-1 text-sm font-medium text-zinc-800" x-text="selectedLabel"></span>
            <button type="button" @click="clear()"
                    class="text-zinc-400 hover:text-zinc-600">
              <svg class="h-3.5 w-3.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12"/>
              </svg>
            </button>
          </div>

          <!-- Search input -->
          <div x-show="!selectedId" class="relative">
            <input type="text" x-model="query" @input="fetch()" @focus="fetch()"
                   @keydown.escape="open = false" @click.outside="open = false"
                   placeholder="Search by name or slug…"
                   class="r-input">
            <div x-show="open" x-cloak
                 class="absolute left-0 top-full z-20 mt-1 w-full rounded-lg border border-zinc-200 bg-white py-1 shadow-lg">
              <template x-for="item in results" :key="item.id">
                <button type="button" @click="select(item)"
                        class="flex w-full items-center gap-2 px-3 py-2 text-left text-sm text-zinc-700 hover:bg-zinc-50">
                  <span class="flex-1 truncate" x-text="item.label"></span>
                </button>
              </template>
            </div>
          </div>

          <input type="hidden" name="ai_id" :value="selectedId">
        </div>

        <!-- Arrow divider -->
        <div class="flex items-center gap-3">
          <div class="h-px flex-1 bg-zinc-100"></div>
          <div class="flex items-center gap-1.5 text-xs font-medium text-zinc-400">
            <svg class="h-3.5 w-3.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 13.5 12 21m0 0-7.5-7.5M12 21V3"/>
            </svg>
            has alternative
          </div>
          <div class="h-px flex-1 bg-zinc-100"></div>
        </div>

        <!-- Alternative AI picker -->
        <div x-data="aiSearch('alternative_ai_id', '{{ .AltAIIDStr }}', '{{ .AltAILabel }}', true, {{ .TwoWay }})" class="relative">
          <label class="r-label">Alternative AI <span class="r-req">*</span></label>
          <p class="mb-1.5 mt-0.5 text-xs text-zinc-400">The AI that is the alternative.</p>

          <!-- Selected pill -->
          <div x-show="selectedId" class="flex items-center gap-2 rounded-lg border border-zinc-200 bg-zinc-50 px-3 py-2"
               :class="isAlreadyLinked ? 'opacity-60' : ''">
            <span class="flex-1 text-sm font-medium text-zinc-800" x-text="selectedLabel"></span>
            <span x-show="isAlreadyLinked" class="shrink-0 rounded bg-zinc-200 px-1.5 py-0.5 text-[10px] text-zinc-500">already linked</span>
            <label x-show="!isAlreadyLinked" class="flex shrink-0 cursor-pointer items-center gap-1.5 text-xs text-zinc-500">
              <input type="checkbox" name="two_way" x-model="twoWay"
                     class="h-3.5 w-3.5 rounded border-zinc-300 text-zinc-900 focus:ring-zinc-900">
              Two-way
            </label>
            <button type="button" @click="clear()"
                    class="text-zinc-400 hover:text-zinc-600">
              <svg class="h-3.5 w-3.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12"/>
              </svg>
            </button>
          </div>

          <!-- Search input -->
          <div x-show="!selectedId" class="relative">
            <input type="text" x-model="query" @input="fetch()" @focus="fetch()"
                   @keydown.escape="open = false" @click.outside="open = false"
                   placeholder="Search by name or slug…"
                   class="r-input">
            <div x-show="open" x-cloak
                 class="absolute left-0 top-full z-20 mt-1 w-full rounded-lg border border-zinc-200 bg-white py-1 shadow-lg">
              <template x-for="item in results" :key="item.id">
                <button type="button"
                        @click="select(item)"
                        :class="$store.altForm.mainAIAltIds.includes(item.id) ? 'opacity-50' : 'hover:bg-zinc-50'"
                        class="flex w-full items-center gap-2 px-3 py-2 text-left text-sm text-zinc-700">
                  <span class="flex-1 truncate" x-text="item.label"></span>
                  <span x-show="$store.altForm.mainAIAltIds.includes(item.id)" class="shrink-0 text-[10px] text-zinc-400">already linked</span>
                </button>
              </template>
            </div>
          </div>

          <input type="hidden" name="alternative_ai_id" :value="isAlreadyLinked ? '' : selectedId">

          <!-- Approved alternatives of the selected AI — bulk-add to main AI -->
          <div x-show="relatedAlts.length > 0" class="mt-3 rounded-lg border border-zinc-200 bg-zinc-50 p-3">
            <p class="mb-1 text-xs font-semibold text-zinc-500">
              Also add as alternatives to the main AI
            </p>
            <p class="mb-2 text-[11px] text-zinc-400">
              These are approved alternatives of <span class="text-zinc-600" x-text="selectedLabel"></span>. Check any you also want linked to the main AI.
            </p>
            <div class="space-y-1">
              <template x-for="alt in relatedAlts" :key="alt.id">
                <div class="flex items-center gap-3 rounded-lg border border-zinc-200 bg-white px-3 py-2 text-sm"
                     :class="$store.altForm.mainAIAltIds.includes(alt.id) ? 'opacity-50' : ''">
                  <label class="flex flex-1 min-w-0 items-center gap-2"
                         :class="$store.altForm.mainAIAltIds.includes(alt.id) ? 'pointer-events-none' : 'cursor-pointer'">
                    <input type="checkbox" :value="alt.id"
                           :checked="extras.includes(alt.id)"
                           :disabled="$store.altForm.mainAIAltIds.includes(alt.id)"
                           @change="toggleExtra(alt.id)"
                           class="h-4 w-4 rounded border-zinc-300 text-zinc-900 focus:ring-zinc-900">
                    <span class="min-w-0 flex-1 truncate font-medium text-zinc-800" x-text="alt.name"></span>
                    <span class="shrink-0 text-[11px] text-zinc-400" x-text="$store.altForm.mainAIAltIds.includes(alt.id) ? 'already linked' : alt.slug"></span>
                  </label>
                  <label class="flex shrink-0 cursor-pointer items-center gap-1.5 text-xs text-zinc-500"
                         :class="extras.includes(alt.id) && !$store.altForm.mainAIAltIds.includes(alt.id) ? '' : 'pointer-events-none opacity-40'">
                    <input type="checkbox" :value="alt.id"
                           :checked="twoWayExtras.includes(alt.id)"
                           :disabled="!extras.includes(alt.id) || $store.altForm.mainAIAltIds.includes(alt.id)"
                           @change="toggleTwoWay(alt.id)"
                           class="h-3.5 w-3.5 rounded border-zinc-300 text-zinc-900 focus:ring-zinc-900">
                    Two-way
                  </label>
                </div>
              </template>
            </div>
            <input type="hidden" name="extra_ai_ids" :value="extras.join(',')">
            <input type="hidden" name="extra_twoway_ids" :value="twoWayExtras.join(',')">
          </div>
        </div>

        <div class="border-t border-zinc-100 pt-4 space-y-4">

          <!-- Status -->
          <div>
            <label for="status" class="r-label">Status</label>
            <select id="status" name="status"
                    class="r-input">
              <option value="approved" {{ if eq .Status "approved" }}selected{{ end }}>Approved</option>
              <option value="pending"  {{ if eq .Status "pending"  }}selected{{ end }}>Pending</option>
              <option value="rejected" {{ if eq .Status "rejected" }}selected{{ end }}>Rejected</option>
            </select>
          </div>

          <!-- Note -->
          <div>
            <label for="note" class="r-label">Note <span class="text-zinc-400 font-normal">(optional)</span></label>
            <textarea id="note" name="note" rows="2"
                      class="r-input">{{ .Note }}</textarea>
          </div>

        </div>
      </div>

      <div class="mt-6 flex items-center justify-between">
        <a href="/root/alternatives" class="r-btn-ghost">Cancel</a>
        <button type="submit" class="r-btn-primary">Create alternative</button>
      </div>

    </form>
  </div>

  <script>
  document.addEventListener('alpine:init', () => {
    Alpine.store('altForm', { mainAIAltIds: [] });
  });

  function aiSearch(fieldName, initId, initLabel, withRelated, initTwoWay) {
    return {
      query: initLabel || '',
      results: [],
      selectedId: initId || '',
      selectedLabel: initLabel || '',
      open: false,
      _timer: null,
      relatedAlts: [],
      extras: [],
      twoWayExtras: [],
      twoWay: initTwoWay || false,
      isAlreadyLinked: false,
      async init() {
        if (!withRelated && this.selectedId) {
          await this.loadMainAIAlts(this.selectedId);
        }
        if (withRelated && this.selectedId) {
          await this.loadRelated(this.selectedId);
        }
      },
      fetch() {
        const q = this.query.trim();
        if (!q) { this.results = []; this.open = false; return; }
        clearTimeout(this._timer);
        this._timer = setTimeout(async () => {
          const res = await fetch('/root/ais/search?q=' + encodeURIComponent(q));
          this.results = await res.json();
          this.open = this.results.length > 0;
        }, 200);
      },
      async select(item) {
        this.selectedId = item.id;
        this.selectedLabel = item.label;
        this.isAlreadyLinked = withRelated && this.$store.altForm.mainAIAltIds.includes(item.id);
        this.query = item.label;
        this.open = false;
        if (!withRelated) {
          await this.loadMainAIAlts(item.id);
        }
        if (withRelated) {
          this.extras = [];
          this.twoWayExtras = [];
          this.loadRelated(item.id);
        }
      },
      async loadMainAIAlts(id) {
        const res = await fetch('/root/ais/' + id + '/alternatives');
        const alts = await res.json();
        this.$store.altForm.mainAIAltIds = [id, ...alts.map(a => a.id)];
      },
      async loadRelated(id) {
        const res = await fetch('/root/ais/' + id + '/alternatives');
        this.relatedAlts = await res.json();
      },
      toggleExtra(id) {
        const i = this.extras.indexOf(id);
        if (i >= 0) {
          this.extras.splice(i, 1);
          const j = this.twoWayExtras.indexOf(id);
          if (j >= 0) this.twoWayExtras.splice(j, 1);
        } else {
          this.extras.push(id);
          this.twoWayExtras.push(id);
        }
      },
      toggleTwoWay(id) {
        if (!this.extras.includes(id)) return;
        const i = this.twoWayExtras.indexOf(id);
        if (i >= 0) this.twoWayExtras.splice(i, 1);
        else this.twoWayExtras.push(id);
      },
      clear() {
        this.selectedId = '';
        this.selectedLabel = '';
        this.query = '';
        this.results = [];
        this.open = false;
        this.relatedAlts = [];
        this.extras = [];
        this.twoWayExtras = [];
        this.twoWay = false;
        this.isAlreadyLinked = false;
        if (!withRelated) {
          this.$store.altForm.mainAIAltIds = [];
        }
      },
    };
  }
  </script>

  {{ template "_root_footer.tmpl" . }}
</body>
</html>
