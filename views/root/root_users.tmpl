<!doctype html>
<html lang="en">
<head>
  <title>{{ appName }} · Users</title>
  {{ template "_root_head.tmpl" . }}
</head>
<body class="min-h-screen bg-zinc-50 text-zinc-900">
  {{ template "_root_navbar.tmpl" . }}

  <div class="r-page">
    <header class="r-page-header">
      <div>
        <h1 class="r-page-title">Users</h1>
        {{ with .Page }}<p class="r-page-sub">{{ .Total }} total · page {{ .Page }} of {{ .TotalPages }}.</p>{{ end }}
      </div>
    </header>

    <form method="GET" action="/root/users" class="r-filter-bar">
      <div class="relative flex-1 min-w-48">
        <svg class="pointer-events-none absolute left-2.5 top-1/2 -translate-y-1/2 h-4 w-4 text-zinc-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
        <input type="text" name="q" value="{{ .Filters.Search }}" placeholder="Search name, username, email…" class="r-filter-input" />
      </div>

      <select name="role" class="r-filter-select">
        <option value=""{{ if eq .Filters.Role "" }} selected{{ end }}>All roles</option>
        <option value="superuser"{{ if eq .Filters.Role "superuser" }} selected{{ end }}>Superuser</option>
        <option value="user"{{ if eq .Filters.Role "user" }} selected{{ end }}>User</option>
      </select>

      <select name="provider" class="r-filter-select">
        <option value=""{{ if eq .Filters.Provider "" }} selected{{ end }}>All providers</option>
        <option value="github"{{ if eq .Filters.Provider "github" }} selected{{ end }}>GitHub</option>
        <option value="google"{{ if eq .Filters.Provider "google" }} selected{{ end }}>Google</option>
      </select>

      <select name="2fa" class="r-filter-select">
        <option value=""{{ if eq .Filters.TwoFA "" }} selected{{ end }}>All 2FA</option>
        <option value="enabled"{{ if eq .Filters.TwoFA "enabled" }} selected{{ end }}>2FA on</option>
        <option value="disabled"{{ if eq .Filters.TwoFA "disabled" }} selected{{ end }}>2FA off</option>
      </select>

      <select name="sort" class="r-filter-select">
        <option value=""{{ if eq .Filters.Sort "" }} selected{{ end }}>Newest first</option>
        <option value="oldest"{{ if eq .Filters.Sort "oldest" }} selected{{ end }}>Oldest first</option>
        <option value="name_asc"{{ if eq .Filters.Sort "name_asc" }} selected{{ end }}>Name A→Z</option>
        <option value="name_desc"{{ if eq .Filters.Sort "name_desc" }} selected{{ end }}>Name Z→A</option>
      </select>

      <button type="submit" class="r-filter-apply">Apply</button>

      {{ if or .Filters.Search .Filters.Role .Filters.Provider .Filters.TwoFA .Filters.Sort }}
      <a href="/root/users" class="r-filter-clear">Clear</a>
      {{ end }}
    </form>

    {{ if .Error }}<div class="r-error">{{ .Error }}</div>{{ end }}

    {{ with .Page }}
    <section class="overflow-hidden r-card">
      <ul class="divide-y divide-zinc-100 md:hidden">
        {{ range .Users }}
        <li class="flex items-start gap-3 px-4 py-3">
          {{ if .AvatarURL }}<img src="{{ .AvatarURL }}" alt="" class="h-10 w-10 shrink-0 rounded-full bg-zinc-100">{{ else }}<div class="h-10 w-10 shrink-0 rounded-full bg-zinc-200"></div>{{ end }}
          <div class="min-w-0 flex-1">
            <div class="flex items-center justify-between gap-2">
              <div class="truncate font-medium text-zinc-900">{{ if .Name }}{{ .Name }}{{ else }}{{ .Username }}{{ end }}</div>
              {{ if .IsAdmin }}<span class="r-pill-su">Superuser</span>{{ end }}
            </div>
            <div class="truncate text-sm text-zinc-500">{{ .Email }}</div>
            <div class="mt-1 flex items-center gap-3 r-meta">
              {{ if .GitHubLogin }}<a href="https://github.com/{{ .GitHubLogin }}" target="_blank" rel="noopener" class="hover:underline">@{{ .GitHubLogin }}</a>{{ end }}
              {{ if .TOTPEnabled }}<span class="text-emerald-600">2FA</span>{{ end }}
              <span>{{ .CreatedAt.Format "2006-01-02" }}</span>
              <a href="/root/users/{{ .ID }}/edit" class="ml-auto r-row-action">Edit</a>
            </div>
          </div>
        </li>
        {{ else }}
        <li class="r-empty">No users found.</li>
        {{ end }}
      </ul>

      <div class="hidden md:block">
        <table class="r-table">
          <thead class="r-thead">
            <tr>
              <th class="r-th">User</th>
              <th class="r-th">Email</th>
              <th class="r-th">GitHub</th>
              <th class="r-th">Role</th>
              <th class="r-th">2FA</th>
              <th class="r-th">Joined</th>
              <th class="r-th"></th>
            </tr>
          </thead>
          <tbody class="r-tbody">
            {{ range .Users }}
            <tr class="r-tr">
              <td class="r-td">
                <div class="flex items-center gap-3">
                  {{ if .AvatarURL }}<img src="{{ .AvatarURL }}" alt="" class="h-8 w-8 rounded-full bg-zinc-100">{{ else }}<div class="h-8 w-8 rounded-full bg-zinc-200"></div>{{ end }}
                  <div>
                    <div class="font-medium text-zinc-900">{{ if .Name }}{{ .Name }}{{ else }}{{ .Username }}{{ end }}</div>
                    {{ if .Username }}<div class="r-meta">@{{ .Username }}</div>{{ end }}
                  </div>
                </div>
              </td>
              <td class="r-td text-zinc-700">{{ .Email }}</td>
              <td class="r-td text-zinc-700">
                {{ if .GitHubLogin }}<a href="https://github.com/{{ .GitHubLogin }}" target="_blank" rel="noopener" class="hover:underline">@{{ .GitHubLogin }}</a>{{ else }}<span class="r-dash">—</span>{{ end }}
              </td>
              <td class="r-td">
                {{ if .IsAdmin }}<span class="r-pill-su">Superuser</span>{{ else }}<span class="r-pill-zinc">User</span>{{ end }}
              </td>
              <td class="r-td">
                {{ if .TOTPEnabled }}<span class="r-pill-emerald">On</span>{{ else }}<span class="r-dash">—</span>{{ end }}
              </td>
              <td class="r-td r-muted">{{ .CreatedAt.Format "2006-01-02" }}</td>
              <td class="r-td text-right"><a href="/root/users/{{ .ID }}/edit" class="r-row-action">Edit</a></td>
            </tr>
            {{ else }}
            <tr><td colspan="7" class="r-empty">No users found.</td></tr>
            {{ end }}
          </tbody>
        </table>
      </div>

      {{ if or .HasPrev .HasNext }}
      <div class="r-pager">
        {{ if .HasPrev }}<a href="?page={{ .PrevPage }}{{ $.Filters.QueryStr }}" class="r-pager-link">&larr; Previous</a>{{ else }}<span class="r-pager-disabled">&larr; Previous</span>{{ end }}
        {{ if .HasNext }}<a href="?page={{ .NextPage }}{{ $.Filters.QueryStr }}" class="r-pager-link">Next &rarr;</a>{{ else }}<span class="r-pager-disabled">Next &rarr;</span>{{ end }}
      </div>
      {{ end }}
    </section>
    {{ end }}
  </div>

  {{ template "_root_footer.tmpl" . }}
</body>
</html>
