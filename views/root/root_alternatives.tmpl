<!doctype html>
<html lang="en">
<head>
  <title>{{ appName }} · Alternatives</title>
  {{ template "_root_head.tmpl" . }}
</head>
<body class="min-h-screen bg-zinc-50 text-zinc-900">
  {{ template "_root_navbar.tmpl" . }}

  <div class="r-page">
    <header class="r-page-header">
      <div>
        <h1 class="r-page-title">Alternatives</h1>
        <p class="r-page-sub">{{ len .Summaries }} AI{{ if ne (len .Summaries) 1 }}s{{ end }} with alternative relationships.</p>
      </div>
      <a href="/root/alternatives/new" class="r-btn-primary">+ New alternative</a>
    </header>

    <form method="GET" action="/root/alternatives" class="r-filter-bar">
      <div class="relative flex-1 min-w-48">
        <svg class="pointer-events-none absolute left-2.5 top-1/2 -translate-y-1/2 h-4 w-4 text-zinc-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
        <input type="text" name="q" value="{{ .Filters.Search }}" placeholder="Search AI name or slug…" class="r-filter-input" />
      </div>
      <select name="status" class="r-filter-select">
        <option value=""{{ if eq .Filters.Status "" }} selected{{ end }}>All statuses</option>
        <option value="pending"{{ if eq .Filters.Status "pending" }} selected{{ end }}>Has pending</option>
        <option value="approved"{{ if eq .Filters.Status "approved" }} selected{{ end }}>Has approved</option>
        <option value="rejected"{{ if eq .Filters.Status "rejected" }} selected{{ end }}>Has rejected</option>
      </select>
      <select name="sort" class="r-filter-select">
        <option value=""{{ if eq .Filters.Sort "" }} selected{{ end }}>Pending first</option>
        <option value="most"{{ if eq .Filters.Sort "most" }} selected{{ end }}>Most alternatives</option>
        <option value="name_asc"{{ if eq .Filters.Sort "name_asc" }} selected{{ end }}>Name A→Z</option>
        <option value="name_desc"{{ if eq .Filters.Sort "name_desc" }} selected{{ end }}>Name Z→A</option>
      </select>
      <button type="submit" class="r-filter-apply">Apply</button>
      {{ if or .Filters.Search .Filters.Status .Filters.Sort }}<a href="/root/alternatives" class="r-filter-clear">Clear</a>{{ end }}
    </form>

    <section class="overflow-hidden r-card">
      <table class="r-table">
        <thead class="r-thead">
          <tr>
            <th class="r-th">AI</th>
            <th class="r-th text-center">Approved</th>
            <th class="r-th text-center">Pending</th>
            <th class="r-th text-center">Rejected</th>
            <th class="r-th"></th>
          </tr>
        </thead>
        <tbody class="r-tbody">
          {{ range .Summaries }}
          <tr class="{{ if gt .PendingCount 0 }}bg-amber-50/40{{ else }}hover:bg-zinc-50{{ end }}">
            <td class="r-td">
              <a href="/root/alternatives/ai/{{ .ID }}" class="font-medium text-zinc-900 hover:underline">{{ .Name }}</a>
              <div class="text-xs text-zinc-400">{{ .Slug }}</div>
            </td>
            <td class="r-td text-center">
              {{ if gt .ApprovedCount 0 }}<span class="r-pill-emerald">{{ .ApprovedCount }}</span>{{ else }}<span class="text-zinc-300">—</span>{{ end }}
            </td>
            <td class="r-td text-center">
              {{ if gt .PendingCount 0 }}<span class="r-pill-amber">{{ .PendingCount }}</span>{{ else }}<span class="text-zinc-300">—</span>{{ end }}
            </td>
            <td class="r-td text-center">
              {{ if gt .RejectedCount 0 }}<span class="r-pill-red">{{ .RejectedCount }}</span>{{ else }}<span class="text-zinc-300">—</span>{{ end }}
            </td>
            <td class="r-td text-right">
              <div class="flex items-center justify-end gap-1.5">
                <a href="/root/alternatives/new?ai_id={{ .ID }}" class="r-row-action">+ Add</a>
                <a href="/root/alternatives/ai/{{ .ID }}" class="r-btn-sm-primary">Manage</a>
              </div>
            </td>
          </tr>
          {{ else }}
          <tr><td colspan="5" class="r-empty">No alternative relationships yet.</td></tr>
          {{ end }}
        </tbody>
      </table>
    </section>
  </div>

  {{ template "_root_footer.tmpl" . }}
</body>
</html>
