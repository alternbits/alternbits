<!doctype html>
<html lang="en">
<head>
  <title>{{ appName }} · Alternatives</title>
  {{ template "_root_head.tmpl" . }}
</head>
<body class="min-h-screen bg-zinc-50 text-zinc-900">
  {{ template "_root_navbar.tmpl" . }}

  <div class="mx-auto max-w-5xl px-4 py-10 sm:px-6 sm:py-12">
    <header class="mb-6 flex items-start justify-between gap-4">
      <div>
        <h1 class="text-2xl font-semibold tracking-tight">Alternatives</h1>
        <p class="mt-1 text-sm text-zinc-500">Manage alternative relationships between AIs.</p>
      </div>
      <a href="/root/alternatives/new"
         class="shrink-0 rounded-lg bg-zinc-900 px-3 py-1.5 text-sm font-medium text-white hover:bg-zinc-800">
        + New alternative
      </a>
    </header>

    <!-- Search & filters -->
    <form method="GET" action="/root/alternatives" class="mb-6">
      <div class="flex flex-wrap gap-2">
        <!-- Search -->
        <div class="relative flex-1 min-w-48">
          <svg class="pointer-events-none absolute left-2.5 top-1/2 -translate-y-1/2 h-4 w-4 text-zinc-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
          <input type="text" name="q" value="{{ .Filters.Search }}"
                 placeholder="Search AI name or slug…"
                 class="w-full rounded-lg border border-zinc-300 bg-white pl-8 pr-3 py-1.5 text-sm text-zinc-900 placeholder-zinc-400 focus:border-zinc-500 focus:outline-none focus:ring-1 focus:ring-zinc-500" />
        </div>

        <!-- Status filter -->
        <select name="status"
                class="rounded-lg border border-zinc-300 bg-white px-3 py-1.5 text-sm text-zinc-700 focus:border-zinc-500 focus:outline-none focus:ring-1 focus:ring-zinc-500">
          <option value=""{{ if eq .Filters.Status "" }} selected{{ end }}>All statuses</option>
          <option value="pending"{{ if eq .Filters.Status "pending" }} selected{{ end }}>Pending</option>
          <option value="approved"{{ if eq .Filters.Status "approved" }} selected{{ end }}>Approved</option>
          <option value="rejected"{{ if eq .Filters.Status "rejected" }} selected{{ end }}>Rejected</option>
        </select>

        <!-- Source filter -->
        <select name="source"
                class="rounded-lg border border-zinc-300 bg-white px-3 py-1.5 text-sm text-zinc-700 focus:border-zinc-500 focus:outline-none focus:ring-1 focus:ring-zinc-500">
          <option value=""{{ if eq .Filters.Source "" }} selected{{ end }}>All sources</option>
          <option value="admin"{{ if eq .Filters.Source "admin" }} selected{{ end }}>Admin-created</option>
          <option value="user"{{ if eq .Filters.Source "user" }} selected{{ end }}>User-suggested</option>
        </select>

        <!-- Sort -->
        <select name="sort"
                class="rounded-lg border border-zinc-300 bg-white px-3 py-1.5 text-sm text-zinc-700 focus:border-zinc-500 focus:outline-none focus:ring-1 focus:ring-zinc-500">
          <option value=""{{ if eq .Filters.Sort "" }} selected{{ end }}>Newest first</option>
          <option value="oldest"{{ if eq .Filters.Sort "oldest" }} selected{{ end }}>Oldest first</option>
          <option value="status"{{ if eq .Filters.Sort "status" }} selected{{ end }}>By status</option>
        </select>

        <button type="submit"
                class="rounded-lg bg-zinc-900 px-4 py-1.5 text-sm font-medium text-white hover:bg-zinc-700">
          Apply
        </button>

        {{ if or .Filters.Search .Filters.Status .Filters.Source .Filters.Sort }}
        <a href="/root/alternatives"
           class="flex items-center rounded-lg border border-zinc-300 bg-white px-3 py-1.5 text-sm text-zinc-500 hover:text-zinc-900 hover:bg-zinc-50">
          Clear
        </a>
        {{ end }}
      </div>
    </form>

    {{ if .Error }}
    <div class="mb-6 rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700">{{ .Error }}</div>
    {{ end }}

    <section class="overflow-hidden rounded-xl border border-zinc-200 bg-white">

      <!-- Mobile: card list -->
      <ul class="divide-y divide-zinc-100 md:hidden">
        {{ range .Alternatives }}
        <li class="px-4 py-3">
          <div class="flex items-start justify-between gap-2">
            <div class="min-w-0 flex-1">
              <div class="flex flex-wrap items-center gap-1.5">
                <span class="font-medium text-zinc-900">{{ if .AI }}{{ .AI.Name }}{{ else }}&mdash;{{ end }}</span>
                <svg class="h-3 w-3 shrink-0 text-zinc-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"/>
                </svg>
                <span class="font-medium text-zinc-900">{{ if .AlternativeAI }}{{ .AlternativeAI.Name }}{{ else }}&mdash;{{ end }}</span>
                {{ if eq (printf "%s" .Status) "approved" }}
                <span class="inline-flex items-center rounded-full bg-green-50 px-1.5 py-0.5 text-[10px] font-medium text-green-700">Approved</span>
                {{ else if eq (printf "%s" .Status) "rejected" }}
                <span class="inline-flex items-center rounded-full bg-red-50 px-1.5 py-0.5 text-[10px] font-medium text-red-700">Rejected</span>
                {{ else }}
                <span class="inline-flex items-center rounded-full bg-amber-50 px-1.5 py-0.5 text-[10px] font-medium text-amber-700">Pending</span>
                {{ end }}
              </div>
              {{ if .Note }}
              <p class="mt-0.5 line-clamp-1 text-xs text-zinc-500">{{ .Note }}</p>
              {{ end }}
            </div>
            <div class="flex shrink-0 items-center gap-1">
              {{ if eq (printf "%s" .Status) "pending" }}
              <form method="POST" action="/root/alternatives/{{ .ID }}/approve">
                <button type="submit" class="rounded border border-green-200 px-2 py-0.5 text-xs font-medium text-green-700 hover:bg-green-50">✓</button>
              </form>
              <form method="POST" action="/root/alternatives/{{ .ID }}/reject">
                <button type="submit" class="rounded border border-red-200 px-2 py-0.5 text-xs font-medium text-red-700 hover:bg-red-50">✗</button>
              </form>
              {{ end }}
              <form method="POST" action="/root/alternatives/{{ .ID }}/delete"
                    onsubmit="return confirm('Delete this alternative?')">
                <button type="submit" class="rounded border border-zinc-200 px-2 py-0.5 text-xs text-zinc-500 hover:bg-zinc-100">Del</button>
              </form>
            </div>
          </div>
        </li>
        {{ else }}
        <li class="px-4 py-8 text-center text-zinc-500">No alternatives yet.</li>
        {{ end }}
      </ul>

      <!-- Desktop: table -->
      <div class="hidden md:block">
        <table class="w-full text-sm">
          <thead class="bg-zinc-50 text-left text-xs uppercase tracking-wide text-zinc-500">
            <tr>
              <th class="px-5 py-2 font-medium">AI</th>
              <th class="px-5 py-2 font-medium w-6"></th>
              <th class="px-5 py-2 font-medium">Alternative</th>
              <th class="px-5 py-2 font-medium">Status</th>
              <th class="px-5 py-2 font-medium">Note</th>
              <th class="px-5 py-2 font-medium">Added</th>
              <th class="px-5 py-2 font-medium"></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-zinc-100">
            {{ range .Alternatives }}
            <tr class="hover:bg-zinc-50">
              <td class="px-5 py-3">
                {{ if .AI }}
                <a href="/root/ais/{{ .AI.ID }}/edit" class="font-medium text-zinc-900 hover:underline">{{ .AI.Name }}</a>
                <div class="text-xs text-zinc-400">{{ .AI.Slug }}</div>
                {{ else }}
                <span class="text-zinc-400">&mdash;</span>
                {{ end }}
              </td>
              <td class="px-2 py-3 text-zinc-300">
                <svg class="h-3.5 w-3.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"/>
                </svg>
              </td>
              <td class="px-5 py-3">
                {{ if .AlternativeAI }}
                <a href="/root/ais/{{ .AlternativeAI.ID }}/edit" class="font-medium text-zinc-900 hover:underline">{{ .AlternativeAI.Name }}</a>
                <div class="text-xs text-zinc-400">{{ .AlternativeAI.Slug }}</div>
                {{ else }}
                <span class="text-zinc-400">&mdash;</span>
                {{ end }}
              </td>
              <td class="px-5 py-3">
                {{ if eq (printf "%s" .Status) "approved" }}
                <span class="inline-flex items-center rounded-full bg-green-50 px-2 py-0.5 text-xs font-medium text-green-700">Approved</span>
                {{ else if eq (printf "%s" .Status) "rejected" }}
                <span class="inline-flex items-center rounded-full bg-red-50 px-2 py-0.5 text-xs font-medium text-red-700">Rejected</span>
                {{ else }}
                <span class="inline-flex items-center rounded-full bg-amber-50 px-2 py-0.5 text-xs font-medium text-amber-700">Pending</span>
                {{ end }}
              </td>
              <td class="px-5 py-3 text-zinc-500">
                {{ if .Note }}
                <span class="line-clamp-1 max-w-xs">{{ .Note }}</span>
                {{ else }}
                <span class="text-zinc-300">&mdash;</span>
                {{ end }}
              </td>
              <td class="px-5 py-3 text-zinc-500">{{ .CreatedAt.Format "2006-01-02" }}</td>
              <td class="px-5 py-3">
                <div class="flex items-center gap-1.5">
                  {{ if eq (printf "%s" .Status) "pending" }}
                  <form method="POST" action="/root/alternatives/{{ .ID }}/approve">
                    <button type="submit" class="rounded-lg border border-green-200 px-2 py-0.5 text-xs font-medium text-green-700 hover:bg-green-50">Approve</button>
                  </form>
                  <form method="POST" action="/root/alternatives/{{ .ID }}/reject">
                    <button type="submit" class="rounded-lg border border-red-200 px-2 py-0.5 text-xs font-medium text-red-700 hover:bg-red-50">Reject</button>
                  </form>
                  {{ end }}
                  <form method="POST" action="/root/alternatives/{{ .ID }}/delete"
                        onsubmit="return confirm('Delete this alternative?')">
                    <button type="submit" class="rounded-lg border border-zinc-200 px-2 py-0.5 text-xs font-medium text-zinc-500 hover:bg-zinc-100">Delete</button>
                  </form>
                </div>
              </td>
            </tr>
            {{ else }}
            <tr>
              <td colspan="7" class="px-5 py-8 text-center text-zinc-500">No alternatives yet.</td>
            </tr>
            {{ end }}
          </tbody>
        </table>
      </div>

    </section>
  </div>

  {{ template "_root_footer.tmpl" . }}
</body>
</html>
