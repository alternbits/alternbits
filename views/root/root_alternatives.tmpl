<!doctype html>
<html lang="en">
<head>
  <title>{{ appName }} · Alternatives</title>
  {{ template "_root_head.tmpl" . }}
</head>
<body class="min-h-screen bg-zinc-50 text-zinc-900">
  {{ template "_root_navbar.tmpl" . }}

  <div class="mx-auto max-w-4xl px-4 py-10 sm:px-6 sm:py-12">
    <header class="mb-6 flex items-start justify-between gap-4">
      <div>
        <h1 class="text-2xl font-semibold tracking-tight">Alternatives</h1>
        <p class="mt-1 text-sm text-zinc-500">{{ len .Summaries }} AI{{ if ne (len .Summaries) 1 }}s{{ end }} with alternative relationships.</p>
      </div>
      <a href="/root/alternatives/new"
         class="shrink-0 rounded-lg bg-zinc-900 px-3 py-1.5 text-sm font-medium text-white hover:bg-zinc-800">
        + New alternative
      </a>
    </header>

    <!-- Filters -->
    <form method="GET" action="/root/alternatives" class="mb-6">
      <div class="flex flex-wrap gap-2">
        <div class="relative flex-1 min-w-48">
          <svg class="pointer-events-none absolute left-2.5 top-1/2 -translate-y-1/2 h-4 w-4 text-zinc-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
          <input type="text" name="q" value="{{ .Filters.Search }}"
                 placeholder="Search AI name or slug…"
                 class="w-full rounded-lg border border-zinc-300 bg-white pl-8 pr-3 py-1.5 text-sm text-zinc-900 placeholder-zinc-400 focus:border-zinc-500 focus:outline-none focus:ring-1 focus:ring-zinc-500" />
        </div>
        <select name="status"
                class="rounded-lg border border-zinc-300 bg-white px-3 py-1.5 text-sm text-zinc-700 focus:border-zinc-500 focus:outline-none focus:ring-1 focus:ring-zinc-500">
          <option value=""{{ if eq .Filters.Status "" }} selected{{ end }}>All statuses</option>
          <option value="pending"{{ if eq .Filters.Status "pending" }} selected{{ end }}>Has pending</option>
          <option value="approved"{{ if eq .Filters.Status "approved" }} selected{{ end }}>Has approved</option>
          <option value="rejected"{{ if eq .Filters.Status "rejected" }} selected{{ end }}>Has rejected</option>
        </select>
        <select name="sort"
                class="rounded-lg border border-zinc-300 bg-white px-3 py-1.5 text-sm text-zinc-700 focus:border-zinc-500 focus:outline-none focus:ring-1 focus:ring-zinc-500">
          <option value=""{{ if eq .Filters.Sort "" }} selected{{ end }}>Pending first</option>
          <option value="most"{{ if eq .Filters.Sort "most" }} selected{{ end }}>Most alternatives</option>
          <option value="name_asc"{{ if eq .Filters.Sort "name_asc" }} selected{{ end }}>Name A→Z</option>
          <option value="name_desc"{{ if eq .Filters.Sort "name_desc" }} selected{{ end }}>Name Z→A</option>
        </select>
        <button type="submit"
                class="rounded-lg bg-zinc-900 px-4 py-1.5 text-sm font-medium text-white hover:bg-zinc-700">Apply</button>
        {{ if or .Filters.Search .Filters.Status .Filters.Sort }}
        <a href="/root/alternatives"
           class="flex items-center rounded-lg border border-zinc-300 bg-white px-3 py-1.5 text-sm text-zinc-500 hover:text-zinc-900 hover:bg-zinc-50">Clear</a>
        {{ end }}
      </div>
    </form>

    <section class="overflow-hidden rounded-xl border border-zinc-200 bg-white">
      <table class="w-full text-sm">
        <thead class="bg-zinc-50 text-left text-xs uppercase tracking-wide text-zinc-500 border-b border-zinc-200">
          <tr>
            <th class="px-5 py-3 font-medium">AI</th>
            <th class="px-5 py-3 font-medium text-center">Approved</th>
            <th class="px-5 py-3 font-medium text-center">Pending</th>
            <th class="px-5 py-3 font-medium text-center">Rejected</th>
            <th class="px-5 py-3 font-medium"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-zinc-100">
          {{ range .Summaries }}
          <tr class="{{ if gt .PendingCount 0 }}bg-amber-50/40{{ else }}hover:bg-zinc-50{{ end }}">
            <td class="px-5 py-3.5">
              <a href="/root/alternatives/ai/{{ .ID }}" class="font-medium text-zinc-900 hover:underline">{{ .Name }}</a>
              <div class="text-xs text-zinc-400">{{ .Slug }}</div>
            </td>
            <td class="px-5 py-3.5 text-center">
              {{ if gt .ApprovedCount 0 }}
              <span class="inline-flex items-center justify-center rounded-full bg-green-50 px-2.5 py-0.5 text-xs font-semibold text-green-700">{{ .ApprovedCount }}</span>
              {{ else }}<span class="text-zinc-300">—</span>{{ end }}
            </td>
            <td class="px-5 py-3.5 text-center">
              {{ if gt .PendingCount 0 }}
              <span class="inline-flex items-center justify-center rounded-full bg-amber-100 px-2.5 py-0.5 text-xs font-semibold text-amber-800">{{ .PendingCount }}</span>
              {{ else }}<span class="text-zinc-300">—</span>{{ end }}
            </td>
            <td class="px-5 py-3.5 text-center">
              {{ if gt .RejectedCount 0 }}
              <span class="inline-flex items-center justify-center rounded-full bg-red-50 px-2.5 py-0.5 text-xs font-semibold text-red-700">{{ .RejectedCount }}</span>
              {{ else }}<span class="text-zinc-300">—</span>{{ end }}
            </td>
            <td class="px-5 py-3.5 text-right">
              <div class="flex items-center justify-end gap-1.5">
                <a href="/root/alternatives/new?ai_id={{ .ID }}"
                   class="rounded-lg border border-zinc-200 px-2.5 py-1 text-xs font-medium text-zinc-600 hover:bg-zinc-50">+ Add</a>
                <a href="/root/alternatives/ai/{{ .ID }}"
                   class="rounded-lg bg-zinc-900 px-2.5 py-1 text-xs font-medium text-white hover:bg-zinc-800">Manage</a>
              </div>
            </td>
          </tr>
          {{ else }}
          <tr>
            <td colspan="5" class="px-5 py-10 text-center text-zinc-400">No alternative relationships yet.</td>
          </tr>
          {{ end }}
        </tbody>
      </table>
    </section>
  </div>

  {{ template "_root_footer.tmpl" . }}
</body>
</html>
