<!doctype html>
<html lang="en">
<head>
  <title>{{ appName }} · New category</title>
  {{ template "_root_head.tmpl" . }}
</head>
<body class="min-h-screen bg-zinc-50 text-zinc-900">
  {{ template "_root_navbar.tmpl" . }}

  <div class="r-page-narrow">
    <header class="mb-6">
      <h1 class="r-page-title">New category</h1>
      <p class="r-page-sub">Add a category to organize tools.</p>
    </header>

    {{ if .Error }}<div class="r-error">{{ .Error }}</div>{{ end }}

    <form method="POST" action="/root/categories" class="r-form-card">
      {{ with .Form }}
      <div>
        <label for="name" class="r-label">Name <span class="r-req">*</span></label>
        <input type="text" id="name" name="name" required value="{{ .Name }}" class="r-input">
      </div>

      <div>
        <label for="slug" class="r-label">Slug</label>
        <input type="text" id="slug" name="slug" value="{{ .Slug }}" placeholder="auto from name" class="r-input">
        <p class="r-help">Leave blank to derive from the name.</p>
      </div>

      <div>
        <label for="subtitle" class="r-label">Subtitle</label>
        <input type="text" id="subtitle" name="subtitle" value="{{ .Subtitle }}" class="r-input">
      </div>

      <div>
        <label for="parent_id" class="r-label">Parent</label>
        <select id="parent_id" name="parent_id" class="r-select">
          <option value="">— None (top-level) —</option>
          {{ $selected := .ParentID }}
          {{ range $.Parents }}
          <option value="{{ .ID }}" {{ if eq (printf "%d" .ID) $selected }}selected{{ end }}>{{ .Name }}</option>
          {{ end }}
        </select>
        <p class="r-help">Optional — nest under an existing category.</p>
      </div>
      {{ end }}

      <div class="flex items-center justify-between pt-2">
        <a href="/root/categories" class="r-btn-ghost">Cancel</a>
        <button type="submit" class="r-btn-primary">Create category</button>
      </div>
    </form>
  </div>

  {{ template "_root_footer.tmpl" . }}
</body>
</html>
