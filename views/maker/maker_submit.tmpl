<!doctype html>
<html lang="en">
<head>
  <title>Submit an AI · {{ appName }} for Makers</title>
  {{ template "_slash_head.tmpl" . }}
</head>
<body x-data="{
  darkMode: document.documentElement.classList.contains('dark'),
  toggle() {
    this.darkMode = !this.darkMode;
    this.darkMode
      ? document.documentElement.classList.add('dark')
      : document.documentElement.classList.remove('dark');
    localStorage.setItem('theme', this.darkMode ? 'dark' : 'light');
  }
}" class="min-h-screen bg-white dark:bg-[#2b2c31] text-zinc-900 dark:text-white antialiased">

  {{ template "_header.tmpl" . }}
  {{ template "_sidebar.tmpl" . }}

  <main class="mx-auto max-w-xl px-4 py-16">

    {{ if .Submitted }}
    <div class="rounded-2xl border border-green-200 bg-green-50 dark:border-green-800 dark:bg-green-950/40 px-6 py-8 text-center">
      <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-green-100 dark:bg-green-900">
        <svg class="h-6 w-6 text-green-600 dark:text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
      </div>
      <h2 class="text-xl font-bold text-zinc-900 dark:text-white">Submitted!</h2>
      <p class="mt-2 text-sm text-zinc-500 dark:text-white">Your AI is pending review. We'll add it to the directory once approved.</p>
      <a href="/maker/submit" class="mt-6 inline-block rounded-lg bg-orange-500 dark:bg-amber-500 px-4 py-2 text-sm font-semibold text-white hover:bg-orange-600 dark:hover:bg-amber-400">Submit another</a>
    </div>
    {{ else }}

    <h1 class="text-3xl font-black tracking-tight text-zinc-900 dark:text-white">Submit an AI</h1>
    <p class="mt-2 text-sm text-zinc-500 dark:text-white">Your submission goes into review and will appear on {{ appName }} once approved.</p>

    {{ if .Error }}
    <div class="mt-4 rounded-lg border border-red-200 bg-red-50 dark:border-red-800 dark:bg-red-950/40 px-4 py-3 text-sm text-red-700 dark:text-white">{{ .Error }}</div>
    {{ end }}

    <form method="POST" action="/maker/submit" enctype="multipart/form-data" class="mt-8 space-y-5">

      <div>
        <label for="name" class="block text-sm font-medium text-zinc-700 dark:text-white">Name <span class="text-red-500">*</span></label>
        <input type="text" id="name" name="name" required value="{{ .Form.Name }}"
               placeholder="e.g. ChatGPT"
               class="mt-1 block w-full rounded-lg border border-zinc-300 dark:border-[#43444c] bg-white dark:bg-[#35363d] px-3 py-2 text-sm text-zinc-900 dark:text-white placeholder-zinc-400 dark:placeholder-zinc-500 focus:border-orange-500 dark:focus:border-amber-500 focus:outline-none focus:ring-1 focus:ring-orange-500 dark:focus:ring-amber-500">
      </div>

      <div>
        <label for="website" class="block text-sm font-medium text-zinc-700 dark:text-white">Website</label>
        <input type="url" id="website" name="website" value="{{ .Form.Website }}"
               placeholder="https://..."
               class="mt-1 block w-full rounded-lg border border-zinc-300 dark:border-[#43444c] bg-white dark:bg-[#35363d] px-3 py-2 text-sm text-zinc-900 dark:text-white placeholder-zinc-400 dark:placeholder-zinc-500 focus:border-orange-500 dark:focus:border-amber-500 focus:outline-none focus:ring-1 focus:ring-orange-500 dark:focus:ring-amber-500">
      </div>

      <div>
        <label for="subtitle" class="block text-sm font-medium text-zinc-700 dark:text-white">Short description</label>
        <input type="text" id="subtitle" name="subtitle" value="{{ .Form.Subtitle }}"
               placeholder="One-line summary"
               class="mt-1 block w-full rounded-lg border border-zinc-300 dark:border-[#43444c] bg-white dark:bg-[#35363d] px-3 py-2 text-sm text-zinc-900 dark:text-white placeholder-zinc-400 dark:placeholder-zinc-500 focus:border-orange-500 dark:focus:border-amber-500 focus:outline-none focus:ring-1 focus:ring-orange-500 dark:focus:ring-amber-500">
      </div>

      <div>
        <label for="description" class="block text-sm font-medium text-zinc-700 dark:text-white">Description</label>
        <textarea id="description" name="description" rows="4"
                  placeholder="Tell us more about this AI…"
                  class="mt-1 block w-full rounded-lg border border-zinc-300 dark:border-[#43444c] bg-white dark:bg-[#35363d] px-3 py-2 text-sm text-zinc-900 dark:text-white placeholder-zinc-400 dark:placeholder-zinc-500 focus:border-orange-500 dark:focus:border-amber-500 focus:outline-none focus:ring-1 focus:ring-orange-500 dark:focus:ring-amber-500">{{ .Form.Description }}</textarea>
      </div>

      <div>
        <label for="logo" class="block text-sm font-medium text-zinc-700 dark:text-white">Logo</label>
        {{ if .R2Enabled }}
        <input type="file" id="logo" name="logo" accept=".jpg,.jpeg,.png,.gif,.webp,.svg,image/*"
               class="mt-1 block w-full text-sm text-zinc-700 dark:text-white file:mr-3 file:rounded-lg file:border-0 file:bg-orange-500 dark:file:bg-amber-500 file:px-3 file:py-2 file:text-sm file:font-medium file:text-white hover:file:bg-orange-600 dark:hover:file:bg-amber-400">
        <p class="mt-1 text-xs text-zinc-500 dark:text-white">JPG, PNG, GIF, WebP, or SVG. Max 5 MB.</p>
        {{ else }}
        <div class="mt-1 rounded-lg border border-amber-200 dark:border-amber-800 bg-amber-50 dark:bg-amber-950/40 px-3 py-2 text-xs text-amber-800 dark:text-white">
          Logo upload is currently disabled.
        </div>
        {{ end }}
      </div>

      <button type="submit"
              class="w-full rounded-lg bg-orange-500 dark:bg-amber-500 px-4 py-2.5 text-sm font-semibold text-white hover:bg-orange-600 dark:hover:bg-amber-400 focus:outline-none focus:ring-2 focus:ring-orange-500 dark:focus:ring-amber-500 focus:ring-offset-2">
        Submit for review
      </button>

    </form>
    {{ end }}

  </main>

  {{ template "_footer.tmpl" . }}
</body>
</html>
