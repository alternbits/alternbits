APP_NAME=Altern
APP_DOMAIN=altern.ai

PORT=1337

DB_DSN=host=127.0.0.1 user=altern password=altern dbname=altern port=5432 sslmode=disable TimeZone=UTC

# Cookie session signing key (≥32 chars in production)
SESSION_SECRET=

# GitHub OAuth app — shared by /root (superuser) and public sign-in.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URL=http://localhost:1337/auth/github/callback

# Google OAuth app — public sign-in only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:1337/auth/google/callback

# Comma-separated GitHub logins allowed to sign in as superusers.
SUPERUSER_GITHUB_LOGINS=

# Cloudflare R2 (S3-compatible) for tool logos and other uploads. Leave blank to disable.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ACCESS_KEY_ID=
CLOUDFLARE_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_REGION=auto
# Public URL where bucket objects are served (R2.dev domain or custom CDN).
# Required for browser-accessible image URLs — the cloudflarestorage.com endpoint isn't public.
CLOUDFLARE_R2_PUBLIC_URL=
